    rdfs:label "has reuse rate"@en ; rdfs:comment "Share of projects reusing the asset (0.0-1.0)"@en .
:isReusable a owl:DatatypeProperty ; rdfs:domain :DomainAsset ; rdfs:range xsd:boolean ; rdfs:label "is reusable"@en .
:isConfigurable a owl:DatatypeProperty ; rdfs:domain :DomainAsset ; rdfs:range xsd:boolean ; rdfs:label "is configurable"@en .
:hasComplexity a owl:DatatypeProperty ; rdfs:domain :DomainAsset ; rdfs:range xsd:decimal ; rdfs:label "has complexity"@en .
:hasDuration a owl:DatatypeProperty ; rdfs:domain :ProcessActivity ; rdfs:range xsd:duration ; rdfs:label "has duration"@en .
:hasEffort a owl:DatatypeProperty ; rdfs:domain :ProcessActivity ; rdfs:range xsd:decimal ;
    rdfs:label "has effort"@en ; rdfs:comment "Effort in person-hours"@en .
:isAutomated a owl:DatatypeProperty ; rdfs:domain :ProcessActivity ; rdfs:range xsd:boolean ; rdfs:label "is automated"@en .
:hasMaturityLevel a owl:DatatypeProperty ; rdfs:domain :DomainEngineeringProcess ; rdfs:range xsd:int ;
    rdfs:label "has maturity level"@en ; rdfs:comment "Process maturity 1 (Initial) to 5 (Optimizing)"@en .
:hasCycleTime a owl:DatatypeProperty ; rdfs:domain :DomainEngineeringProcess ; rdfs:range xsd:duration ;
    rdfs:label "has cycle time"@en .

# Business context
:businessValue a owl:DatatypeProperty ; rdfs:domain :BusinessBenefits ; rdfs:range xsd:decimal ; rdfs:label "business value"@en .
:priorityLevel a owl:DatatypeProperty ; rdfs:domain :ProblemDescription ; rdfs:range xsd:string ;
    rdfs:label "priority level"@en ; rdfs:comment "High, Medium or Low"@en .
:problemSeverity a owl:DatatypeProperty ; rdfs:domain :ProblemDescription ; rdfs:range xsd:string ;
    rdfs:label "problem severity"@en ; rdfs:comment "Critical, Major or Minor"@en .
:capabilityType a owl:DatatypeProperty ; rdfs:domain :SystemCapabilities ; rdfs:range xsd:string ;
    rdfs:label "capability type"@en ; rdfs:comment "Functional, Non-functional or Technical"@en .
:processMaturity a owl:DatatypeProperty ; rdfs:domain :BusinessProcess ; rdfs:range xsd:int ;
    rdfs:label "process maturity"@en ; rdfs:comment "Maturity of the business process (1-5)"@en .
:ruleType a owl:DatatypeProperty ; rdfs:domain :BusinessRule ; rdfs:range xsd:string ;
    rdfs:label "rule type"@en ; rdfs:comment "Constraint, Policy, Guideline or Validation"@en .
:applicationCount a owl:DatatypeProperty ; rdfs:domain :ApplicationPortfolio ; rdfs:range xsd:int ;
    rdfs:label "application count"@en .

# Data collection
:collectionDate a owl:DatatypeProperty ; rdfs:domain :DataCollectionLog ; rdfs:range xsd:date ; rdfs:label "collection date"@en .
:collectionMethod a owl:DatatypeProperty ; rdfs:domain :DataCollectionLog ; rdfs:range xsd:string ; rdfs:label "collection method"@en .
:interviewDuration a owl:DatatypeProperty ; rdfs:domain :InterviewList ; rdfs:range xsd:duration ; rdfs:label "interview duration"@en .
:meetingType a owl:DatatypeProperty ; rdfs:domain :MeetingList ; rdfs:range xsd:string ;
    rdfs:label "meeting type"@en ; rdfs:comment "Workshop, Review or Planning"@en .
:analysisMethod a owl:DatatypeProperty ; rdfs:domain :DocumentAnalysisList ; rdfs:range xsd:string ; rdfs:label "analysis method"@en .
:participantCount a owl:DatatypeProperty ; rdfs:domain :MeetingList ; rdfs:range xsd:int ; rdfs:label "participant count"@en .

