#################################################################
# Illustrative Example Individuals
# (sample data to show how the ontology is used; not sourced facts)
#################################################################

# --- Domain engineering core ---------------------------------------
:WebApplicationDomainEngineering a owl:NamedIndividual , :DomainEngineeringProcess ;
    rdfs:label "Web Application Domain Engineering Process"@en ;
    :hasName "Web Application DE Process" ;
    :hasDescription "Domain engineering process for the web application domain" ;
    :hasMaturityLevel "3"^^xsd:int ;
    :hasCycleTime "P90D"^^xsd:duration .

:WebAppRequirementsAnalysis a owl:NamedIndividual , :DomainAnalysis ;
    rdfs:label "Web App Requirements Analysis"@en ;
    :hasName "Web Application Requirements Analysis" ;
    :hasDuration "P14D"^^xsd:duration ;
    :hasEffort "112.0"^^xsd:decimal ;
    :isAutomated "false"^^xsd:boolean ;
    :partOfProcess :WebApplicationDomainEngineering ;
    :addressesProblem :ScalabilityProblem ;
    :appliesMethod :FODAMethod ;
    :usesTool :FeatureIDE ;
    :producesAsset :WebAppFeatureModel ;
    :involvesStakeholder :ExampleSeniorStakeholder ;
    :precedes :WebAppDesign .

:WebAppDesign a owl:NamedIndividual , :DomainDesign ;
    rdfs:label "Web App Domain Design"@en ;
    :hasDuration "P21D"^^xsd:duration ; :partOfProcess :WebApplicationDomainEngineering ;
    :usesAsset :WebAppFeatureModel ; :precedes :WebAppImplementation .

:WebAppImplementation a owl:NamedIndividual , :DomainImplementation ;
    rdfs:label "Web App Domain Implementation"@en ;
    :hasDuration "P45D"^^xsd:duration ; :partOfProcess :WebApplicationDomainEngineering ;
    :producesAsset :AuthenticationComponent .

:AuthenticationComponent a owl:NamedIndividual , :Component ;
    rdfs:label "Authentication Component"@en ;
    :hasName "Generic Authentication Component" ;
    :hasDescription "Reusable authentication component for web applications" ;
    :hasVersion "2.1.0" ;
    :hasAuthor "Domain Engineering Team" ;
    :hasCreationDate "2024-03-15"^^xsd:date ;
    :hasReuseRate "0.85"^^xsd:decimal ;
    :isReusable "true"^^xsd:boolean ;
    :isConfigurable "true"^^xsd:boolean ;
    :hasComplexity "7.5"^^xsd:decimal ;
    :hasVariationPoint :AuthVariationPoint ;
    :hasQualityAttribute :SecurityAttribute , :ReusabilityAttribute ;
    :enablesCapability :PaymentProcessingCapability ;
    :deliversBenefit :RevenueIncreaseBenefit ;
    :implementsArchitecture :ECommerceOperationalArch .

:WebAppFeatureModel a owl:NamedIndividual , :FeatureModel ;
    rdfs:label "Web Application Feature Model"@en ;
    :hasName "Web App Feature Model" ;
    :hasVersion "1.0" ;
    :hasFeature :UserManagement , :Authentication , :ContentManagement .

:UserManagement a owl:NamedIndividual , :MandatoryFeature ; rdfs:label "User Management"@en ;
    :hasName "User Management" ; :childFeature :UserRegistration , :UserProfile .
:UserRegistration a owl:NamedIndividual , :MandatoryFeature ; rdfs:label "User Registration"@en .
:UserProfile a owl:NamedIndividual , :OptionalFeature ; rdfs:label "User Profile"@en .
:ContentManagement a owl:NamedIndividual , :OptionalFeature ; rdfs:label "Content Management"@en .
:Authentication a owl:NamedIndividual , :MandatoryFeature ; rdfs:label "Authentication"@en ;
    :hasName "Authentication" ; :childFeature :BasicAuth , :OAuth2 , :SAML .
:BasicAuth a owl:NamedIndividual , :AlternativeFeature ; rdfs:label "Basic Authentication"@en ; :parentFeature :Authentication .
:OAuth2 a owl:NamedIndividual , :AlternativeFeature ; rdfs:label "OAuth 2.0"@en ; :parentFeature :Authentication .
:SAML a owl:NamedIndividual , :AlternativeFeature ; rdfs:label "SAML"@en ; :parentFeature :Authentication .

:AuthVariationPoint a owl:NamedIndividual , :VariationPoint ;
    rdfs:label "Authentication Variation Point"@en ;
    :hasName "Authentication Method Selection" ;
    :hasVariant :BasicAuthVariant , :OAuth2Variant , :SAMLVariant ;
    :implementsVariability :ParameterVariabilityMechanism .
:BasicAuthVariant a owl:NamedIndividual , :Variant ; rdfs:label "Basic Authentication Variant"@en .
:OAuth2Variant a owl:NamedIndividual , :Variant ; rdfs:label "OAuth 2.0 Variant"@en .
:SAMLVariant a owl:NamedIndividual , :Variant ; rdfs:label "SAML Variant"@en .
:ParameterVariabilityMechanism a owl:NamedIndividual , :ParameterVariability ; rdfs:label "Parameter-based Variability"@en .

:SecurityAttribute a owl:NamedIndividual , :QualityAttribute ; rdfs:label "Security"@en ; :measuredBy :SecurityMetric .
:ReusabilityAttribute a owl:NamedIndividual , :Reusability ; rdfs:label "Reusability"@en ; :measuredBy :ReuseRateMetric .
:SecurityMetric a owl:NamedIndividual , :Metric ; rdfs:label "Security Metric"@en ;
    :hasDescription "Vulnerabilities found per release" .
:ReuseRateMetric a owl:NamedIndividual , :ReuseMetric ; rdfs:label "Reuse Rate Metric"@en ;
    :hasName "Asset Reuse Rate" ; :hasDescription "Percentage of assets reused across projects" .
:CycleTimeMetric a owl:NamedIndividual , :ProcessMetric ; rdfs:label "Cycle Time Metric"@en ;
    :hasName "Process Cycle Time" ; :hasDescription "Time from process start to completion" .

:SeniorDomainAnalyst a owl:NamedIndividual , :DomainAnalyst ;
    rdfs:label "Senior Domain Analyst (example role holder)"@en ;
    :performsActivity :WebAppRequirementsAnalysis .
:ExampleSeniorStakeholder a owl:NamedIndividual , :Stakeholder ; rdfs:label "Example Business Stakeholder"@en .
:FeatureIDE a owl:NamedIndividual , :FeatureModelingTool ; rdfs:label "FeatureIDE"@en ;
    :hasDescription "Eclipse-based tool for feature modeling" .
:FODAMethod a owl:NamedIndividual , :FODA ; rdfs:label "FODA Method"@en ;
    :hasDescription "Method for identifying and organizing domain features" .

# --- Business context --------------------------------------------------
:ECommerceDomain a owl:NamedIndividual , :BusinessEnvironment ;
    rdfs:label "E-Commerce Business Environment"@en ;
    :hasDescription "Business environment for e-commerce: online retail, payment processing and customer management" ;
    :definesBusinessProcess :OrderProcessingProcess .
:ScalabilityProblem a owl:NamedIndividual , :ProblemDescription ; rdfs:label "Scalability Problem"@en ;
    :hasDescription "Current systems cannot handle peak traffic during sales events" ;
    :priorityLevel "High" ; :problemSeverity "Critical" .
:PaymentProcessingCapability a owl:NamedIndividual , :SystemCapabilities ; rdfs:label "Payment Processing Capability"@en ;
    :hasDescription "Ability to process multiple payment methods securely and efficiently" ; :capabilityType "Functional" .
:RevenueIncreaseBenefit a owl:NamedIndividual , :BusinessBenefits ; rdfs:label "Revenue Increase Benefit"@en ;
    :hasDescription "Projected revenue increase through improved system performance" ; :businessValue "500000.00"^^xsd:decimal .
:OrderProcessingProcess a owl:NamedIndividual , :CoreBusinessProcess ; rdfs:label "Order Processing Process"@en ;
    :hasDescription "Process from order placement to fulfillment" ; :processMaturity "3"^^xsd:int ;
    :hasBusinessRole :CustomerServiceRole ; :governedByRule :RefundPolicyRule ;
    :includesOperation :OrderFulfillmentOperation ; :consumesInput :CustomerOrder ; :producesOutput :DeliveredProduct ;
    :hasCost :OrderProcessingCost .
:CustomerOrder a owl:NamedIndividual , :ProcessInput ; rdfs:label "Customer Order"@en .
:DeliveredProduct a owl:NamedIndividual , :ProcessOutput ; rdfs:label "Delivered Product"@en .
:OrderProcessingCost a owl:NamedIndividual , :Cost ; rdfs:label "Order Processing Cost"@en .
:HRManagementProcess a owl:NamedIndividual , :SupportingProcess ; rdfs:label "Human Resources Process"@en ;
    :supportsCoreProcess :OrderProcessingProcess ; :hasBusinessRole :CustomerServiceRole .
:CustomerServiceRole a owl:NamedIndividual , :BusinessRole ; rdfs:label "Customer Service Role"@en ;
    :hasDescription "Handles customer inquiries, complaints and support requests" .
:RefundPolicyRule a owl:NamedIndividual , :BusinessRule ; rdfs:label "30-Day Refund Policy"@en ;
    :hasDescription "Customers may return items within 30 days for a full refund" ; :ruleType "Policy" .
:ECommerceAppPortfolio a owl:NamedIndividual , :ApplicationPortfolio ; rdfs:label "E-Commerce Application Portfolio"@en ;
    :applicationCount "12"^^xsd:int ; :includesApplication :AuthenticationComponent .
:ECommerceOperationalArch a owl:NamedIndividual , :OperationalArchitecture ;
    rdfs:label "E-Commerce Operational Architecture"@en ;
    :hasDescription "Operational architecture supporting e-commerce business processes" .
:OrderFulfillmentOperation a owl:NamedIndividual , :Operation ; rdfs:label "Order Fulfillment Operation"@en ;
    :operatesIn :ProductionEnvironment .
:ProductionEnvironment a owl:NamedIndividual , :OperationalEnvironment ; rdfs:label "Production Environment"@en ;
    :utilizationRate "72.5"^^xsd:decimal .
:OperationsOffice a owl:NamedIndividual , :OperationsManagement ; rdfs:label "Operations Office"@en ;
    :configuresEnvironment :ProductionEnvironment ; :monitorsOperation :OrderFulfillmentOperation .

# --- Data collection --------------------------------------------------
:StakeholderInterviewLog a owl:NamedIndividual , :DataCollectionLog ; rdfs:label "Stakeholder Interview Log"@en ;
    :collectionDate "2024-06-15"^^xsd:date ; :collectionMethod "Structured interviews" ;
    :logsActivity :WebAppRequirementsAnalysis .
:ProjectActivitySummary a owl:NamedIndividual , :ActivitySummary ; rdfs:label "Project Activity Summary"@en ;
    :hasCreationDate "2024-06-30"^^xsd:date ; :summarizesActivity :WebAppRequirementsAnalysis .
:BusinessStakeholderInterviews a owl:NamedIndividual , :InterviewList ; rdfs:label "Business Stakeholder Interviews"@en ;
    :collectionDate "2024-06-01"^^xsd:date ; :collectionMethod "Interview" ; :interviewDuration "PT90M"^^xsd:duration ;
    :documentsInterview :ExampleSeniorStakeholder .
:ArchitectureReviewMeetings a owl:NamedIndividual , :MeetingList ; rdfs:label "Architecture Review Meetings"@en ;
    :collectionDate "2024-06-10"^^xsd:date ; :collectionMethod "Meeting minutes" ; :meetingType "Review" ;
    :participantCount "8"^^xsd:int ; :recordsMeeting :ExampleSeniorStakeholder .
:RequirementsDocAnalysis a owl:NamedIndividual , :DocumentAnalysisList ; rdfs:label "Requirements Document Analysis"@en ;
    :collectionDate "2024-05-20"^^xsd:date ; :collectionMethod "Document review" ; :analysisMethod "Content analysis" ;
    :analyzesDocument :WebAppFeatureModel .

# --- Vendors and solutions (generic placeholders) ----------------------
:ExampleCloudVendor a owl:NamedIndividual , :Vendor ; rdfs:label "Example Cloud Vendor"@en ;
    :vendorName "Example Cloud Vendor" ; :marketShare "30.0"^^xsd:decimal .
:ExampleCommerceVendor a owl:NamedIndividual , :Vendor ; rdfs:label "Example Commerce Vendor"@en ;
    :vendorName "Example Commerce Vendor" ; :marketShare "8.5"^^xsd:decimal .
:ExampleIntegrator a owl:NamedIndividual , :SolutionProvider ; rdfs:label "Example Solution Provider"@en .
:ExampleCommercePlatform a owl:NamedIndividual , :VendorSolution ; rdfs:label "Example Commerce Platform (SaaS)"@en ;
    :solutionCost "299.00"^^xsd:decimal ; :solutionRating "4.5"^^xsd:decimal ; :solutionMaturity "Mature" ;
    :implementationTime "P60D"^^xsd:duration ; :providedByVendor :ExampleCommerceVendor ;
    :offeredBySolutionProvider :ExampleIntegrator ; :supportsCapability :PaymentProcessingCapability ;
    :hasAlternative :ExampleOpenSourcePlatform ; :competesWith :ExampleOpenSourcePlatform .
:ExampleOpenSourcePlatform a owl:NamedIndividual , :AlternativeSolution ; rdfs:label "Example Open-Source Platform (alternative)"@en ;
    :solutionCost "1500.00"^^xsd:decimal ; :solutionRating "4.2"^^xsd:decimal ; :solutionMaturity "Mature" ;
    :implementationTime "P90D"^^xsd:duration ; :providedByVendor :ExampleCloudVendor .

# --- SWOT and SIPOC ------------------------------------------------------
:ECommerceSWOT a owl:NamedIndividual , :SWOTAnalysis ; rdfs:label "E-Commerce SWOT Analysis"@en ;
    :hasDescription "Strengths, weaknesses, opportunities and threats of the e-commerce domain" ;
    :hasStrength :TechnicalExpertise , :ExistingCustomerBase ;
