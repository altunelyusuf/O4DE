    skos:narrower :BusinessEnvironmentConcept, :ProblemDescriptionConcept, :SystemCapabilitiesConcept, :BusinessBenefitsConcept, :BusinessProcessConcept, :BusinessRoleConcept, :BusinessRuleConcept, :ApplicationPortfolioConcept, :OperationalArchitectureConcept ;
    rdfs:seeAlso :BusinessContext .

