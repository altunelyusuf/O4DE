#################################################################
# Datatype Properties
#################################################################

:hasName a owl:DatatypeProperty ; rdfs:domain owl:Thing ; rdfs:range xsd:string ; rdfs:label "has name"@en .
:hasDescription a owl:DatatypeProperty ; rdfs:domain owl:Thing ; rdfs:range xsd:string ; rdfs:label "has description"@en .

# Assets and activities
:hasVersion a owl:DatatypeProperty ; rdfs:domain :DomainAsset ; rdfs:range xsd:string ; rdfs:label "has version"@en .
:hasAuthor a owl:DatatypeProperty ; rdfs:domain :DomainAsset ; rdfs:range xsd:string ; rdfs:label "has author"@en .
