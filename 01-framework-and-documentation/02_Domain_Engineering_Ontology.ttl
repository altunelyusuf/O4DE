:maximumStock a owl:DatatypeProperty ; rdfs:domain :Inventory ; rdfs:range xsd:int ; rdfs:label "maximum stock"@en .
:reorderPoint a owl:DatatypeProperty ; rdfs:domain :Inventory ; rdfs:range xsd:int ; rdfs:label "reorder point"@en .
:unitCost a owl:DatatypeProperty ; rdfs:domain :Inventory ; rdfs:range xsd:decimal ; rdfs:label "unit cost"@en .
:inventoryValue a owl:DatatypeProperty ; rdfs:domain :Inventory ; rdfs:range xsd:decimal ; rdfs:label "inventory value"@en .
:utilizationRate a owl:DatatypeProperty ; rdfs:domain :OperationalEnvironment ; rdfs:range xsd:decimal ;
    rdfs:label "utilization rate"@en ; rdfs:comment "0.0 to 100.0"@en .

# Organization and agility
:departmentCode a owl:DatatypeProperty ; rdfs:domain :Department ; rdfs:range xsd:string ; rdfs:label "department code"@en .
:departmentSize a owl:DatatypeProperty ; rdfs:domain :Department ; rdfs:range xsd:int ; rdfs:label "department size"@en .
:teamSize a owl:DatatypeProperty ; rdfs:domain :Team ; rdfs:range xsd:int ; rdfs:label "team size"@en .
:employeeID a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:string ; rdfs:label "employee ID"@en .
:hireDate a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:date ; rdfs:label "hire date"@en .
:salary a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:decimal ; rdfs:label "salary"@en .
:experienceYears a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:decimal ; rdfs:label "experience years"@en .
:performanceRating a owl:DatatypeProperty ; rdfs:domain :Employee ; rdfs:range xsd:decimal ;
    rdfs:label "performance rating"@en ; rdfs:comment "0.0 to 5.0"@en .
:positionLevel a owl:DatatypeProperty ; rdfs:domain :Position ; rdfs:range xsd:string ;
    rdfs:label "position level"@en ; rdfs:comment "Entry, Mid, Senior or Executive"@en .
:hierarchyLevel a owl:DatatypeProperty ; rdfs:domain :OrganizationalHierarchy ; rdfs:range xsd:int ; rdfs:label "hierarchy level"@en .
:agilityScore a owl:DatatypeProperty ; rdfs:domain :OrganizationalAgility ; rdfs:range xsd:decimal ;
    rdfs:label "agility score"@en ; rdfs:comment "0.0 to 10.0"@en .
:adaptabilityIndex a owl:DatatypeProperty ; rdfs:domain :OrganizationalAgility ; rdfs:range xsd:decimal ;
    rdfs:label "adaptability index"@en ; rdfs:comment "0.0 to 1.0"@en .
:responseTime a owl:DatatypeProperty ; rdfs:domain :OrganizationalAgility ; rdfs:range xsd:duration ; rdfs:label "response time"@en .
:sprintDuration a owl:DatatypeProperty ; rdfs:domain :Sprint ; rdfs:range xsd:duration ; rdfs:label "sprint duration"@en .
:sprintVelocity a owl:DatatypeProperty ; rdfs:domain :Sprint ; rdfs:range xsd:decimal ; rdfs:label "sprint velocity"@en .
:methodologyType a owl:DatatypeProperty ; rdfs:domain :AgileMethodology ; rdfs:range xsd:string ;
    rdfs:label "methodology type"@en ; rdfs:comment "Scrum, Kanban, SAFe or Lean"@en .

#################################################################
# Axioms and Restrictions
#################################################################

# Process activities must have a duration
:ProcessActivity rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasDuration ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
# Quality attributes must be measured by at least one metric
:QualityAttribute rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :measuredBy ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
# Domain Analysis precedes Domain Design; Domain Design precedes Domain Implementation
:DomainAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :precedes ; owl:someValuesFrom :DomainDesign ] .
:DomainDesign rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :precedes ; owl:someValuesFrom :DomainImplementation ] .

# Maturity level must be between 1 and 5
:DomainEngineeringProcess rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasMaturityLevel ;
    owl:allValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:int ;
        owl:withRestrictions ( [ xsd:minInclusive "1"^^xsd:int ] [ xsd:maxInclusive "5"^^xsd:int ] ) ] ] .

# Business context
:BusinessRule rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :ruleType ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:BusinessProcess rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasBusinessRole ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:DataCollectionLog rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :collectionDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:DataCollectionLog rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :collectionMethod ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:VendorSolution rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :providedByVendor ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:Vendor rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :vendorName ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

# Allowed values and ranges
:ProblemDescription rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :problemSeverity ;
    owl:allValuesFrom [ a rdfs:Datatype ; owl:oneOf ( "Critical" "Major" "Minor" ) ] ] .
:ProblemDescription rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :priorityLevel ;
    owl:allValuesFrom [ a rdfs:Datatype ; owl:oneOf ( "High" "Medium" "Low" ) ] ] .
:VendorSolution rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :solutionRating ;
    owl:allValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:decimal ] [ xsd:maxInclusive "5.0"^^xsd:decimal ] ) ] ] .
:Product rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :qualityScore ;
    owl:allValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:decimal ] [ xsd:maxInclusive "10.0"^^xsd:decimal ] ) ] ] .
:Employee rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :performanceRating ;
    owl:allValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:decimal ] [ xsd:maxInclusive "5.0"^^xsd:decimal ] ) ] ] .
:Discount rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :discountPercentage ;
    owl:allValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:decimal ] [ xsd:maxInclusive "100.0"^^xsd:decimal ] ) ] ] .
:OperationalEnvironment rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :utilizationRate ;
    owl:allValuesFrom [ a rdfs:Datatype ; owl:onDatatype xsd:decimal ;
        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:decimal ] [ xsd:maxInclusive "100.0"^^xsd:decimal ] ) ] ] .

# SWOT and SIPOC completeness
:SWOTAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasStrength ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:SWOTAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasWeakness ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:SWOTAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasOpportunity ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:SWOTAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasThreat ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:SIPOCAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasSupplier ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:SIPOCAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasInput ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:SIPOCAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasOutput ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:SIPOCAnalysis rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasCustomer ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .

# Product, customer, campaign, organization
:Product rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasLifecycle ; owl:someValuesFrom :ProductLifecycle ] .
:Product rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :currentStage ; owl:someValuesFrom :ProductLifecycleStage ] .
:Customer rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :belongsToSegment ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:MarketingCampaign rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :campaignStartDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:MarketingCampaign rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :campaignEndDate ; owl:minCardinality "1"^^xsd:nonNegativeInteger ] .
:Employee rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :belongsToUnit ; owl:someValuesFrom :OrganizationalUnit ] .
:Employee rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :holdsPosition ; owl:someValuesFrom :Position ] .

# Disjointness
[] a owl:AllDisjointClasses ; owl:members ( :MandatoryFeature :OptionalFeature :AlternativeFeature ) .
[] a owl:AllDisjointClasses ; owl:members ( :ParameterVariability :InheritanceVariability :CompositionVariability ) .
[] a owl:AllDisjointClasses ; owl:members ( :DomainAnalysis :DomainDesign :DomainImplementation :DomainEvolution ) .
[] a owl:AllDisjointClasses ; owl:members ( :Component :Framework :DomainSpecificLanguage :ReferenceArchitecture :DomainModel ) .
[] a owl:AllDisjointClasses ; owl:members ( :BusinessEnvironment :ProblemDescription :SystemCapabilities :BusinessBenefits
    :BusinessProcess :BusinessRole :BusinessRule :ApplicationPortfolio :OperationalArchitecture ) .
[] a owl:AllDisjointClasses ; owl:members ( :InterviewList :MeetingList :DocumentAnalysisList :ActivitySummary ) .
[] a owl:AllDisjointClasses ; owl:members ( :Vendor :SolutionProvider :VendorSolution ) .
[] a owl:AllDisjointClasses ; owl:members ( :DevelopmentStage :IntroductionStage :GrowthStage :MaturityStage :DeclineStage ) .
[] a owl:AllDisjointClasses ; owl:members ( :Strength :Weakness :Opportunity :Threat ) .
[] a owl:AllDisjointClasses ; owl:members ( :SalesChannel :DistributionChannel :DigitalChannel ) .
[] a owl:AllDisjointClasses ; owl:members ( :Department :Team ) .

#################################################################
# SKOS Taxonomies
# Each concept links to the ontology class of the same label (rdfs:seeAlso) where one exists.
#################################################################

:DomainEngineeringTaxonomy a skos:ConceptScheme ;
    dc:title "Domain Engineering Taxonomy"@en ;
    dc:description "Hierarchical classification of domain engineering concepts"@en ;
    skos:hasTopConcept :DomainEngineeringConcept .

:DomainEngineeringConcept a skos:Concept ; ;
    skos:prefLabel "Domain Engineering"@en ; ;
    skos:inScheme :DomainEngineeringTaxonomy ;
    skos:topConceptOf :DomainEngineeringTaxonomy ;
    skos:narrower :DomainEngineeringActivitiesConcept, :DomainAssetsConcept, :ProcessesConcept, :MethodologiesConcept, :QualityConcept, :BusinessContextConcept, :DataCollectionConcept, :VendorSolutionsConcept .

:DomainEngineeringActivitiesConcept a skos:Concept ; ;
    skos:prefLabel "Domain Engineering Activities"@en ; ;
    skos:inScheme :DomainEngineeringTaxonomy ;
    skos:broader :DomainEngineeringConcept ;
    skos:narrower :DomainAnalysisConcept, :DomainDesignConcept, :DomainImplementationConcept, :DomainEvolutionConcept .

:DomainAnalysisConcept a skos:Concept ; ;
    skos:prefLabel "Domain Analysis"@en ; ;
    skos:inScheme :DomainEngineeringTaxonomy ;
    skos:broader :DomainEngineeringActivitiesConcept ;
    skos:narrower :RequirementsAnalysisConcept, :StakeholderAnalysisConcept, :CompetitiveAnalysisConcept, :FeasibilityAnalysisConcept ;
    rdfs:seeAlso :DomainAnalysis .

:RequirementsAnalysisConcept a skos:Concept ; ;
    skos:prefLabel "Requirements Analysis"@en ; ;
    skos:inScheme :DomainEngineeringTaxonomy ;
    skos:broader :DomainAnalysisConcept .

