@prefix : <http://example.org/domain-engineering#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@base <http://example.org/domain-engineering#> .

<http://example.org/domain-engineering> rdf:type owl:Ontology ;
    dc:title "Domain Engineering Ontology (Enterprise Edition)"@en ;
    dc:description "A formal ontology for enterprise domain engineering covering domain analysis, design, implementation and evolution; domain assets, features and variability; processes, roles, metrics and optimization; business context, strategic analysis (SWOT, SIPOC), product, customer, channel, financial, inventory, campaign, organizational and agility management; with SKOS taxonomies for its hierarchies. Built following the Meta-Ontology definition of ontology and taxonomy."@en ;
    dcterms:created "2026-10-13"^^xsd:date ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    owl:versionInfo "2.0.0 - Enterprise Edition" ;
    dc:creator "Domain Engineering Working Group" ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:subject "Domain Engineering", "Business Analysis", "Strategic Planning", "Product Management",
                    "Customer Management", "Organizational Management", "Agile Methodologies",
                    "Quality Management", "Operations Management", "Process Improvement" ;
    dcterms:coverage "Enterprise Domain Engineering" .

#################################################################
# Domain Engineering Activities and Processes
#################################################################

:ProcessActivity a owl:Class ;
    rdfs:label "Process Activity"@en ;
    skos:definition "A unit of work performed within a process, with a duration, effort and responsible roles"@en .

:DomainEngineeringActivity a owl:Class ;
    rdfs:subClassOf :ProcessActivity ;
    rdfs:label "Domain Engineering Activity"@en ;
    skos:definition "A systematic activity that contributes to the creation, analysis, design, implementation or evolution of domain assets"@en ;
    skos:scopeNote "Domain engineering activities are the fundamental building blocks of the domain engineering process"@en ;
    skos:example "Domain analysis, feature modeling, component design, asset testing"@en .

:DomainAnalysis a owl:Class ; rdfs:subClassOf :DomainEngineeringActivity ;
    rdfs:label "Domain Analysis"@en ;
    skos:definition "Identification and understanding of the problem space: stakeholder needs, constraints, common requirements and variability"@en .
:DomainDesign a owl:Class ; rdfs:subClassOf :DomainEngineeringActivity ;
    rdfs:label "Domain Design"@en ;
    skos:definition "Creation of architectural solutions and design patterns for the commonalities and variabilities found in analysis"@en .
:DomainImplementation a owl:Class ; rdfs:subClassOf :DomainEngineeringActivity ;
    rdfs:label "Domain Implementation"@en ;
    skos:definition "Development and testing of reusable components, frameworks and domain-specific tools"@en .
:DomainEvolution a owl:Class ; rdfs:subClassOf :DomainEngineeringActivity ;
    rdfs:label "Domain Evolution"@en ;
    skos:definition "Change management, versioning and maintenance of domain assets over time"@en .

:DomainEngineeringProcess a owl:Class ;
    rdfs:label "Domain Engineering Process"@en ;
    skos:definition "A structured set of activities, roles and controls that produces and maintains domain assets"@en .

:DataCollectionActivity a owl:Class ; rdfs:subClassOf :DomainEngineeringActivity ;
    rdfs:label "Data Collection Activity"@en ;
    skos:definition "Systematic activity for collecting data, information and knowledge relevant to domain engineering"@en .

:AgileActivity a owl:Class ; rdfs:subClassOf :DomainEngineeringActivity ;
    rdfs:label "Agile Activity"@en ;
    skos:definition "A domain engineering activity that follows agile principles such as iterative development and continuous feedback"@en .
:Sprint a owl:Class ; rdfs:subClassOf :AgileActivity ;
    rdfs:label "Sprint"@en ;
    skos:definition "A time-boxed iteration used in agile methodologies to deliver working increments"@en .
:Retrospective a owl:Class ; rdfs:subClassOf :AgileActivity ;
    rdfs:label "Retrospective"@en ;
    skos:definition "A regular meeting where a team reflects on its process and identifies improvements"@en .

#################################################################
# Domain Assets
#################################################################

:DomainAsset a owl:Class ;
    rdfs:label "Domain Asset"@en ;
    skos:definition "A reusable artifact that encapsulates domain knowledge and can be used across multiple applications within the same domain"@en ;
    skos:scopeNote "Domain assets are the primary output of domain engineering activities"@en ;
    skos:example "Reusable components, frameworks, reference architectures, domain models, DSLs"@en .
:Component a owl:Class ; rdfs:subClassOf :DomainAsset ; rdfs:label "Component"@en ;
    skos:definition "A reusable, configurable software building block with defined interfaces"@en .
:Framework a owl:Class ; rdfs:subClassOf :DomainAsset ; rdfs:label "Framework"@en ;
    skos:definition "A reusable skeleton of cooperating components with extension points for a domain"@en .
:DomainSpecificLanguage a owl:Class ; rdfs:subClassOf :DomainAsset ; rdfs:label "Domain-Specific Language"@en ;
    skos:definition "A language with syntax and semantics tailored to expressing solutions in the domain"@en .
:ReferenceArchitecture a owl:Class ; rdfs:subClassOf :DomainAsset ; rdfs:label "Reference Architecture"@en ;
    skos:definition "An architectural template capturing the structural and behavioral patterns of systems in the domain"@en .
:DomainModel a owl:Class ; rdfs:subClassOf :DomainAsset ; rdfs:label "Domain Model"@en ;
    skos:definition "A model of the key concepts, relationships and constraints within the application domain"@en .
:FeatureModel a owl:Class ; rdfs:subClassOf :DomainAsset ; rdfs:label "Feature Model"@en ;
    skos:definition "A hierarchical model that captures the commonalities and variabilities of a domain in terms of features and their relationships"@en ;
    skos:scopeNote "Feature models are central to managing variability in domain engineering"@en .

#################################################################
# Features and Variability
#################################################################

:Feature a owl:Class ; rdfs:label "Feature"@en ;
    skos:definition "A distinguishable characteristic of a system that is relevant to a stakeholder"@en .
:MandatoryFeature a owl:Class ; rdfs:subClassOf :Feature ; rdfs:label "Mandatory Feature"@en .
:OptionalFeature a owl:Class ; rdfs:subClassOf :Feature ; rdfs:label "Optional Feature"@en .
:AlternativeFeature a owl:Class ; rdfs:subClassOf :Feature ; rdfs:label "Alternative Feature"@en .

:VariationPoint a owl:Class ; rdfs:label "Variation Point"@en ;
    skos:definition "A location in a domain asset where variation occurs, representing a design decision that can be made in different ways"@en ;
    skos:scopeNote "Variation points enable customization and adaptation of domain assets"@en ;
    skos:example "Database selection point, authentication mechanism choice, UI framework selection"@en .
:Variant a owl:Class ; rdfs:label "Variant"@en ;
    skos:definition "One concrete choice that can be bound at a variation point"@en .
:VariabilityMechanism a owl:Class ; rdfs:label "Variability Mechanism"@en ;
    skos:definition "A technique that implements variation at a variation point"@en .
:ParameterVariability a owl:Class ; rdfs:subClassOf :VariabilityMechanism ; rdfs:label "Parameter Variability"@en .
:InheritanceVariability a owl:Class ; rdfs:subClassOf :VariabilityMechanism ; rdfs:label "Inheritance Variability"@en .
:CompositionVariability a owl:Class ; rdfs:subClassOf :VariabilityMechanism ; rdfs:label "Composition Variability"@en .

#################################################################
# Quality, Metrics, Roles, Tools and Methods
#################################################################

:QualityAttribute a owl:Class ; rdfs:label "Quality Attribute"@en ;
    skos:definition "A measurable property of a system or asset such as security, performance or reusability"@en .
:Reusability a owl:Class ; rdfs:subClassOf :QualityAttribute ; rdfs:label "Reusability"@en .

:Metric a owl:Class ; rdfs:label "Metric"@en ;
    skos:definition "A defined measure used to quantify a quality attribute or process performance"@en .
:ReuseMetric a owl:Class ; rdfs:subClassOf :Metric ; rdfs:label "Reuse Metric"@en .
:ProcessMetric a owl:Class ; rdfs:subClassOf :Metric ; rdfs:label "Process Metric"@en .

:Stakeholder a owl:Class ; rdfs:subClassOf foaf:Agent ; rdfs:label "Stakeholder"@en ;
    skos:definition "A person or organization with an interest in, or influence over, the domain"@en .
:Role a owl:Class ; rdfs:label "Role"@en ;
    skos:definition "A set of responsibilities and competencies assigned to a person in a process"@en .
:DomainAnalyst a owl:Class ; rdfs:subClassOf :Role ; rdfs:label "Domain Analyst"@en .
:DomainArchitect a owl:Class ; rdfs:subClassOf :Role ; rdfs:label "Domain Architect"@en .
:DomainDeveloper a owl:Class ; rdfs:subClassOf :Role ; rdfs:label "Domain Developer"@en .

:Tool a owl:Class ; rdfs:label "Tool"@en ;
    skos:definition "A software tool that supports domain engineering activities"@en .
:FeatureModelingTool a owl:Class ; rdfs:subClassOf :Tool ; rdfs:label "Feature Modeling Tool"@en .
:Method a owl:Class ; rdfs:label "Method"@en ;
    skos:definition "A systematic technique for carrying out domain engineering activities"@en .
:FODA a owl:Class ; rdfs:subClassOf :Method ; rdfs:label "Feature-Oriented Domain Analysis"@en .
:DSSA a owl:Class ; rdfs:subClassOf :Method ; rdfs:label "Domain-Specific Software Architecture"@en .
:ProductLineEngineering a owl:Class ; rdfs:subClassOf :Method ; rdfs:label "Product Line Engineering"@en .

#################################################################
# Business Context
#################################################################

:BusinessContext a owl:Class ; rdfs:label "Business Context"@en ;
    skos:definition "Business-oriented information and context that influences domain engineering decisions: environment, problems, capabilities, benefits, processes, roles, rules and architecture"@en ;
    skos:scopeNote "Business context provides the foundation for understanding domain requirements and constraints"@en .
:BusinessEnvironment a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Business Environment"@en ;
    skos:definition "The business ecosystem, market conditions and organizational context in which the domain operates"@en .
:ProblemDescription a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Problem Description"@en ;
    skos:definition "A structured description of business problems, challenges and opportunities that drive domain engineering efforts"@en .
:SystemCapabilities a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "System Capabilities"@en ;
    skos:definition "Abilities, features and services that systems within the domain must deliver"@en .
:BusinessBenefits a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Business Benefits"@en ;
    skos:definition "Quantifiable and qualitative benefits that domain engineering brings to the organization"@en .
:BusinessProcess a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Business Process"@en ;
    skos:definition "A collection of related, structured activities that produce a specific service or product for customers"@en ;
    skos:example "Order processing, customer onboarding, payment processing, inventory management"@en .
:BusinessRole a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Business Role"@en ;
    skos:definition "A set of responsibilities and authorities assigned to individuals in business processes"@en .
:BusinessRule a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Business Rule"@en ;
    skos:definition "A directive intended to influence or guide business behavior and decision-making"@en .
:ApplicationPortfolio a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Application Portfolio"@en ;
    skos:definition "An inventory of all applications, systems and software assets used in the business domain"@en .
:OperationalArchitecture a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Operational Architecture"@en ;
    skos:definition "The structural design of business operations, workflows and organizational elements"@en .

:ProcessClassification a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Process Classification"@en ;
    skos:definition "Categorization of business processes based on their purpose and characteristics"@en .
:CoreBusinessProcess a owl:Class ; rdfs:subClassOf :BusinessProcess ; rdfs:label "Core Business Process"@en ;
    skos:definition "Essential business processes that directly create customer value"@en ;
    skos:example "Order processing, product development, customer service, payment processing"@en .
:SupportingProcess a owl:Class ; rdfs:subClassOf :BusinessProcess ; rdfs:label "Supporting Process"@en ;
    skos:definition "Processes that provide the support and infrastructure for core business processes"@en ;
    skos:example "Human resources, IT support, accounting, facilities management, compliance"@en ;
    owl:disjointWith :CoreBusinessProcess .

:OperationsManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Operations Management"@en ;
    skos:definition "Management of day-to-day operational activities and environments"@en .
:OperationalEnvironment a owl:Class ; rdfs:subClassOf :OperationsManagement ; rdfs:label "Operational Environment"@en ;
    skos:definition "The physical, technological and organizational context in which operations take place"@en .
:Operation a owl:Class ; rdfs:subClassOf :OperationsManagement ; rdfs:label "Operation"@en ;
    skos:definition "A specific activity or set of activities performed as part of business operations"@en .

#################################################################
# Data Collection and Documentation
#################################################################

:DataCollectionLog a owl:Class ; rdfs:subClassOf :DomainAsset ; rdfs:label "Data Collection Log"@en ;
    skos:definition "A systematic record of what data was collected, when, how and by whom during domain engineering"@en .
:ActivitySummary a owl:Class ; rdfs:subClassOf :DomainAsset ; rdfs:label "Activity Summary"@en ;
    skos:definition "A consolidated record of what activities were performed, when, where and with whom"@en .
:InterviewList a owl:Class ; rdfs:subClassOf :DataCollectionLog ; rdfs:label "Interview List"@en ;
    skos:definition "A list of interviews with stakeholders: participants, topics and outcomes"@en .
:MeetingList a owl:Class ; rdfs:subClassOf :DataCollectionLog ; rdfs:label "Meeting List"@en ;
    skos:definition "A list of meetings, workshops and collaborative sessions conducted during domain engineering"@en .
:DocumentAnalysisList a owl:Class ; rdfs:subClassOf :DataCollectionLog ; rdfs:label "Document Analysis List"@en ;
    skos:definition "A record of documents analyzed, analysis methods used and findings obtained"@en .

#################################################################
# Vendors and Solutions
#################################################################

:VendorSolution a owl:Class ; rdfs:label "Vendor Solution"@en ;
    skos:definition "Third-party products, services and solutions that can be leveraged or considered in domain engineering"@en ;
    skos:example "Cloud platforms, commercial frameworks, third-party components, consulting services"@en .
:Vendor a owl:Class ; rdfs:subClassOf :Stakeholder ; rdfs:label "Vendor"@en ;
    skos:definition "A commercial entity that offers products, services or solutions relevant to the domain"@en .
:SolutionProvider a owl:Class ; rdfs:subClassOf :Stakeholder ; rdfs:label "Solution Provider"@en ;
    skos:definition "Any organization that provides solutions, services or expertise relevant to domain engineering"@en .
:AlternativeSolution a owl:Class ; rdfs:subClassOf :VendorSolution ; rdfs:label "Alternative Solution"@en ;
    skos:definition "A different technological or methodological approach that can address the same domain requirements"@en .

#################################################################
# Strategic Analysis (SWOT) and Process Analysis (SIPOC)
#################################################################

:StrategicAnalysis a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Strategic Analysis"@en ;
    skos:definition "Systematic analysis of strategic factors, including internal strengths and weaknesses and external opportunities and threats"@en ;
    skos:example "SWOT analysis, PEST analysis, competitive analysis, value chain analysis"@en .
:SWOTAnalysis a owl:Class ; rdfs:subClassOf :StrategicAnalysis ; rdfs:label "SWOT Analysis"@en ;
    skos:definition "A framework that evaluates Strengths, Weaknesses, Opportunities and Threats"@en .
:Strength a owl:Class ; rdfs:subClassOf :StrategicAnalysis ; rdfs:label "Strength"@en ;
    skos:definition "Internal capabilities, resources or attributes that provide competitive advantage"@en .
:Weakness a owl:Class ; rdfs:subClassOf :StrategicAnalysis ; rdfs:label "Weakness"@en ;
    skos:definition "Internal limitations or deficiencies that may hinder performance"@en .
:Opportunity a owl:Class ; rdfs:subClassOf :StrategicAnalysis ; rdfs:label "Opportunity"@en ;
    skos:definition "External factors or trends that could provide business opportunities"@en .
:Threat a owl:Class ; rdfs:subClassOf :StrategicAnalysis ; rdfs:label "Threat"@en ;
    skos:definition "External factors or trends that could pose risks or challenges"@en .

:ProcessAnalysis a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Process Analysis"@en ;
    skos:definition "Systematic analysis of business processes and their components"@en .
:SIPOCAnalysis a owl:Class ; rdfs:subClassOf :ProcessAnalysis ; rdfs:label "SIPOC Analysis"@en ;
    skos:definition "A framework analyzing Suppliers, Inputs, Process, Outputs and Customers to understand process boundaries"@en .
:Supplier a owl:Class ; rdfs:subClassOf :Stakeholder ; rdfs:label "Supplier"@en ;
    skos:definition "An organization or individual that provides inputs, materials or services to business processes"@en .
:ProcessInput a owl:Class ; rdfs:label "Process Input"@en ;
    skos:definition "Any material, information, resource or trigger consumed or used by a business process"@en .
:ProcessOutput a owl:Class ; rdfs:label "Process Output"@en ;
    skos:definition "Any product, service, information or result produced by a business process"@en .
:Customer a owl:Class ; rdfs:subClassOf :Stakeholder ; rdfs:label "Customer"@en ;
    skos:definition "An individual or organization that receives and uses the outputs of business processes"@en .

#################################################################
# Product and Service Portfolio, Lifecycle, Quality
#################################################################

:PortfolioManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Portfolio Management"@en ;
    skos:definition "Systematic management of products and services throughout their lifecycles"@en .
:ProductPortfolio a owl:Class ; rdfs:subClassOf :PortfolioManagement ; rdfs:label "Product Portfolio"@en ;
    skos:definition "A collection of products managed by the organization, with lifecycle stages, market performance and strategic positioning"@en .
:ServicePortfolio a owl:Class ; rdfs:subClassOf :PortfolioManagement ; rdfs:label "Service Portfolio"@en ;
    skos:definition "A collection of services offered by the organization"@en .
:Product a owl:Class ; rdfs:label "Product"@en ;
    skos:definition "A tangible or intangible good offered to satisfy customer needs"@en .
:Service a owl:Class ; rdfs:label "Service"@en ;
    skos:definition "An intangible offering that provides value to customers through activities or benefits"@en .
:ProductLifecycle a owl:Class ; rdfs:label "Product Lifecycle"@en ;
    skos:definition "The progression of a product through distinct phases from development to discontinuation"@en .
:ProductLifecycleStage a owl:Class ; rdfs:label "Product Lifecycle Stage"@en ;
    skos:definition "A distinct phase in a product's lifecycle"@en .
:DevelopmentStage a owl:Class ; rdfs:subClassOf :ProductLifecycleStage ; rdfs:label "Development Stage"@en ;
    rdfs:comment "Product is being developed and designed"@en .
:IntroductionStage a owl:Class ; rdfs:subClassOf :ProductLifecycleStage ; rdfs:label "Introduction Stage"@en ;
    rdfs:comment "Product is launched to market"@en .
:GrowthStage a owl:Class ; rdfs:subClassOf :ProductLifecycleStage ; rdfs:label "Growth Stage"@en ;
    rdfs:comment "Product experiences rapid market acceptance"@en .
:MaturityStage a owl:Class ; rdfs:subClassOf :ProductLifecycleStage ; rdfs:label "Maturity Stage"@en ;
    rdfs:comment "Product reaches peak market penetration"@en .
:DeclineStage a owl:Class ; rdfs:subClassOf :ProductLifecycleStage ; rdfs:label "Decline Stage"@en ;
    rdfs:comment "Product experiences decreasing demand"@en .

:QualityManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Quality Management"@en ;
    skos:definition "A systematic approach to ensuring that products and services meet or exceed requirements through planning, control, assurance and improvement"@en .
:ProductQualityManagement a owl:Class ; rdfs:subClassOf :QualityManagement ; rdfs:label "Product Quality Management"@en ;
    skos:definition "Management of quality standards, controls and improvements for products"@en .
:QualityStandard a owl:Class ; rdfs:subClassOf :QualityManagement ; rdfs:label "Quality Standard"@en ;
    skos:definition "Documented criteria used to measure and ensure quality"@en .
:QualityControl a owl:Class ; rdfs:subClassOf :QualityManagement ; rdfs:label "Quality Control"@en ;
    skos:definition "Operational activities that verify that products and services meet quality requirements"@en .
:QualityAssurance a owl:Class ; rdfs:subClassOf :QualityManagement ; rdfs:label "Quality Assurance"@en ;
    skos:definition "Process-focused activities that prevent quality issues"@en .

#################################################################
# Customer Management, CRM, Experience
#################################################################

:CustomerManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Customer Management"@en ;
    skos:definition "Management of customer interactions, relationships and experiences"@en .
:CustomerCategorization a owl:Class ; rdfs:subClassOf :CustomerManagement ; rdfs:label "Customer Categorization"@en ;
    skos:definition "Classification of customers based on characteristics, behavior or value"@en .
:CustomerSegment a owl:Class ; rdfs:subClassOf :CustomerCategorization ; rdfs:label "Customer Segment"@en ;
    skos:definition "A group of customers who share similar characteristics, needs or behaviors"@en .
:CRM a owl:Class ; rdfs:subClassOf :CustomerManagement ; rdfs:label "Customer Relationship Management"@en ;
    skos:altLabel "CRM"@en ;
    skos:definition "Technology and processes used to manage customer interactions and relationships"@en .
:CustomerExperience a owl:Class ; rdfs:subClassOf :CustomerManagement ; rdfs:label "Customer Experience"@en ;
    skos:definition "The complete set of interactions and perceptions a customer has with the organization"@en .
:CustomerJourney a owl:Class ; rdfs:subClassOf :CustomerExperience ; rdfs:label "Customer Journey"@en ;
    skos:definition "The sequence of experiences a customer has across all touchpoints"@en .
:Touchpoint a owl:Class ; rdfs:subClassOf :CustomerExperience ; rdfs:label "Touchpoint"@en ;
    skos:definition "Any point of contact between a customer and the organization"@en .

#################################################################
# Channels, Financial, Inventory, Marketing
#################################################################

:ChannelManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Channel Management"@en ;
    skos:definition "Management of the channels through which products and services reach customers"@en .
:Channel a owl:Class ; rdfs:subClassOf :ChannelManagement ; rdfs:label "Channel"@en ;
    skos:definition "A medium or pathway through which products, services or information reach customers"@en .
:SalesChannel a owl:Class ; rdfs:subClassOf :Channel ; rdfs:label "Sales Channel"@en .
:DistributionChannel a owl:Class ; rdfs:subClassOf :Channel ; rdfs:label "Distribution Channel"@en .
:DigitalChannel a owl:Class ; rdfs:subClassOf :Channel ; rdfs:label "Digital Channel"@en .

:FinancialManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Financial Management"@en ;
    skos:definition "Management of financial resources, costs and pricing strategies"@en .
:CostManagement a owl:Class ; rdfs:subClassOf :FinancialManagement ; rdfs:label "Cost Management"@en .
:Cost a owl:Class ; rdfs:subClassOf :CostManagement ; rdfs:label "Cost"@en ;
    skos:definition "An amount of money spent to acquire or maintain something"@en .
:PricingManagement a owl:Class ; rdfs:subClassOf :FinancialManagement ; rdfs:label "Pricing Management"@en .
:PricingModel a owl:Class ; rdfs:subClassOf :PricingManagement ; rdfs:label "Pricing Model"@en ;
    skos:definition "A structured approach for setting prices"@en .
:DiscountingManagement a owl:Class ; rdfs:subClassOf :FinancialManagement ; rdfs:label "Discounting Management"@en .
:Discount a owl:Class ; rdfs:subClassOf :DiscountingManagement ; rdfs:label "Discount"@en ;
    skos:definition "A reduction in the regular price of a product or service"@en .

:InventoryManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Inventory Management"@en ;
    skos:definition "Oversight of inventory levels, stock control and supply chain coordination"@en .
:StockManagement a owl:Class ; rdfs:subClassOf :InventoryManagement ; rdfs:label "Stock Management"@en .
:Inventory a owl:Class ; rdfs:subClassOf :InventoryManagement ; rdfs:label "Inventory"@en ;
    skos:definition "The quantity of goods and materials held in stock by a business"@en .
:StockLevel a owl:Class ; rdfs:subClassOf :StockManagement ; rdfs:label "Stock Level"@en ;
    skos:definition "The current quantity of a particular item held in inventory"@en .

:MarketingManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Marketing Management"@en .
:CampaignManagement a owl:Class ; rdfs:subClassOf :MarketingManagement ; rdfs:label "Campaign Management"@en .
:MarketingCampaign a owl:Class ; rdfs:subClassOf :CampaignManagement ; rdfs:label "Marketing Campaign"@en ;
    skos:definition "A coordinated series of marketing activities designed to achieve specific objectives"@en .
:PromotionalCampaign a owl:Class ; rdfs:subClassOf :MarketingCampaign ; rdfs:label "Promotional Campaign"@en ;
    skos:definition "A campaign designed to promote special offers, discounts or incentives"@en .

#################################################################
# Organization, Human Resources, Agility
#################################################################

:OrganizationalManagement a owl:Class ; rdfs:subClassOf :BusinessContext ; rdfs:label "Organizational Management"@en .
:OrganizationalStructure a owl:Class ; rdfs:subClassOf :OrganizationalManagement ; rdfs:label "Organizational Structure"@en ;
    skos:definition "The formal framework of roles, responsibilities and reporting relationships within an organization"@en .
:OrganizationalHierarchy a owl:Class ; rdfs:subClassOf :OrganizationalStructure ; rdfs:label "Organizational Hierarchy"@en ;
    skos:definition "The vertical structure of authority levels and reporting relationships"@en .
:OrganizationalUnit a owl:Class ; rdfs:subClassOf :OrganizationalStructure ; rdfs:label "Organizational Unit"@en .
:Department a owl:Class ; rdfs:subClassOf :OrganizationalUnit ; rdfs:label "Department"@en .
:Team a owl:Class ; rdfs:subClassOf :OrganizationalUnit ; rdfs:label "Team"@en .
:HumanResourceManagement a owl:Class ; rdfs:subClassOf :OrganizationalManagement ; rdfs:label "Human Resource Management"@en ;
    skos:altLabel "HRM"@en ;
    skos:definition "Management of human capital, including recruitment, development, performance and retention"@en .
:Employee a owl:Class ; rdfs:subClassOf :Stakeholder ; rdfs:label "Employee"@en .
:Position a owl:Class ; rdfs:subClassOf :HumanResourceManagement ; rdfs:label "Position"@en ;
    skos:definition "A specific job with defined responsibilities and requirements"@en .
:AgilityManagement a owl:Class ; rdfs:subClassOf :OrganizationalManagement ; rdfs:label "Agility Management"@en .
:OrganizationalAgility a owl:Class ; rdfs:subClassOf :AgilityManagement ; rdfs:label "Organizational Agility"@en ;
    skos:definition "The capability of an organization to rapidly adapt and respond to market changes and opportunities"@en .
:AgileMethodology a owl:Class ; rdfs:subClassOf :AgilityManagement ; rdfs:label "Agile Methodology"@en ;
    skos:definition "Methodologies that promote adaptive planning, evolutionary development and continuous improvement"@en ;
    skos:example "Scrum, Kanban, Lean, SAFe, Extreme Programming"@en .

