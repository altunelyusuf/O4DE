# PART XXI: AXIOMS AND CONSTRAINTS (ENHANCED)
#################################################################

# Process must have at least one Operation
de:Process rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasOperation ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Operation belongs to exactly one Process
de:Operation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:operationOf ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

# Organization must have maturity level
de:Organization rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasMaturityLevel ;
    owl:cardinality 1
] .

# Organization must be in lifecycle phase
de:Organization rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:inLifecyclePhase ;
    owl:cardinality 1
] .

# Asset must have lifecycle stage
de:DomainAsset rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasLifecycleStage ;
    owl:cardinality 1
] .

# FeatureModel must have at least one feature
de:FeatureModel rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasFeature ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# VariationPoint must have at least two variants
de:VariationPoint rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasVariant ;
    owl:minCardinality "2"^^xsd:nonNegativeInteger
] .

# WorkItem must have at least one Accountable role
de:WorkItem rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasResponsibilityAssignment ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# FIXED: Digital Twin must represent at least one physical asset (not exactly one)
de:DigitalTwin rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:digitalTwinOf ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# Requirement must have priority
de:Requirement rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasPriority ;
    owl:cardinality 1
] .

# Requirement must have status
de:Requirement rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasRequirementStatus ;
    owl:cardinality 1
] .

# DataEntity must have at least one attribute
de:DataEntity rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasAttribute ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# ApplicationSystem must have at least one component
de:ApplicationSystem rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasComponent ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

# PhysicalAsset must have condition
de:PhysicalAsset rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasCondition ;
    owl:cardinality 1
] .

# Process types are mutually exclusive
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:CoreBusinessProcess de:SupportingProcess de:ManagementProcess )
] .

# Work hierarchy levels are distinct
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:Process de:Operation de:Activity de:Task )
] .

# Asset lifecycle stages are mutually exclusive
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:InDevelopment de:UnderReview de:Released de:Deprecated de:Retired )
] .

# Feature types are mutually exclusive
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:MandatoryFeature de:OptionalFeature de:AlternativeFeature )
] .

# RACI types are mutually exclusive
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:Responsible de:Accountable de:Consulted de:Informed )
] .

# Ownership types are distinct
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:PrivateCompany de:PublicCompany de:GovernmentEntity 
                de:NonProfit de:Community de:Cooperative )
] .

# Requirement status progression
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:DraftRequirement de:ProposedRequirement de:ApprovedRequirement 
                de:ImplementedRequirement de:VerifiedRequirement )
] .

# Requirement priority levels are exclusive
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:MustHavePriority de:ShouldHavePriority 
                de:CouldHavePriority de:WontHavePriority )
] .

# Asset types are disjoint
[ rdf:type owl:AllDisjointClasses ;
  owl:members ( de:DomainAsset de:PhysicalAsset )
] .

#################################################################
# PART XXII: INSTANCE EXAMPLES (Fashion Retail Case)
#################################################################

# Organization Instance
de:GlobalFashionRetailCorp rdf:type de:Organization ;
    de:hasName "Global Fashion Retail Corporation"@en ;
    de:hasDescription "International fashion retail company"@en ;
    de:hasOrganizationSize de:MultinationalOrganization ;
    de:hasOwnershipType de:PublicCompany ;
    de:hasOperationalCharacteristic de:GloballyDistributed, de:Operations24x7 ;
    de:hasGeographicScope de:GlobalScope ;
    de:inLifecyclePhase de:MaturityAndOptimization ;
    de:hasMaturityLevel de:DefinedMaturity ;
    de:foundedDate "1995-03-15"^^xsd:date ;
    de:employeeCount 45000 ;
    de:annualRevenue 8500000000.00 .

# Domain Instance
de:FashionRetailOperations rdf:type de:Domain ;
    de:hasName "Fashion Retail Operations"@en ;
    de:hasDescription "Complete fashion retail business domain"@en ;
    de:hasDomainType de:FashionRetailDomain ;
    de:hasDomainMaturity de:MatureDomain .

# Sub-Domains
de:MerchandisePlanning rdf:type de:SubDomain ;
    de:hasName "Merchandise Planning"@en ;
    de:subDomainOf de:FashionRetailOperations .

de:SupplyChainManagement rdf:type de:SubDomain ;
    de:hasName "Supply Chain Management"@en ;
    de:subDomainOf de:FashionRetailOperations .

de:OmnichannelSales rdf:type de:SubDomain ;
    de:hasName "Omnichannel Sales"@en ;
    de:subDomainOf de:FashionRetailOperations .

# Business Capability Instance
de:InventoryManagementCapability rdf:type de:CoreCapability ;
    de:hasName "Inventory Management"@en ;
    de:hasDescription "Real-time inventory tracking across all channels"@en ;
    de:capabilityOf de:GlobalFashionRetailCorp .

# Process Instance
de:OrderFulfillmentProcess rdf:type de:CoreBusinessProcess ;
    de:hasName "Order Fulfillment"@en ;
    de:hasDescription "End-to-end order processing from placement to delivery"@en ;
    de:realizesCapability de:InventoryManagementCapability ;
    de:cycleTime "P2D"^^xsd:duration ;
    de:leadTime "P5D"^^xsd:duration ;
    de:throughput 15000.0 .

# Operations within Process
de:OrderValidation rdf:type de:Operation ;
    de:hasName "Order Validation"@en ;
    de:operationOf de:OrderFulfillmentProcess .

de:InventoryReservation rdf:type de:Operation ;
    de:hasName "Inventory Reservation"@en ;
    de:operationOf de:OrderFulfillmentProcess .

de:WarehousePicking rdf:type de:Operation ;
    de:hasName "Warehouse Picking"@en ;
    de:operationOf de:OrderFulfillmentProcess .

de:ShippingExecution rdf:type de:Operation ;
    de:hasName "Shipping Execution"@en ;
    de:operationOf de:OrderFulfillmentProcess .

# Physical Asset Instance
de:LondonDistributionCenter rdf:type de:Warehouse ;
    de:hasName "London Distribution Center"@en ;
    de:physicalAssetOf de:GlobalFashionRetailCorp ;
    de:hasCondition de:ExcellentCondition ;
    de:acquisitionCost 25000000.00 ;
    de:currentValue 28000000.00 .

de:NYCFlagshipStore rdf:type de:Store ;
    de:hasName "NYC Fifth Avenue Flagship"@en ;
    de:physicalAssetOf de:GlobalFashionRetailCorp ;
    de:hasCondition de:GoodCondition .

# Application System Instance
de:ERPSystem rdf:type de:ApplicationSystem ;
    de:hasName "Enterprise ERP System"@en ;
    de:supportsProcess de:OrderFulfillmentProcess ;
    de:supportsCapability de:InventoryManagementCapability ;
    de:applicationSystemOf de:FashionRetailOperations .

de:WarehouseManagementSystem rdf:type de:ApplicationSystem ;
    de:hasName "WMS"@en ;
    de:supportsProcess de:OrderFulfillmentProcess ;
    de:monitorsAsset de:LondonDistributionCenter ;
    de:integratesWith de:ERPSystem .

# Data Entity Instance
de:ProductCatalog rdf:type de:DataEntity ;
    de:hasName "Product Catalog"@en ;
    de:dataEntityOf de:FashionRetailOperations ;
    de:hasDataClassification de:MasterData ;
    de:dataManagedBy de:ERPSystem .

de:SKU rdf:type de:DataAttribute ;
    de:hasName "SKU"@en ;
    de:attributeOf de:ProductCatalog .

de:Price rdf:type de:DataAttribute ;
    de:hasName "Price"@en ;
    de:attributeOf de:ProductCatalog .

de:InventoryLevel rdf:type de:DataAttribute ;
    de:hasName "Inventory Level"@en ;
    de:attributeOf de:ProductCatalog .

# Requirement Instance
de:RealTimeInventoryRequirement rdf:type de:FunctionalRequirement ;
    de:hasName "Real-Time Inventory Visibility"@en ;
    de:hasDescription "System must show inventory across all locations in real-time"@en ;
    de:hasPriority de:MustHavePriority ;
    de:hasRequirementStatus de:ImplementedRequirement ;
    de:requirementOf de:WarehouseManagementSystem ;
    de:realizedBy de:InventoryTrackingComponent .

# Domain Asset Instance
de:InventoryTrackingComponent rdf:type de:Component ;
    de:hasName "Inventory Tracking Component"@en ;
    de:domainAssetOf de:FashionRetailOperations ;
    de:hasLifecycleStage de:Released ;
    de:isReusable true ;
    de:reuseCount 12 ;
    de:creationDate "2022-06-01"^^xsd:date .

# Person & Role Instance
de:JohnDoe rdf:type de:Person ;
    de:hasName "John Doe"@en ;
    de:memberOf de:GlobalFashionRetailCorp ;
    de:hasRole de:SupplyChainDirector .

de:SupplyChainDirector rdf:type de:Role ;
    de:hasName "Supply Chain Director"@en ;
    de:accountableFor de:OrderFulfillmentProcess .

# Automation Candidate Instance
de:AutomateInventoryReplenishment rdf:type de:AutomationCandidate ;
    de:hasName "Automated Inventory Replenishment"@en ;
    de:automationCandidateOf de:InventoryReservation ;
    de:usesAutomationTechnique de:WorkflowAutomation ;
    de:automationReadiness 85.0 ;
    de:hasAutomationBenefit de:ReplenishmentTimeSaving .

de:ReplenishmentTimeSaving rdf:type de:TimeSaving ;
    de:timeSavings "PT40H"^^xsd:duration ;
    de:costSavings 125000.00 .

# Process Optimization Instance
de:WarehousePickingOptimization rdf:type de:ProcessImprovement ;
    de:hasName "Optimize Warehouse Picking Routes"@en ;
    de:usesMethodology de:LeanMethodology .

de:OrderProcessingBottleneck rdf:type de:Bottleneck ;
    de:hasName "Manual order validation bottleneck"@en .

# Change Request Instance
de:MigrateToCloudWMS rdf:type de:ChangeRequest ;
    de:hasName "Migrate WMS to Cloud"@en ;
    de:hasChangeImpact de:WMSMigrationImpact .

de:WMSMigrationImpact rdf:type de:ChangeImpact ;
    de:hasDescription "Requires 3-month transition, impacts all warehouse operations"@en .

