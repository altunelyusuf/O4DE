#################################################################
# PART V: WORK STRUCTURE (FIXED HIERARCHY)
#################################################################

# FIXED: Clear 4-level hierarchy, Activity is root
de:WorkItem rdf:type owl:Class ;
    rdfs:label "Work Item"@en ;
    skos:definition "Root class for all work units."@en .

# Level 1: Process
de:Process rdf:type owl:Class ;
    rdfs:subClassOf de:WorkItem ;
    rdfs:label "Process"@en ;
    skos:definition "End-to-end set of operations with defined objective."@en .

