#================================================================
# COMPREHENSIVE AXIOMS AND CONSTRAINTS (100+)
#================================================================

# Core Process Constraints (10)
de:Process rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:hasOperation ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

de:Operation rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:operationOf ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

de:Activity rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:activityOf ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

de:Task rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:taskOf ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

de:CoreBusinessProcess rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty de:realizesCapability ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

de:Process rdfs:subClassOf [
