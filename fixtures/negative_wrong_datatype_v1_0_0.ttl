# EXPECT: must have the datatype
# A team whose size is given as text instead of an integer.
@prefix o4de: <http://www.zt4swe.io/o4de#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
o4de:BadTeam a owl:NamedIndividual, o4de:Team ; rdfs:label "Bad team" ; o4de:teamSize "ten" .
