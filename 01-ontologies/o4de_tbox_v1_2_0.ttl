    skos:definition "The organizational lifecycle phase in which an organization increases its size, market and capabilities."@en .

o4de:GrowthStageOrganization a owl:Class ;
    rdfs:label "Growth Stage Organization"@en ;
    rdfs:seeAlso de52:GrowthStageOrganization ;
    rdfs:subClassOf o4de:OrganizationAge ;
