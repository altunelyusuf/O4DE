# Role: T-Box. Classes, properties and axioms only; no individuals.

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix de52: <http://domainengineering.org/ontology#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix o4de: <http://www.zt4swe.io/o4de#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://ai4se.org/ontology/v4#DomainEngineeringModule> rdfs:label "AI4SE Domain Engineering module, taken over as a module"@en ;
    dc:creator "AI4SE Research Team" ;
    dcterms:created "2025-11-17"^^xsd:date ;
    dcterms:identifier "ai4se-domain-engineering-module" ;
    dcterms:isPartOf <http://www.zt4swe.io/o4de> ;
    rdfs:comment "Provenance of the classes taken over in version 1.2.0 from the Domain Engineering module of the AI4SE ontology package. The received file had a syntax error and was repaired in a copy; the received file is unchanged. The performance claims it carried (accuracy ranges, time savings) were not taken over because nothing in the file supports them."@en ;
    owl:versionInfo "1.0" .

<http://domainengineering.org/ontology> rdfs:label "Domain Engineering Ontology, module of the enterprise domain structure"@en ;
    dc:creator "Domain Engineering Consortium" ;
    dcterms:created "2025-01-09"^^xsd:date ;
    dcterms:identifier "domain-engineering-ontology-v5.2" ;
    dcterms:isPartOf <http://www.zt4swe.io/o4de> ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    rdfs:comment "Provenance of the classes, properties and axioms taken over in version 1.1.0 of this package. The creator and the earlier licence statement are kept as recorded in the received file; the module is licensed with the rest of the package. Every term taken from it links to its original through rdfs:seeAlso."@en ;
    owl:versionInfo "5.2.0" .

o4de:Adaptability a owl:Class ;
    rdfs:label "Adaptability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how easily a system can be changed to suit another environment or need."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:AlternativeSolution a owl:Class ;
    rdfs:label "Alternative Solution"@en ;
    rdfs:subClassOf o4de:VendorSolution ;
    skos:definition "A different technological or methodological approach that can address the same domain requirements"@en .

o4de:BusinessRequirement a owl:Class ;
    rdfs:label "Business Requirement"@en ;
    rdfs:seeAlso de52:BusinessRequirement ;
    rdfs:subClassOf o4de:Requirement ;
    skos:definition "A requirement stated in terms of what the business needs to achieve, not how a system will do it."@en .

o4de:CompetencyQuestionValidation a owl:Class ;
    rdfs:label "Competency Question Validation"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainModelValidation ;
    skos:definition "Validation of a domain model by checking that it can answer its competency questions, for example by running them as SPARQL queries."@en .

o4de:ComplianceRequirement a owl:Class ;
    rdfs:label "Compliance Requirement"@en ;
    rdfs:seeAlso de52:ComplianceRequirement ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:conformsTo ],
        o4de:Requirement ;
    skos:definition "A requirement that arises from a law, regulation, standard or contract."@en .

o4de:ConceptExtraction a owl:Class ;
    rdfs:label "Concept Extraction"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainAnalysisTechnique ;
    skos:definition "The technique of identifying the concepts of a domain in source text, for example by named entity recognition or keyphrase extraction."@en .

o4de:ConceptExtractionPrompt a owl:Class ;
    rdfs:label "Concept Extraction Prompt"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainEngineeringPrompt ;
    skos:definition "A prompt template that asks a language model to extract the concepts of a domain from a text."@en .

o4de:Conceptualization a owl:Class ;
    rdfs:label "Conceptualization"@en ;
    rdfs:seeAlso de52:Conceptualization ;
    rdfs:subClassOf o4de:DevelopmentPhase ;
    skos:definition "Phase of creating conceptual model"@en .

o4de:Configurability a owl:Class ;
    rdfs:label "Configurability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how far a system can be set up for a purpose by choosing among options, without changing its code."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:CustomerServiceDomain a owl:Class ;
    rdfs:label "Customer Service Domain"@en ;
    rdfs:seeAlso de52:CustomerServiceDomain ;
    rdfs:subClassOf o4de:CorporateFunctionDomain ;
    skos:definition "The corporate function domain of supporting customers with enquiries, complaints and aftercare."@en .

o4de:Customisability a owl:Class ;
    rdfs:label "Customisability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how far a system can be made to fit the needs of one customer or user."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:CycleTime a owl:Class ;
    rdfs:label "Cycle Time"@en ;
    rdfs:seeAlso de52:CycleTime ;
    rdfs:subClassOf o4de:ProcessPerformanceMetric ;
    skos:definition "The time a unit of work takes from the start of its processing to its completion, used as a process performance metric."@en .

o4de:DSSA a owl:Class ;
    rdfs:label "Domain-Specific Software Architecture"@en ;
    rdfs:subClassOf o4de:Method ;
    skos:definition "Domain-Specific Software Architecture, a method that defines a reference architecture for a domain."@en .

o4de:DataCollectionActivity a owl:Class ;
    rdfs:label "Data Collection Activity"@en ;
    rdfs:subClassOf o4de:DomainEngineeringActivity ;
    skos:definition "Systematic activity for collecting data, information and knowledge relevant to domain engineering"@en .

o4de:DataExchange a owl:Class ;
    rdfs:label "Data Exchange"@en ;
    rdfs:seeAlso de52:DataExchange ;
    skos:definition "The passing of data between systems or parties, with the format and agreement that govern it."@en .

o4de:DataGovernance a owl:Class ;
    rdfs:label "Data Governance"@en ;
    rdfs:seeAlso de52:DataGovernance ;
    skos:definition "The set of policies, roles and decision rights that control how data is managed and used."@en .

o4de:DataIntegration a owl:Class ;
    rdfs:label "Data Integration"@en ;
    rdfs:seeAlso de52:DataIntegration ;
    skos:definition "The combining of data from different sources into one consistent view."@en .

o4de:DataLineage a owl:Class ;
    rdfs:label "Data Lineage"@en ;
    rdfs:seeAlso de52:DataLineage ;
    skos:definition "The record of where data comes from, how it changes and where it goes."@en .

o4de:DataMigration a owl:Class ;
    rdfs:label "Data Migration"@en ;
    rdfs:seeAlso de52:DataMigration ;
    skos:definition "The movement of data from one system or storage to another, including its conversion."@en .

o4de:DataQualityRule a owl:Class ;
    rdfs:label "Data Quality Rule"@en ;
    rdfs:seeAlso de52:DataQualityRule ;
    skos:definition "A rule that states what makes a data value acceptable, such as completeness, format or range."@en .

o4de:DataRelationship a owl:Class ;
    rdfs:label "Data Relationship"@en ;
    rdfs:seeAlso de52:DataRelationship ;
    skos:definition "A link between two data entities, with its meaning and cardinality."@en .

o4de:DependentElement a owl:Class ;
    rdfs:label "Dependent Element"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationElement ;
    skos:definition "A variation element that can be present in a variant only if another element is present."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:DigitalAssetPortfolio a owl:Class ;
    rdfs:label "Digital Asset Portfolio"@en ;
    rdfs:seeAlso de52:DigitalAssetPortfolio ;
    rdfs:subClassOf o4de:AssetPortfolio ;
    skos:definition "An asset portfolio made up of digital assets such as software, data and models."@en .

o4de:DomainConceptualization a owl:Class ;
    rdfs:label "Domain Conceptualization"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainEngineeringActivity ;
    skos:definition "The activity of forming an abstract understanding of the structure of a domain, what exists in it and how things relate, before any implementation choice is made."@en .

o4de:DomainDeveloper a owl:Class ;
    rdfs:label "Domain Developer"@en ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role responsible for building and testing reusable domain assets."@en .

o4de:DomainKnowledgeGraph a owl:Class ;
    rdfs:label "Domain Knowledge Graph"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainModel ;
    skos:definition "A graph of facts about the individuals of a domain that conforms to a domain ontology and can be queried."@en .

o4de:ErrorReduction a owl:Class ;
    rdfs:label "Error Reduction"@en ;
    rdfs:seeAlso de52:ErrorReduction ;
    rdfs:subClassOf o4de:AutomationBenefit ;
    skos:definition "An automation benefit measured as a fall in the number of errors."@en .

o4de:Evolvability a owl:Class ;
    rdfs:label "Evolvability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how well a system can change over time as its needs change."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:ExclusiveElement a owl:Class ;
    rdfs:label "Exclusive Element"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationElement ;
    skos:definition "A variation element that cannot be present in a variant together with another named element."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:Extensibility a owl:Class ;
    rdfs:label "Extensibility"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how easily new capabilities can be added with little change to what exists."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:FODA a owl:Class ;
    rdfs:label "Feature-Oriented Domain Analysis"@en ;
    rdfs:subClassOf o4de:Method ;
    skos:definition "Feature-Oriented Domain Analysis, a domain analysis method that describes a domain by its features."@en .

o4de:Formalization a owl:Class ;
    rdfs:label "Formalization"@en ;
    rdfs:seeAlso de52:Formalization ;
    rdfs:subClassOf o4de:DevelopmentPhase ;
    skos:definition "Phase of formalizing model in ontology language"@en .

o4de:FunctionalVariation a owl:Class ;
    rdfs:label "Functional Variation"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationKind ;
    skos:definition "Variation in what a component or product does."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:ImpactAnalysis a owl:Class ;
    rdfs:label "Impact Analysis"@en ;
    rdfs:seeAlso de52:ImpactAnalysis ;
    skos:definition "The analysis that traces what a change would affect across assets, processes and systems."@en .

o4de:Implementation a owl:Class ;
    rdfs:label "Implementation"@en ;
    rdfs:seeAlso de52:Implementation ;
    rdfs:subClassOf o4de:DevelopmentPhase ;
    skos:definition "Phase of implementing ontology in OWL/RDF"@en .

o4de:IntegratedAssetPortfolio a owl:Class ;
    rdfs:label "Integrated Asset Portfolio"@en ;
    rdfs:seeAlso de52:IntegratedAssetPortfolio ;
    rdfs:subClassOf o4de:AssetPortfolio ;
    skos:definition "An asset portfolio that joins physical and digital assets under one plan."@en .

o4de:LLMDomainDiscovery a owl:Class ;
    rdfs:label "LLM-Powered Domain Discovery"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainEngineeringProcess ;
    skos:definition "A domain engineering process in which large language models extract domain concepts and relationships from unstructured text and draft an initial domain model for experts to validate."@en .

o4de:LeadTime a owl:Class ;
    rdfs:label "Lead Time"@en ;
    rdfs:seeAlso de52:LeadTime ;
    rdfs:subClassOf o4de:ProcessPerformanceMetric ;
    skos:definition "The time from the request for something to its delivery, used as a process performance metric."@en .

o4de:Maintenance a owl:Class ;
    rdfs:label "Maintenance"@en ;
    rdfs:seeAlso de52:Maintenance ;
    rdfs:subClassOf o4de:DevelopmentPhase ;
    skos:definition "Phase of ongoing maintenance and updates"@en .

o4de:MessageFlow a owl:Class ;
    rdfs:label "Message Flow"@en ;
    rdfs:seeAlso de52:MessageFlow ;
    skos:definition "The movement of messages between parties or systems, with their order and content."@en .

o4de:Modifiability a owl:Class ;
    rdfs:label "Modifiability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how easily a system can be changed."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:MultiAgentDomainEngineering a owl:Class ;
    rdfs:label "Multi-Agent Domain Engineering"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainEngineeringProcess ;
    skos:definition "A domain engineering process in which several specialised language-model agents, for instance one for concepts and one for relationships, work together under coordination."@en .

o4de:NonFunctionalVariation a owl:Class ;
    rdfs:label "Non-Functional Variation"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationKind ;
    skos:definition "Variation in how well a component or product does what it does, such as its performance or security."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:OWLReasoner a owl:Class ;
    rdfs:label "OWL Reasoner"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainEngineeringTool,
        o4de:Reasoner ;
    skos:definition "A reasoner for OWL ontologies, such as HermiT, Pellet, FaCT++ or ELK."@en .

o4de:OptionalElement a owl:Class ;
    rdfs:label "Optional Element"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationElement ;
    skos:definition "A variation element that may be included in a variant or left out of it."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:PerformanceRequirement a owl:Class ;
    rdfs:label "Performance Requirement"@en ;
    rdfs:seeAlso de52:PerformanceRequirement ;
    rdfs:subClassOf o4de:NonFunctionalRequirement ;
    skos:definition "A non-functional requirement that states a target for speed, load or resource use."@en .

o4de:PhysicalAssetPortfolio a owl:Class ;
    rdfs:label "Physical Asset Portfolio"@en ;
    rdfs:seeAlso de52:PhysicalAssetPortfolio ;
    rdfs:subClassOf o4de:AssetPortfolio ;
    skos:definition "An asset portfolio made up of physical assets."@en .

o4de:Portability a owl:Class ;
    rdfs:label "Portability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how easily a system can be moved to another environment."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:ProcessMetric a owl:Class ;
    rdfs:label "Process Metric"@en ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures a property of a process, such as cycle time or defect rate."@en .

o4de:ProcessTime a owl:Class ;
    rdfs:label "Process Time"@en ;
    rdfs:seeAlso de52:ProcessTime ;
    rdfs:subClassOf o4de:ProcessPerformanceMetric ;
    skos:definition "The time spent actually working on a unit of work, excluding waiting, used as a process performance metric."@en .

o4de:ProductFamilyLevelVariation a owl:Class ;
    rdfs:label "Product-Family-Level Variation"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationKind ;
    skos:definition "Variation among the products of a product family, as against variation inside one product."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:ProductLevelVariation a owl:Class ;
    rdfs:label "Product-Level Variation"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationKind ;
    skos:definition "Variation among the individual products, for instance between the variants of one product."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:ProductLineEngineering a owl:Class ;
    rdfs:label "Product Line Engineering"@en ;
    rdfs:subClassOf o4de:Method ;
    skos:definition "A method for building a family of related products from a shared set of domain assets."@en .

o4de:ProductQualityManagement a owl:Class ;
    rdfs:label "Product Quality Management"@en ;
    rdfs:subClassOf o4de:QualityManagement ;
    skos:definition "Management of quality standards, controls and improvements for products"@en .

o4de:RelationshipMapping a owl:Class ;
    rdfs:label "Relationship Mapping"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainAnalysisTechnique ;
    skos:definition "The technique of identifying how the concepts of a domain relate to each other in source text, for example by dependency parsing or relation extraction."@en .

o4de:ReliabilityRequirement a owl:Class ;
    rdfs:label "Reliability Requirement"@en ;
    rdfs:seeAlso de52:ReliabilityRequirement ;
    rdfs:subClassOf o4de:NonFunctionalRequirement ;
    skos:definition "A non-functional requirement that states how dependable a system must be."@en .

o4de:RequirementTraceability a owl:Class ;
    rdfs:label "Requirement Traceability"@en ;
    rdfs:seeAlso de52:RequirementTraceability ;
    skos:definition "The ability to follow a requirement forward to what satisfies it and back to where it came from."@en .

o4de:RequirementsSpecification a owl:Class ;
    rdfs:label "Requirements Specification"@en ;
    rdfs:seeAlso de52:RequirementsSpecification ;
    rdfs:subClassOf o4de:DevelopmentPhase ;
    skos:definition "Phase of gathering and documenting requirements"@en .

o4de:Reusability a owl:Class ;
    rdfs:label "Reusability"@en ;
    rdfs:subClassOf o4de:QualityAttribute ;
    skos:definition "A quality attribute describing how easily an asset can be used again in another product or context."@en .

o4de:ReuseRate a owl:Class ;
    rdfs:label "Reuse Rate"@en ;
    rdfs:seeAlso de52:ReuseRate ;
    rdfs:subClassOf o4de:ReuseMetric ;
    skos:definition "A reuse metric giving the share of a product built from reused assets."@en .

o4de:ScalabilityRequirement a owl:Class ;
    rdfs:label "Scalability Requirement"@en ;
    rdfs:seeAlso de52:ScalabilityRequirement ;
    rdfs:subClassOf o4de:NonFunctionalRequirement ;
    skos:definition "A non-functional requirement that states how much growth a system must handle."@en .

o4de:SecurityRequirement a owl:Class ;
    rdfs:label "Security Requirement"@en ;
    rdfs:seeAlso de52:SecurityRequirement ;
    rdfs:subClassOf o4de:NonFunctionalRequirement ;
    skos:definition "A non-functional requirement that states how a system must be protected."@en .

o4de:Service a owl:Class ;
    rdfs:label "Service"@en ;
    skos:definition "An intangible offering that provides value to customers through activities or benefits"@en .

o4de:ServiceInterface a owl:Class ;
    rdfs:label "Service Interface"@en ;
    rdfs:seeAlso de52:ServiceInterface ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A domain asset that describes how a service is called and what it returns."@en .

o4de:ServicePortfolio a owl:Class ;
    rdfs:label "Service Portfolio"@en ;
    rdfs:subClassOf o4de:PortfolioManagement ;
    skos:definition "A collection of services offered by the organization"@en .

o4de:SingleAgentDomainEngineering a owl:Class ;
    rdfs:label "Single-Agent Domain Engineering"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainEngineeringProcess ;
    skos:definition "A domain engineering process in which one language-model agent carries out the whole analysis, from concept extraction to a draft ontology."@en .

o4de:StakeholderRequirement a owl:Class ;
    rdfs:label "Stakeholder Requirement"@en ;
    rdfs:seeAlso de52:StakeholderRequirement ;
    rdfs:subClassOf o4de:Requirement ;
    skos:definition "A requirement that expresses the need of a particular stakeholder."@en .

o4de:Suitability a owl:Class ;
    rdfs:label "Suitability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how well a system fits a given purpose or context."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:Tailorability a owl:Class ;
    rdfs:label "Tailorability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how far a system can be tailored to specific needs by those who use or maintain it."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:Testing a owl:Class ;
    rdfs:label "Testing"@en ;
    rdfs:seeAlso de52:Testing ;
    rdfs:subClassOf o4de:DevelopmentPhase ;
    skos:definition "Phase of testing and validation"@en .

o4de:Throughput a owl:Class ;
    rdfs:label "Throughput"@en ;
    rdfs:seeAlso de52:Throughput ;
    rdfs:subClassOf o4de:ProcessPerformanceMetric ;
    skos:definition "The number of units of work a process completes in a given period, used as a process performance metric."@en .

o4de:Upgradability a owl:Class ;
    rdfs:label "Upgradability"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how easily a system can be replaced by a newer version."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:UsabilityRequirement a owl:Class ;
    rdfs:label "Usability Requirement"@en ;
    rdfs:seeAlso de52:UsabilityRequirement ;
    rdfs:subClassOf o4de:NonFunctionalRequirement ;
    skos:definition "A non-functional requirement that states how easy a system must be to use."@en .

o4de:VariabilityModel a owl:Class ;
    rdfs:label "Variability Model"@en ;
    rdfs:seeAlso de52:VariabilityModel ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A domain asset that describes the features of a product family and how they may vary."@en .

o4de:VariantAnalysis a owl:Class ;
    rdfs:label "Variant Analysis"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariantGenerationStep ;
    skos:definition "The step of the variant generation process in which the specification is analysed."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VariantApplication a owl:Class ;
    rdfs:label "Variant Application"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariantGenerationStep ;
    skos:definition "The step of the variant generation process in which the transformation is applied."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VariantGenerationProcess a owl:Class ;
    rdfs:label "Variant Generation Process"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:Process ;
    skos:definition "The process by which a variant of a component or product is produced from a description of what is wanted."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VariantSpecification a owl:Class ;
    rdfs:label "Variant Specification"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariantGenerationStep ;
    skos:definition "The step of the variant generation process in which the variant to be produced is specified."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VariantSynthesis a owl:Class ;
    rdfs:label "Variant Synthesis"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariantGenerationStep ;
    skos:definition "The step of the variant generation process in which the variant is put together."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VariantTransformation a owl:Class ;
    rdfs:label "Variant Transformation"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:VariantGenerationStep ;
    skos:definition "The step of the variant generation process in which the analysed specification is transformed towards the variant."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VariationCapacity a owl:Class ;
    rdfs:label "Variation Capacity"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    skos:definition "The extent to which a component, a product or a product family can be varied to give different variants."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VariationCapacityMetric a owl:Class ;
