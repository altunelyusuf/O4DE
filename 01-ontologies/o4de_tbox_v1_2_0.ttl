o4de:InHouseDelivery a owl:Class ;
    rdfs:label "In-House Delivery"@en ;
    rdfs:seeAlso de52:InHouseDelivery ;
    rdfs:subClassOf o4de:ServiceDeliveryModel ;
    skos:definition "A service delivery model in which the organization delivers the service with its own staff and systems."@en .

o4de:Inception a owl:Class ;
    rdfs:label "Inception"@en ;
    rdfs:seeAlso de52:Inception ;
    rdfs:subClassOf o4de:OrganizationalLifecyclePhase ;
    skos:definition "The organizational lifecycle phase in which an organization is started and its purpose is set."@en .

o4de:InformationTechnologyDomain a owl:Class ;
    rdfs:label "Information Technology Domain"@en ;
    rdfs:seeAlso de52:InformationTechnologyDomain ;
    rdfs:subClassOf o4de:CorporateFunctionDomain ;
    skos:definition "The corporate function domain of providing and running an organization's information systems."@en .

o4de:Infrastructure a owl:Class ;
    rdfs:label "Infrastructure"@en ;
    rdfs:seeAlso de52:Infrastructure ;
    rdfs:subClassOf o4de:PhysicalAsset ;
