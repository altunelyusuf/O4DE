o4de:ChangeLog a owl:Class ;
    rdfs:label "Change Log"@en ;
    rdfs:seeAlso de52:ChangeLog ;
    skos:definition "Structured documentation of changes between versions"@en .

o4de:Community a owl:Class ;
    rdfs:label "Community Organization"@en ;
    rdfs:seeAlso de52:Community ;
    rdfs:subClassOf o4de:OwnershipType ;
    skos:definition "An ownership type in which a group of members owns or governs the organization together."@en .

o4de:CommunityOfPractice a owl:Class ;
    rdfs:label "Community of Practice"@en ;
    rdfs:seeAlso de52:CommunityOfPractice ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:communityMember ] ;
    skos:definition "A group of people who share a field of work and learn together by exchanging experience."@en .

o4de:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:seeAlso de52:Component ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A reusable, configurable software building block with defined interfaces"@en .

o4de:CompositionVariability a owl:Class ;
    rdfs:label "Composition Variability"@en ;
    rdfs:seeAlso de52:CompositionVariability ;
    rdfs:subClassOf o4de:VariabilityMechanism ;
    skos:definition "Variability realised by assembling an asset from interchangeable parts."@en .

o4de:Cooperative a owl:Class ;
    rdfs:label "Cooperative"@en ;
    rdfs:seeAlso de52:Cooperative ;
    rdfs:subClassOf o4de:OwnershipType ;
    skos:definition "An ownership type in which the organization is owned and run by its members for their shared benefit."@en .

o4de:CoreCapability a owl:Class ;
    rdfs:label "Core Capability"@en ;
    rdfs:seeAlso de52:CoreCapability ;
    rdfs:subClassOf o4de:BusinessCapability ;
    skos:definition "A business capability that gives the organization its distinctive value and sets it apart from others."@en .

o4de:CorrectiveMaintenance a owl:Class ;
    rdfs:label "Corrective Maintenance"@en ;
    rdfs:seeAlso de52:CorrectiveMaintenance ;
    rdfs:subClassOf o4de:MaintenanceSchedule ;
    skos:definition "A maintenance schedule that repairs an asset after a fault has occurred."@en .

o4de:CriticalCondition a owl:Class ;
    rdfs:label "Critical"@en ;
    rdfs:seeAlso de52:CriticalCondition ;
    rdfs:subClassOf o4de:AssetCondition ;
    skos:definition "An asset condition in which the asset is failing or close to failing and needs immediate action."@en .

o4de:CustomerManagement a owl:Class ;
    rdfs:label "Customer Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Management of customer interactions, relationships and experiences"@en .

o4de:DataSteward a owl:Class ;
    rdfs:label "Data Steward"@en ;
    rdfs:seeAlso de52:DataSteward ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:stewardedBy ],
        o4de:Role ;
    skos:definition "A role responsible for the day-to-day quality and correct use of a set of data."@en .

o4de:DecentralizedGovernance a owl:Class ;
    rdfs:label "Decentralized Governance"@en ;
    rdfs:seeAlso de52:DecentralizedGovernance ;
    rdfs:subClassOf o4de:GovernanceOperatingModel ;
    skos:definition "A governance operating model in which decisions are spread among many independent parties."@en .

o4de:DecisionRight a owl:Class ;
    rdfs:label "Decision Right"@en ;
    rdfs:seeAlso de52:DecisionRight ;
    skos:definition "The entitlement to take, approve, veto or be consulted on a given kind of decision."@en .

o4de:DecisionScope a owl:Class ;
    rdfs:label "Decision Scope"@en ;
    rdfs:seeAlso de52:DecisionScope ;
    skos:definition "The range of matters that a decision right or decision authority covers."@en .

o4de:DefinedMaturity a owl:Class ;
    rdfs:label "Level 3: Defined"@en ;
    rdfs:seeAlso de52:DefinedMaturity ;
    rdfs:subClassOf o4de:MaturityLevel ;
    skos:definition "The maturity level at which an organization's processes are documented, standardized and consistently followed."@en .

o4de:DelegatedVoting a owl:Class ;
    rdfs:label "Delegated Voting"@en ;
    rdfs:seeAlso de52:DelegatedVoting ;
    rdfs:subClassOf o4de:VotingMechanism ;
    skos:definition "A voting mechanism in which members pass their voting power to a representative who votes for them."@en .

o4de:Deprecated a owl:Class ;
    rdfs:label "Deprecated"@en ;
    rdfs:seeAlso de52:Deprecated ;
    rdfs:subClassOf o4de:AssetLifecycleStage ;
    skos:definition "The asset lifecycle stage of an asset that is still available but is no longer recommended and is due to be retired."@en .

o4de:DocumentAnalysisList a owl:Class ;
    rdfs:label "Document Analysis List"@en ;
    rdfs:subClassOf o4de:DataCollectionLog ;
    skos:definition "A record of documents analyzed, analysis methods used and findings obtained"@en .

o4de:DomainAnalysis a owl:Class ;
    rdfs:label "Domain Analysis"@en ;
    rdfs:seeAlso de52:DomainAnalysis ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o4de:precedes ;
            owl:someValuesFrom o4de:DomainDesign ],
        o4de:DevelopmentPhase,
        o4de:DomainEngineeringActivity,
        o4de:DomainEngineeringProcess ;
    skos:definition "Identification and understanding of the problem space: stakeholder needs, constraints, common requirements and variability"@en .

o4de:DomainAnalysisTechnique a owl:Class ;
    rdfs:label "Domain Analysis Technique"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DiscoveryMethod ;
    skos:definition "A technique used in analysing a domain, such as extracting its concepts, mapping its relationships or validating the model built from them."@en .

o4de:DomainEngineeringTool a owl:Class ;
    rdfs:label "Domain Engineering Tool"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:Tool ;
    skos:definition "A tool that supports the work of domain engineering, such as an ontology editor or a reasoner."@en .

o4de:DomainEvolution a owl:Class ;
    rdfs:label "Domain Evolution"@en ;
    rdfs:seeAlso de52:DomainEvolution ;
    rdfs:subClassOf o4de:DomainEngineeringActivity,
        o4de:DomainEngineeringProcess ;
    skos:definition "Change management, versioning and maintenance of domain assets over time"@en .

o4de:DomainSpecificLanguage a owl:Class ;
    rdfs:label "Domain-Specific Language"@en ;
    rdfs:seeAlso de52:DomainSpecificLanguage ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A language with syntax and semantics tailored to expressing solutions in the domain"@en .

o4de:DraftRequirement a owl:Class ;
    rdfs:label "Draft"@en ;
    rdfs:seeAlso de52:DraftRequirement ;
    rdfs:subClassOf o4de:RequirementStatus ;
    skos:definition "The requirement status of a requirement that has been written but not yet reviewed."@en .

o4de:Equipment a owl:Class ;
    rdfs:label "Equipment"@en ;
    rdfs:seeAlso de52:Equipment ;
    rdfs:subClassOf o4de:PhysicalAsset ;
    skos:definition "A physical asset used to carry out work, such as a machine or a tool."@en .

o4de:ExcellentCondition a owl:Class ;
    rdfs:label "Excellent"@en ;
    rdfs:seeAlso de52:ExcellentCondition ;
    rdfs:subClassOf o4de:AssetCondition ;
    skos:definition "An asset condition in which the asset is like new and needs only routine care."@en .

o4de:FairCondition a owl:Class ;
    rdfs:label "Fair"@en ;
    rdfs:seeAlso de52:FairCondition ;
    rdfs:subClassOf o4de:AssetCondition ;
    skos:definition "An asset condition in which the asset works but shows wear and needs attention."@en .

o4de:FederatedGovernance a owl:Class ;
    rdfs:label "Federated Governance"@en ;
    rdfs:seeAlso de52:FederatedGovernance ;
    rdfs:subClassOf o4de:GovernanceOperatingModel ;
    skos:definition "A governance operating model in which a central body sets common rules while member units decide locally within them."@en .

o4de:FinancialManagement a owl:Class ;
    rdfs:label "Financial Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Management of financial resources, costs and pricing strategies"@en .

o4de:Framework a owl:Class ;
    rdfs:label "Framework"@en ;
    rdfs:seeAlso de52:Framework ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A reusable skeleton of cooperating components with extension points for a domain"@en .

o4de:GoodCondition a owl:Class ;
    rdfs:label "Good"@en ;
    rdfs:seeAlso de52:GoodCondition ;
    rdfs:subClassOf o4de:AssetCondition ;
    skos:definition "An asset condition in which the asset works well with only minor wear."@en .

o4de:GovernmentEntity a owl:Class ;
    rdfs:label "Government Entity"@en ;
    rdfs:seeAlso de52:GovernmentEntity ;
    rdfs:subClassOf o4de:OwnershipType ;
    skos:definition "An ownership type in which the organization is owned by a government."@en .

o4de:HealthcareDomain a owl:Class ;
    rdfs:label "Healthcare Domain"@en ;
    rdfs:seeAlso de52:HealthcareDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of preventing, diagnosing and treating illness and promoting health."@en .

o4de:ImplementedRequirement a owl:Class ;
    rdfs:label "Implemented"@en ;
    rdfs:seeAlso de52:ImplementedRequirement ;
    rdfs:subClassOf o4de:RequirementStatus ;
    skos:definition "The requirement status of a requirement that has been built and delivered."@en .

o4de:InDevelopment a owl:Class ;
    rdfs:label "In Development"@en ;
    rdfs:seeAlso de52:InDevelopment ;
    rdfs:subClassOf o4de:AssetLifecycleStage ;
    skos:definition "The asset lifecycle stage of an asset that is being built and is not yet released."@en .

o4de:InformationFlow a owl:Class ;
    rdfs:label "Information Flow"@en ;
    rdfs:seeAlso de52:InformationFlow ;
    skos:definition "The movement of information from one party or system to another, with its content and purpose."@en .

o4de:InheritanceVariability a owl:Class ;
    rdfs:label "Inheritance Variability"@en ;
    rdfs:seeAlso de52:InheritanceVariability ;
    rdfs:subClassOf o4de:VariabilityMechanism ;
    skos:definition "Variability realised by specialising an asset through inheritance."@en .

o4de:InitialMaturity a owl:Class ;
    rdfs:label "Level 1: Initial"@en ;
    rdfs:seeAlso de52:InitialMaturity ;
    rdfs:subClassOf o4de:MaturityLevel ;
    skos:definition "The maturity level at which processes are ad hoc and depend on individual effort."@en .

o4de:IntegrationPoint a owl:Class ;
    rdfs:label "Integration Point"@en ;
    rdfs:seeAlso de52:IntegrationPoint ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:mapsData ] ;
    skos:definition "A place where two systems or components connect and exchange data or calls."@en .

o4de:InterviewList a owl:Class ;
    rdfs:label "Interview List"@en ;
    rdfs:subClassOf o4de:DataCollectionLog ;
    skos:definition "A list of interviews with stakeholders: participants, topics and outcomes"@en .

o4de:Kaizen a owl:Class ;
    rdfs:label "Kaizen"@en ;
    rdfs:seeAlso de52:Kaizen ;
    rdfs:subClassOf o4de:ProcessOptimizationMethodology ;
    skos:definition "A process optimization methodology of continuous, small improvements made by the people who do the work."@en .

o4de:LeanMethodology a owl:Class ;
    rdfs:label "Lean Methodology"@en ;
    rdfs:seeAlso de52:LeanMethodology ;
    rdfs:subClassOf o4de:ProcessOptimizationMethodology ;
    skos:definition "A process optimization methodology that removes waste and concentrates effort on what the customer values."@en .

o4de:LegacyOrganization a owl:Class ;
    rdfs:label "Legacy Organization"@en ;
    rdfs:seeAlso de52:LegacyOrganization ;
    rdfs:subClassOf o4de:OrganizationAge ;
    skos:definition "An organization age class for an organization that is 15 years old or more."@en .

o4de:LifecycleTransitionTrigger a owl:Class ;
    rdfs:label "Lifecycle Transition Trigger"@en ;
    rdfs:seeAlso de52:LifecycleTransitionTrigger ;
    skos:definition "An event or condition that moves an organization from one lifecycle phase to the next."@en .

o4de:ManagedMaturity a owl:Class ;
    rdfs:label "Level 2: Managed"@en ;
    rdfs:seeAlso de52:ManagedMaturity ;
    rdfs:subClassOf o4de:MaturityLevel ;
    skos:definition "The maturity level at which processes are measured and controlled against set targets."@en .

o4de:ManagementProcess a owl:Class ;
    rdfs:label "Management Process"@en ;
    rdfs:seeAlso de52:ManagementProcess ;
    rdfs:subClassOf o4de:BusinessProcess ;
    skos:definition "A business process that plans, directs and controls other processes."@en .

o4de:MandatoryFeature a owl:Class ;
    rdfs:label "Mandatory Feature"@en ;
    rdfs:seeAlso de52:MandatoryFeature ;
    rdfs:subClassOf o4de:Feature ;
    skos:definition "A feature that every product of the domain must include."@en .

o4de:MediaEntertainmentDomain a owl:Class ;
    rdfs:label "Media & Entertainment Domain"@en ;
    rdfs:seeAlso de52:MediaEntertainmentDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of producing and distributing media and entertainment."@en .

o4de:MessageBus a owl:Class ;
    rdfs:label "Message Bus"@en ;
    rdfs:seeAlso de52:MessageBus ;
    rdfs:subClassOf o4de:IntegrationPattern ;
    skos:definition "An integration pattern in which systems exchange messages through a shared channel."@en .

o4de:Microservices a owl:Class ;
    rdfs:label "Microservices"@en ;
    rdfs:seeAlso de52:Microservices ;
    rdfs:subClassOf o4de:IntegrationPattern ;
    skos:definition "An integration pattern in which an application is built from small services that run and change independently."@en .

o4de:OperationalDecision a owl:Class ;
    rdfs:label "Operational Decision"@en ;
    rdfs:seeAlso de52:OperationalDecision ;
    rdfs:subClassOf o4de:DecisionScope ;
    skos:definition "A decision scope of day-to-day matters within a process or team."@en .

o4de:OperationalEnvironment a owl:Class ;
    rdfs:label "Operational Environment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 100.0 ] ) ] ;
            owl:onProperty o4de:utilizationRate ],
        o4de:OperationsManagement ;
    skos:definition "The physical, technological and organizational context in which operations take place"@en .

o4de:OptimizationOpportunity a owl:Class ;
    rdfs:label "Optimization Opportunity"@en ;
    rdfs:seeAlso de52:OptimizationOpportunity ;
    skos:definition "A place in a process where a change could improve time, cost or quality."@en .

o4de:OptimizingMaturity a owl:Class ;
    rdfs:label "Level 5: Optimizing"@en ;
    rdfs:seeAlso de52:OptimizingMaturity ;
    rdfs:subClassOf o4de:MaturityLevel ;
    skos:definition "The maturity level at which an organization continually improves its processes using what it measures."@en .

o4de:OptionalFeature a owl:Class ;
    rdfs:label "Optional Feature"@en ;
    rdfs:seeAlso de52:OptionalFeature ;
    rdfs:subClassOf o4de:Feature ;
    skos:definition "A feature that a product of the domain may include or leave out."@en .

o4de:OrganizationalManagement a owl:Class ;
    rdfs:label "Organizational Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "The management activity that designs and runs the structure and people of an organization."@en .

o4de:OrganizationalStructure a owl:Class ;
    rdfs:label "Organizational Structure"@en ;
    rdfs:subClassOf o4de:OrganizationalManagement ;
    skos:definition "The formal framework of roles, responsibilities and reporting relationships within an organization"@en .

o4de:ParameterVariability a owl:Class ;
    rdfs:label "Parameter Variability"@en ;
    rdfs:seeAlso de52:ParameterVariability ;
    rdfs:subClassOf o4de:VariabilityMechanism ;
    skos:definition "Variability realised by setting a parameter value on an otherwise unchanged asset."@en .

o4de:PhysicalDataModel a owl:Class ;
    rdfs:label "Physical Data Model"@en ;
    rdfs:seeAlso de52:PhysicalDataModel ;
    rdfs:subClassOf o4de:DataModel ;
    skos:definition "A data model that describes how data is stored in a particular database or system."@en .

o4de:PointToPoint a owl:Class ;
    rdfs:label "Point-to-Point"@en ;
    rdfs:seeAlso de52:PointToPoint ;
    rdfs:subClassOf o4de:IntegrationPattern ;
    skos:definition "An integration pattern in which two systems are connected directly to each other."@en .

o4de:Policy a owl:Class ;
    rdfs:label "Policy"@en ;
    rdfs:seeAlso de52:Policy ;
    skos:definition "A statement of intent that directs how an organization acts, approved by those with authority."@en .

o4de:PoorCondition a owl:Class ;
    rdfs:label "Poor"@en ;
    rdfs:seeAlso de52:PoorCondition ;
    rdfs:subClassOf o4de:AssetCondition ;
    skos:definition "An asset condition in which the asset is worn or faulty and needs repair or replacement soon."@en .

o4de:Position a owl:Class ;
    rdfs:label "Position"@en ;
    rdfs:subClassOf o4de:HumanResourceManagement ;
    skos:definition "A specific job with defined responsibilities and requirements"@en .

o4de:PredictiveMaintenance a owl:Class ;
    rdfs:label "Predictive Maintenance"@en ;
    rdfs:seeAlso de52:PredictiveMaintenance ;
    rdfs:subClassOf o4de:MaintenanceSchedule ;
    skos:definition "A maintenance schedule that services an asset when data suggests a failure is approaching."@en .

o4de:PreventiveMaintenance a owl:Class ;
    rdfs:label "Preventive Maintenance"@en ;
    rdfs:seeAlso de52:PreventiveMaintenance ;
    rdfs:subClassOf o4de:MaintenanceSchedule ;
    skos:definition "A maintenance schedule that services an asset at set intervals to prevent failure."@en .

o4de:PrivateCompany a owl:Class ;
    rdfs:label "Private Company"@en ;
    rdfs:seeAlso de52:PrivateCompany ;
    rdfs:subClassOf o4de:OwnershipType ;
    skos:definition "An ownership type in which shares are held privately and are not traded on a public market."@en .

o4de:ProcessInput a owl:Class ;
    rdfs:label "Process Input"@en ;
    skos:definition "Any material, information, resource or trigger consumed or used by a business process"@en .

o4de:ProcessOutput a owl:Class ;
    rdfs:label "Process Output"@en ;
    skos:definition "Any product, service, information or result produced by a business process"@en .

o4de:ProductFamily a owl:Class ;
    rdfs:label "Product Family"@en ;
    rdfs:seeAlso de52:ProductFamily ;
    skos:definition "A set of related products that share a common base and differ in defined ways."@en .

o4de:ProofOfAuthority a owl:Class ;
    rdfs:label "Proof of Authority"@en ;
    rdfs:seeAlso de52:ProofOfAuthority ;
    rdfs:subClassOf o4de:ConsensusProtocol ;
    skos:definition "A consensus protocol in which approved identities validate the records."@en .

o4de:ProofOfStake a owl:Class ;
    rdfs:label "Proof of Stake"@en ;
    rdfs:seeAlso de52:ProofOfStake ;
    rdfs:subClassOf o4de:ConsensusProtocol ;
    skos:definition "A consensus protocol in which validators are chosen according to the value they have put at stake."@en .

o4de:ProofOfWork a owl:Class ;
    rdfs:label "Proof of Work"@en ;
    rdfs:seeAlso de52:ProofOfWork ;
    rdfs:subClassOf o4de:ConsensusProtocol ;
    skos:definition "A consensus protocol in which validators earn the right to add records by solving a costly computation."@en .

o4de:ProposedRequirement a owl:Class ;
    rdfs:label "Proposed"@en ;
    rdfs:seeAlso de52:ProposedRequirement ;
    rdfs:subClassOf o4de:RequirementStatus ;
    skos:definition "The requirement status of a requirement that has been put forward and awaits review."@en .

o4de:PublicCompany a owl:Class ;
    rdfs:label "Public Company"@en ;
    rdfs:seeAlso de52:PublicCompany ;
    rdfs:subClassOf o4de:OwnershipType ;
    skos:definition "An ownership type in which shares are offered for trade on a public market."@en .

o4de:QuadraticVoting a owl:Class ;
    rdfs:label "Quadratic Voting"@en ;
    rdfs:seeAlso de52:QuadraticVoting ;
    rdfs:subClassOf o4de:VotingMechanism ;
    skos:definition "A voting mechanism in which the cost of extra votes rises with their number, so strong preferences count without domination."@en .

o4de:QualityStandard a owl:Class ;
    rdfs:label "Quality Standard"@en ;
    rdfs:seeAlso de52:QualityStandard ;
    rdfs:subClassOf o4de:QualityManagement ;
    skos:definition "Documented criteria used to measure and ensure quality"@en .

o4de:QuantitativelyManagedMaturity a owl:Class ;
    rdfs:label "Level 4: Quantitatively Managed"@en ;
    rdfs:seeAlso de52:QuantitativelyManagedMaturity ;
    rdfs:subClassOf o4de:MaturityLevel ;
    skos:definition "The maturity level at which processes are measured and controlled with statistical methods."@en .

o4de:RealTimeIntegration a owl:Class ;
    rdfs:label "Real-Time Integration"@en ;
    rdfs:seeAlso de52:RealTimeIntegration ;
    skos:definition "An integration pattern in which systems exchange data as events occur, without delay."@en .

o4de:Reasoner a owl:Class ;
    rdfs:label "Reasoner"@en ;
    rdfs:seeAlso de52:Reasoner ;
    rdfs:subClassOf o4de:DomainEngineeringTool ;
    skos:definition "A tool that infers new facts from an ontology and checks it for contradictions."@en .

o4de:ReferenceArchitecture a owl:Class ;
    rdfs:label "Reference Architecture"@en ;
    rdfs:seeAlso de52:ReferenceArchitecture ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "An architectural template capturing the structural and behavioral patterns of systems in the domain"@en .

o4de:Released a owl:Class ;
    rdfs:label "Released"@en ;
    rdfs:seeAlso de52:Released ;
    rdfs:subClassOf o4de:AssetLifecycleStage ;
    skos:definition "The asset lifecycle stage of an asset that has been published for use."@en .

o4de:RequirementConflict a owl:Class ;
    rdfs:label "Requirement Conflict"@en ;
    rdfs:seeAlso de52:RequirementConflict ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:conflictBetween ] ;
    skos:definition "A situation in which two requirements cannot both be satisfied as stated."@en .

o4de:RequirementSource a owl:Class ;
    rdfs:label "Requirement Source"@en ;
    rdfs:seeAlso de52:RequirementSource ;
    skos:definition "The person, document or event from which a requirement originates."@en .

o4de:ResponsibilityAssignment a owl:Class ;
    rdfs:label "Responsibility Assignment"@en ;
    rdfs:seeAlso de52:ResponsibilityAssignment ;
    skos:definition "A statement of who has which responsibility for a work item."@en .

o4de:Retired a owl:Class ;
    rdfs:label "Retired"@en ;
    rdfs:seeAlso de52:Retired ;
    rdfs:subClassOf o4de:AssetLifecycleStage ;
    skos:definition "The asset lifecycle stage of an asset that has been withdrawn from use."@en .

o4de:ReuseMetric a owl:Class ;
    rdfs:label "Reuse Metric"@en ;
    rdfs:seeAlso de52:ReuseMetric ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures how much domain assets are reused, for example reuse rate."@en .

o4de:ServiceOrientedArchitecture a owl:Class ;
    rdfs:label "SOA"@en ;
    rdfs:seeAlso de52:ServiceOrientedArchitecture ;
    rdfs:subClassOf o4de:IntegrationPattern ;
    skos:definition "An integration pattern in which functions are provided as services that other systems call."@en .

o4de:SimpleVoting a owl:Class ;
    rdfs:label "Simple Voting"@en ;
    rdfs:seeAlso de52:SimpleVoting ;
    rdfs:subClassOf o4de:VotingMechanism ;
    skos:definition "A voting mechanism in which each member has one vote and the majority decides."@en .

o4de:SixSigmaMethodology a owl:Class ;
    rdfs:label "Six Sigma Methodology"@en ;
    rdfs:seeAlso de52:SixSigmaMethodology ;
    rdfs:subClassOf o4de:ProcessOptimizationMethodology ;
    skos:definition "A process optimization methodology that reduces variation and defects using statistical measurement."@en .

o4de:SmartContract a owl:Class ;
    rdfs:label "Smart Contract"@en ;
    rdfs:seeAlso de52:SmartContract ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:enforcedBy ] ;
    skos:definition "A program stored on a distributed ledger that carries out the terms of an agreement automatically."@en .

o4de:StrategicDecision a owl:Class ;
    rdfs:label "Strategic Decision"@en ;
    rdfs:seeAlso de52:StrategicDecision ;
    rdfs:subClassOf o4de:DecisionScope ;
    skos:definition "A decision scope of long-term matters that set the direction of the organization."@en .

o4de:SubDomain a owl:Class ;
    rdfs:label "Sub-Domain"@en ;
    rdfs:seeAlso de52:SubDomain ;
    rdfs:subClassOf o4de:Domain ;
    skos:definition "A domain that forms a part of a larger domain."@en .

o4de:Supplier a owl:Class ;
    rdfs:label "Supplier"@en ;
    rdfs:subClassOf o4de:Stakeholder ;
    skos:definition "An organization or individual that provides inputs, materials or services to business processes"@en .

o4de:TacticalDecision a owl:Class ;
    rdfs:label "Tactical Decision"@en ;
    rdfs:seeAlso de52:TacticalDecision ;
    rdfs:subClassOf o4de:DecisionScope ;
    skos:definition "A decision scope of medium-term matters that carry out strategy."@en .

o4de:Task a owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:seeAlso de52:Task ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:taskOf ],
        o4de:WorkItem ;
    skos:definition "Atomic, indivisible unit of work."@en .

o4de:TheoryOfConstraints a owl:Class ;
    rdfs:label "Theory of Constraints"@en ;
    rdfs:seeAlso de52:TheoryOfConstraints ;
    rdfs:subClassOf o4de:ProcessOptimizationMethodology ;
    skos:definition "A process optimization methodology that improves a process by finding and relieving its most limiting constraint."@en .

o4de:Touchpoint a owl:Class ;
    rdfs:label "Touchpoint"@en ;
    rdfs:subClassOf o4de:CustomerExperience ;
    skos:definition "Any point of contact between a customer and the organization"@en .

o4de:UnderReview a owl:Class ;
    rdfs:label "Under Review"@en ;
    rdfs:seeAlso de52:UnderReview ;
    rdfs:subClassOf o4de:AssetLifecycleStage ;
    skos:definition "The asset lifecycle stage of an asset that is being checked before release or further use."@en .

o4de:VariationElement a owl:Class ;
    rdfs:label "Variation Element"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    skos:definition "An element of a component or product whose presence in a variant depends on a choice."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:Vendor a owl:Class ;
    rdfs:label "Vendor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:vendorName ],
        o4de:Stakeholder ;
    skos:definition "A commercial entity that offers products, services or solutions relevant to the domain"@en .

o4de:VerifiedRequirement a owl:Class ;
    rdfs:label "Verified"@en ;
    rdfs:seeAlso de52:VerifiedRequirement ;
    rdfs:subClassOf o4de:RequirementStatus ;
    skos:definition "The requirement status of a requirement whose implementation has been checked against it."@en .

o4de:WontHavePriority a owl:Class ;
    rdfs:label "Won't Have"@en ;
    rdfs:seeAlso de52:WontHavePriority ;
    rdfs:subClassOf o4de:RequirementPriority ;
    skos:definition "The requirement priority for a requirement that is agreed to be left out of the current delivery."@en .

o4de:conformsTo a owl:ObjectProperty ;
    rdfs:label "conformsTo"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range o4de:QualityStandard ;
    rdfs:seeAlso de52:conformsTo ;
    skos:definition "Links a domain asset to a quality standard; the inverse of the relation 'conformstoof'."@en .

o4de:hasAttribute a owl:ObjectProperty ;
    rdfs:label "has attribute"@en ;
    rdfs:domain o4de:DataEntity ;
    rdfs:range o4de:DataAttribute ;
    rdfs:seeAlso de52:hasAttribute ;
    skos:definition "Links a data entity to a data attribute; the inverse of the relation 'attribute of'."@en .

o4de:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:domain o4de:ApplicationSystem ;
    rdfs:range o4de:ApplicationComponent ;
    rdfs:seeAlso de52:hasComponent ;
    skos:definition "Links an application system to an application component; the inverse of the relation 'component of'."@en .

o4de:hasOperation a owl:ObjectProperty ;
    rdfs:label "has operation"@en ;
    rdfs:domain o4de:Process ;
    rdfs:range o4de:Operation ;
    rdfs:seeAlso de52:hasOperation ;
    skos:definition "Links a process to an operation; the inverse of the relation 'operation of'."@en .

o4de:hasSubDomain a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "has sub-domain"@en ;
    rdfs:domain o4de:Domain ;
    rdfs:range o4de:SubDomain ;
    rdfs:seeAlso de52:hasSubDomain ;
    owl:propertyChainAxiom ( o4de:hasSubDomain o4de:hasSubDomain ) ;
    skos:definition "Links a domain to a sub-domain; the inverse of the relation 'sub-domain of'."@en .

o4de:hasVariant a owl:ObjectProperty ;
    rdfs:label "has variant"@en ;
    rdfs:domain o4de:VariationPoint ;
    rdfs:range o4de:Variant ;
    skos:definition "Links a variation point to a variant that can be chosen there."@en .

o4de:AgileActivity a owl:Class ;
    rdfs:label "Agile Activity"@en ;
    rdfs:subClassOf o4de:DomainEngineeringActivity ;
    skos:definition "A domain engineering activity that follows agile principles such as iterative development and continuous feedback"@en .

o4de:Asset a owl:Class ;
    rdfs:label "Asset"@en ;
    rdfs:seeAlso de52:Asset ;
    skos:definition "Valuable resource owned or controlled."@en .

o4de:AssetPortfolio a owl:Class ;
    rdfs:label "Asset Portfolio"@en ;
    rdfs:seeAlso de52:AssetPortfolio ;
    skos:definition "A managed collection of assets that is planned, funded and reviewed as a whole."@en .

o4de:BusinessAnalyst a owl:Class ;
    rdfs:label "Business Analyst"@en ;
    rdfs:seeAlso de52:BusinessAnalyst ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role that studies business needs, elicits requirements and describes processes and rules."@en .

o4de:BusinessDomain a owl:Class ;
    rdfs:label "Business Domain"@en ;
    rdfs:seeAlso de52:BusinessDomain ;
    rdfs:subClassOf o4de:Domain,
        o4de:DomainType ;
    skos:definition "A domain made up of business activity, such as sales or logistics, as opposed to technical work."@en .

o4de:BusinessEvent a owl:Class ;
    rdfs:label "Business Event"@en ;
    rdfs:seeAlso de52:BusinessEvent ;
    skos:definition "Something that happens, inside or outside the organization, to which the business must respond."@en .

o4de:CouldHavePriority a owl:Class ;
    rdfs:label "Could Have"@en ;
    rdfs:seeAlso de52:CouldHavePriority ;
    rdfs:subClassOf o4de:RequirementPriority ;
    skos:definition "The requirement priority for a requirement that would be good to have if time and resources allow."@en .

o4de:CustomerExperience a owl:Class ;
    rdfs:label "Customer Experience"@en ;
    rdfs:subClassOf o4de:CustomerManagement ;
    skos:definition "The complete set of interactions and perceptions a customer has with the organization"@en .

o4de:CustomerSegment a owl:Class ;
    rdfs:label "Customer Segment"@en ;
    rdfs:subClassOf o4de:CustomerCategorization ;
    skos:definition "A group of customers who share similar characteristics, needs or behaviors"@en .

o4de:DataAnalyst a owl:Class ;
    rdfs:label "Data Analyst"@en ;
    rdfs:seeAlso de52:DataAnalyst ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role that examines data to find patterns and answers for the business."@en .

o4de:DataMapping a owl:Class ;
    rdfs:label "Data Mapping"@en ;
    rdfs:seeAlso de52:DataMapping ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:transformsWith ] ;
    skos:definition "A specification of how elements of one data structure correspond to elements of another."@en .

o4de:DataModel a owl:Class ;
    rdfs:label "Data Model"@en ;
    rdfs:seeAlso de52:DataModel ;
    skos:definition "A description of data entities, their attributes and their relationships."@en .

o4de:Discount a owl:Class ;
    rdfs:label "Discount"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 100.0 ] ) ] ;
            owl:onProperty o4de:discountPercentage ],
        o4de:DiscountingManagement ;
    skos:definition "A reduction in the regular price of a product or service"@en .

o4de:DomainDesign a owl:Class ;
    rdfs:label "Domain Design"@en ;
    rdfs:seeAlso de52:DomainDesign ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o4de:precedes ;
            owl:someValuesFrom o4de:DomainImplementation ],
        o4de:DomainEngineeringActivity,
        o4de:DomainEngineeringProcess ;
    skos:definition "Creation of architectural solutions and design patterns for the commonalities and variabilities found in analysis"@en .

o4de:DomainImplementation a owl:Class ;
    rdfs:label "Domain Implementation"@en ;
    rdfs:seeAlso de52:DomainImplementation ;
    rdfs:subClassOf o4de:DomainEngineeringActivity,
        o4de:DomainEngineeringProcess ;
    skos:definition "Development and testing of reusable components, frameworks and domain-specific tools"@en .

o4de:Fleet a owl:Class ;
    rdfs:label "Fleet"@en ;
    rdfs:seeAlso de52:Fleet ;
    skos:definition "A group of vehicles or mobile assets managed together."@en .

o4de:GovernanceToken a owl:Class ;
    rdfs:label "Governance Token"@en ;
    rdfs:seeAlso de52:GovernanceToken ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:governsWithTokens ] ;
    skos:definition "A digital token that gives its holder a right to take part in governance decisions."@en .

o4de:MeetingList a owl:Class ;
    rdfs:label "Meeting List"@en ;
    rdfs:subClassOf o4de:DataCollectionLog ;
    skos:definition "A list of meetings, workshops and collaborative sessions conducted during domain engineering"@en .

o4de:Method a owl:Class ;
    rdfs:label "Method"@en ;
    skos:definition "A systematic technique for carrying out domain engineering activities"@en .

o4de:MustHavePriority a owl:Class ;
    rdfs:label "Must Have"@en ;
    rdfs:seeAlso de52:MustHavePriority ;
    rdfs:subClassOf o4de:RequirementPriority ;
    skos:definition "The requirement priority for a requirement that is essential and cannot be left out."@en .

o4de:NonProfit a owl:Class ;
    rdfs:label "Non-Profit Organization"@en ;
    rdfs:seeAlso de52:NonProfit ;
    rdfs:subClassOf o4de:OwnershipType ;
    skos:definition "An ownership type in which the organization works for a purpose and does not distribute profit to owners."@en .

o4de:OnChainGovernance a owl:Class ;
    rdfs:label "On-Chain Governance"@en ;
    rdfs:seeAlso de52:OnChainGovernance ;
    skos:definition "A governance model in which decisions are made and enforced through a distributed ledger."@en .

o4de:OperationsManagement a owl:Class ;
    rdfs:label "Operations Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Management of day-to-day operational activities and environments"@en .

o4de:Opportunity a owl:Class ;
    rdfs:label "Opportunity"@en ;
    rdfs:subClassOf o4de:StrategicAnalysis ;
    skos:definition "External factors or trends that could provide business opportunities"@en .

o4de:OrganizationAge a owl:Class ;
    rdfs:label "Organization Age"@en ;
    rdfs:seeAlso de52:OrganizationAge ;
    skos:definition "A classification of how long an organization has existed."@en .

o4de:ProblemDescription a owl:Class ;
    rdfs:label "Problem Description"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "Critical" "Major" "Minor" ) ] ;
            owl:onProperty o4de:problemSeverity ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "High" "Medium" "Low" ) ] ;
            owl:onProperty o4de:priorityLevel ],
        o4de:BusinessContext ;
    skos:definition "A structured description of business problems, challenges and opportunities that drive domain engineering efforts"@en .

o4de:ProcessAnalyst a owl:Class ;
    rdfs:label "Process Analyst"@en ;
    rdfs:seeAlso de52:ProcessAnalyst ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role that studies and measures processes in order to describe and improve them."@en .

o4de:ProcessSimulation a owl:Class ;
    rdfs:label "Process Simulation"@en ;
    rdfs:seeAlso de52:ProcessSimulation ;
    skos:definition "A model-based trial of a process to estimate its behaviour under different conditions."@en .

o4de:ProductLine a owl:Class ;
    rdfs:label "Product Line"@en ;
    rdfs:seeAlso de52:ProductLine ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasProductVariant ],
        o4de:ProductFamily ;
    skos:definition "A product family managed as a line of related products under a common plan."@en .

o4de:ProductVariant a owl:Class ;
    rdfs:label "Product Variant"@en ;
    rdfs:seeAlso de52:ProductVariant ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:selectsFeature ],
        o4de:Product ;
    skos:definition "A product that differs from others of its family in selected features."@en .

o4de:ProfessionalServicesDomain a owl:Class ;
    rdfs:label "Professional Services Domain"@en ;
    rdfs:seeAlso de52:ProfessionalServicesDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of expert services sold to clients, such as consulting, legal and accounting."@en .

o4de:Project a owl:Class ;
    rdfs:label "Project"@en ;
    rdfs:seeAlso de52:Project ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:learnsFrom ] ;
    skos:definition "A temporary effort, with a start and an end, that creates a specified result."@en .

o4de:QualityManagement a owl:Class ;
    rdfs:label "Quality Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "A systematic approach to ensuring that products and services meet or exceed requirements through planning, control, assurance and improvement"@en .

o4de:RESTfulAPI a owl:Class ;
    rdfs:label "RESTful API"@en ;
    rdfs:seeAlso de52:RESTfulAPI ;
    skos:definition "REST-based web service API"@en .

o4de:RetailDomain a owl:Class ;
    rdfs:label "Retail Domain"@en ;
    rdfs:seeAlso de52:RetailDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of selling goods to consumers through shops and other channels."@en .

o4de:SPARQLEndpoint a owl:Class ;
    rdfs:label "SPARQL Endpoint"@en ;
    rdfs:seeAlso de52:SPARQLEndpoint ;
    skos:definition "Query interface for SPARQL access"@en .

o4de:ShouldHavePriority a owl:Class ;
    rdfs:label "Should Have"@en ;
    rdfs:seeAlso de52:ShouldHavePriority ;
    rdfs:subClassOf o4de:RequirementPriority ;
    skos:definition "The requirement priority for a requirement that is important but not essential."@en .

o4de:Sprint a owl:Class ;
    rdfs:label "Sprint"@en ;
    rdfs:subClassOf o4de:AgileActivity ;
    skos:definition "A time-boxed iteration used in agile methodologies to deliver working increments"@en .

o4de:Strength a owl:Class ;
    rdfs:label "Strength"@en ;
    rdfs:subClassOf o4de:StrategicAnalysis ;
    skos:definition "Internal capabilities, resources or attributes that provide competitive advantage"@en .

o4de:SystemCapabilities a owl:Class ;
    rdfs:label "System Capabilities"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Abilities, features and services that systems within the domain must deliver"@en .

o4de:Threat a owl:Class ;
    rdfs:label "Threat"@en ;
    rdfs:subClassOf o4de:StrategicAnalysis ;
    skos:definition "External factors or trends that could pose risks or challenges"@en .

o4de:ValueStream a owl:Class ;
    rdfs:label "Value Stream"@en ;
    rdfs:seeAlso de52:ValueStream ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:stagesValue ] ;
    skos:definition "The end-to-end series of steps by which an organization creates value for a customer."@en .

o4de:VariabilityMechanism a owl:Class ;
    rdfs:label "Variability Mechanism"@en ;
    rdfs:seeAlso de52:VariabilityMechanism ;
    skos:definition "A technique that implements variation at a variation point"@en .

o4de:VariationKind a owl:Class ;
    rdfs:label "Variation Kind"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    skos:definition "A classification of variation by the level or the aspect at which it occurs."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:Weakness a owl:Class ;
    rdfs:label "Weakness"@en ;
    rdfs:subClassOf o4de:StrategicAnalysis ;
    skos:definition "Internal limitations or deficiencies that may hinder performance"@en .

o4de:API a owl:Class ;
    rdfs:label "API"@en ;
    rdfs:seeAlso de52:API ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:contractsAPI ] ;
    skos:definition "An application programming interface: a defined set of operations through which one software system lets another use its functions or data."@en .

o4de:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:seeAlso de52:Activity ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:activityOf ],
        o4de:WorkItem ;
    skos:definition "Detailed work unit within an operation."@en .

o4de:CompetencyQuestion a owl:Class ;
    rdfs:label "Competency Question"@en ;
    rdfs:comment "Competency questions validate functional completeness"@en ;
    rdfs:seeAlso de52:CompetencyQuestion ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:questionText ] ;
    skos:definition "Natural language question the ontology must be able to answer"@en .

o4de:ConceptualDataModel a owl:Class ;
    rdfs:label "Conceptual Data Model"@en ;
    rdfs:seeAlso de52:ConceptualDataModel ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:modelsLogically ],
        o4de:DataModel ;
    skos:definition "A data model at the highest level of abstraction, showing the main business concepts and how they relate."@en .

o4de:ConsensusProtocol a owl:Class ;
    rdfs:label "Consensus Protocol"@en ;
    rdfs:seeAlso de52:ConsensusProtocol ;
    skos:definition "The procedure by which the members of a distributed system agree on one state or decision."@en .

o4de:DecentralizedOrganization a owl:Class ;
    rdfs:label "Decentralized Organization"@en ;
    rdfs:seeAlso de52:DecentralizedOrganization ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:blockchainGoverned ],
        o4de:Organization ;
    skos:definition "An organization whose authority and decisions are spread across its members rather than held at a centre."@en .

o4de:Department a owl:Class ;
    rdfs:label "Department"@en ;
    rdfs:subClassOf o4de:OrganizationalUnit ;
    skos:definition "A permanent organizational unit that groups related work and teams."@en .

o4de:DepartmentLifecyclePhase a owl:Class ;
    rdfs:label "Department Lifecycle Phase"@en ;
    rdfs:seeAlso de52:DepartmentLifecyclePhase ;
    rdfs:subClassOf o4de:LifecyclePhase ;
    skos:definition "A stage in the life of a department, from its formation to its dissolution."@en .

o4de:DomainEngineeringRole a owl:Class ;
    rdfs:label "Domain Engineering Role"@en ;
    rdfs:seeAlso de52:DomainEngineeringRole ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role played by a person in domain engineering work."@en .

o4de:DomainMaturity a owl:Class ;
    rdfs:label "Domain Maturity"@en ;
    rdfs:seeAlso de52:DomainMaturity ;
    skos:definition "A classification of how developed and well understood a domain is."@en .

o4de:Facility a owl:Class ;
    rdfs:label "Facility"@en ;
    rdfs:seeAlso de52:Facility ;
    rdfs:subClassOf o4de:PhysicalAsset ;
    skos:definition "A physical asset made of a building or site, together with what it provides."@en .

o4de:FunctionalRequirement a owl:Class ;
    rdfs:label "Functional Requirement"@en ;
    rdfs:seeAlso de52:FunctionalRequirement ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasCompetencyQuestion ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:realizedBy ],
        o4de:Requirement ;
    skos:definition "Specification of what the ontology must be able to express or support"@en .

o4de:GovernanceBoard a owl:Class ;
    rdfs:label "Governance Board"@en ;
    rdfs:seeAlso de52:GovernanceBoard ;
    skos:definition "A group with formal authority to make or approve decisions within a governance framework."@en .

o4de:GovernanceOperatingModel a owl:Class ;
    rdfs:label "Governance Operating Model"@en ;
    rdfs:seeAlso de52:GovernanceOperatingModel ;
    skos:definition "A description of how governance is carried out: who decides, at what level and by which means."@en .

o4de:IntegrationPattern a owl:Class ;
    rdfs:label "Integration Pattern"@en ;
    rdfs:seeAlso de52:IntegrationPattern ;
    skos:definition "A proven design for connecting systems, such as messaging, batch transfer or publish and subscribe."@en .

o4de:KnowledgeSource a owl:Class ;
    rdfs:label "Knowledge Source"@en ;
    rdfs:seeAlso de52:KnowledgeSource ;
    skos:definition "Source of domain knowledge used in ontology development"@en .

o4de:LogicalDataModel a owl:Class ;
    rdfs:label "Logical Data Model"@en ;
    rdfs:seeAlso de52:LogicalDataModel ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:modelsPhysically ],
        o4de:DataModel ;
    skos:definition "A data model that describes entities, attributes and relationships without tying them to a particular database product."@en .

o4de:MaintenanceSchedule a owl:Class ;
    rdfs:label "Maintenance Schedule"@en ;
    rdfs:seeAlso de52:MaintenanceSchedule ;
    skos:definition "A plan that says when and how an asset is to be maintained."@en .

o4de:OrganizationalAgility a owl:Class ;
    rdfs:label "Organizational Agility"@en ;
    rdfs:subClassOf o4de:AgilityManagement ;
    skos:definition "The capability of an organization to rapidly adapt and respond to market changes and opportunities"@en .

o4de:SIPOCAnalysis a owl:Class ;
    rdfs:label "SIPOC Analysis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasSupplier ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasInput ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasOutput ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasCustomer ],
        o4de:ProcessAnalysis ;
    skos:definition "A framework analyzing Suppliers, Inputs, Process, Outputs and Customers to understand process boundaries"@en .

o4de:SWOTAnalysis a owl:Class ;
    rdfs:label "SWOT Analysis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasStrength ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasWeakness ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasOpportunity ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasThreat ],
        o4de:StrategicAnalysis ;
    skos:definition "A framework that evaluates Strengths, Weaknesses, Opportunities and Threats"@en .

o4de:StrategicAnalysis a owl:Class ;
    rdfs:label "Strategic Analysis"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Systematic analysis of strategic factors, including internal strengths and weaknesses and external opportunities and threats"@en ;
    skos:example "SWOT analysis, PEST analysis, competitive analysis, value chain analysis"@en .

o4de:SupportingProcess a owl:Class ;
    rdfs:label "Supporting Process"@en ;
    rdfs:seeAlso de52:SupportingProcess ;
    rdfs:subClassOf o4de:BusinessProcess ;
    owl:disjointWith o4de:CoreBusinessProcess ;
    skos:definition "Processes that provide the support and infrastructure for core business processes"@en ;
    skos:example "Human resources, IT support, accounting, facilities management, compliance"@en .

o4de:TechnologyLayer a owl:Class ;
    rdfs:label "Technology Layer"@en ;
    rdfs:seeAlso de52:TechnologyLayer ;
    skos:definition "A level of the technology architecture, such as presentation, application, data or infrastructure."@en .

o4de:TestStatus a owl:Class ;
    rdfs:label "Test Status"@en ;
    rdfs:seeAlso de52:TestStatus ;
    skos:definition "Current state of test execution"@en .

o4de:TestType a owl:Class ;
    rdfs:label "Test Type"@en ;
    rdfs:seeAlso de52:TestType ;
    skos:definition "Category of testing methodology"@en .

o4de:VariantGenerationStep a owl:Class ;
    rdfs:label "Variant Generation Step"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:ProcessPhase ;
    skos:definition "A step of the variant generation process."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VotingMechanism a owl:Class ;
    rdfs:label "Voting Mechanism"@en ;
    rdfs:seeAlso de52:VotingMechanism ;
    skos:definition "The method by which members of a governing body express their choice and a result is determined."@en .

o4de:producesArtifact a owl:ObjectProperty ;
    rdfs:label "produces artifact"@en ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    rdfs:domain o4de:DomainEngineeringPhase ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( o4de:BusinessDomain o4de:DomainModel ) ] ;
    skos:definition "Links a phase to a business domain or a model that the phase produces."@en .

o4de:AssetCondition a owl:Class ;
    rdfs:label "Asset Condition"@en ;
    rdfs:seeAlso de52:AssetCondition ;
    skos:definition "A classification of the physical state of an asset, from excellent to critical, used in maintenance and replacement planning."@en .

o4de:AssetLifecycleStage a owl:Class ;
    rdfs:label "Asset Lifecycle Stage"@en ;
    rdfs:seeAlso de52:AssetLifecycleStage ;
    skos:definition "A stage in the life of a domain asset, such as in development, in use or deprecated."@en .

o4de:BusinessService a owl:Class ;
    rdfs:label "Business Service"@en ;
    rdfs:seeAlso de52:BusinessService ;
    skos:definition "A unit of value that the business offers to customers or to other parts of the organization."@en .

o4de:CoreBusinessProcess a owl:Class ;
    rdfs:label "Core Business Process"@en ;
    rdfs:seeAlso de52:CoreBusinessProcess ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:realizesCapability ],
        o4de:BusinessProcess ;
    skos:definition "Essential business processes that directly create customer value"@en ;
    skos:example "Order processing, product development, customer service, payment processing"@en .

o4de:DataClassification a owl:Class ;
    rdfs:label "Data Classification"@en ;
    rdfs:seeAlso de52:DataClassification ;
    skos:definition "A scheme that sorts data by kind or sensitivity so that it can be handled accordingly."@en .

o4de:DataCollectionLog a owl:Class ;
    rdfs:label "Data Collection Log"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:collectionDate ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:collectionMethod ],
        o4de:DomainAsset ;
    skos:definition "A systematic record of what data was collected, when, how and by whom during domain engineering"@en .

o4de:GeographicScope a owl:Class ;
    rdfs:label "Geographic Scope"@en ;
    rdfs:seeAlso de52:GeographicScope ;
    skos:definition "A classification of the area over which an organization operates."@en .

o4de:MaturityLevel a owl:Class ;
    rdfs:label "Maturity Level"@en ;
    rdfs:seeAlso de52:MaturityLevel ;
    skos:definition "A step on a scale that rates how developed and controlled an organization's practices are."@en .

o4de:MigrationStrategy a owl:Class ;
    rdfs:label "Migration Strategy"@en ;
    rdfs:seeAlso de52:MigrationStrategy ;
    skos:definition "Guidance for upgrading from one version to another"@en .

o4de:NonFunctionalRequirement a owl:Class ;
    rdfs:label "Non-Functional Requirement"@en ;
    rdfs:seeAlso de52:NonFunctionalRequirement ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:realizedBy ],
        o4de:Requirement ;
    skos:definition "Specification of quality attributes like performance or usability"@en .

o4de:ProcessPerformanceMetric a owl:Class ;
    rdfs:label "Process Performance Metric"@en ;
    rdfs:seeAlso de52:ProcessPerformanceMetric ;
    skos:definition "A metric that measures how a process performs, such as cycle time or throughput."@en .

o4de:RequirementStatus a owl:Class ;
    rdfs:label "Requirement Status"@en ;
    rdfs:seeAlso de52:RequirementStatus ;
    skos:definition "The stage a requirement has reached, from proposal to verification."@en .

o4de:ServiceDeliveryModel a owl:Class ;
    rdfs:label "Service Delivery Model"@en ;
    rdfs:seeAlso de52:ServiceDeliveryModel ;
    skos:definition "A way in which a service is provided, such as in-house, outsourced, cloud-based or hybrid."@en .

o4de:AutomationTechnique a owl:Class ;
    rdfs:label "Automation Technique"@en ;
    rdfs:seeAlso de52:AutomationTechnique ;
    skos:definition "A way of automating work, such as data, decision, integration or robotic automation."@en .

o4de:OrganizationSize a owl:Class ;
    rdfs:label "Organization Size"@en ;
    rdfs:seeAlso de52:OrganizationSize ;
    skos:definition "A classification of an organization by its number of people or its scale."@en .

o4de:OwnershipType a owl:Class ;
    rdfs:label "Ownership Type"@en ;
    rdfs:seeAlso de52:OwnershipType ;
    skos:definition "A classification of who owns an organization and on what terms."@en .

o4de:PerformanceBenchmark a owl:Class ;
    rdfs:label "Performance Benchmark"@en ;
    rdfs:seeAlso de52:PerformanceBenchmark ;
    skos:definition "Performance metrics and benchmarking results"@en .

o4de:ProcessOptimizationMethodology a owl:Class ;
    rdfs:label "Process Optimization Methodology"@en ;
    rdfs:seeAlso de52:ProcessOptimizationMethodology ;
    skos:definition "A structured approach to making processes more effective, such as lean or six sigma."@en .

o4de:ProcessWaste a owl:Class ;
    rdfs:label "Process Waste"@en ;
    rdfs:seeAlso de52:ProcessWaste ;
    skos:definition "An activity or condition in a process that uses resources without adding value."@en .

o4de:Team a owl:Class ;
    rdfs:label "Team"@en ;
    rdfs:subClassOf o4de:OrganizationalUnit ;
    skos:definition "A group of employees who work together toward a shared goal."@en .

o4de:TestSuite a owl:Class ;
    rdfs:label "Test Suite"@en ;
    rdfs:comment "Test suites enable automated quality assurance and regression testing"@en ;
    rdfs:seeAlso de52:TestSuite ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasTestCase ] ;
    skos:definition "Collection of test cases for ontology validation"@en .

o4de:Workflow a owl:Class ;
    rdfs:label "Workflow"@en ;
    rdfs:seeAlso de52:Workflow ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:decidesAt ] ;
    skos:definition "A sequence of steps by which work moves between people or systems according to rules."@en .

o4de:AutomationBenefit a owl:Class ;
    rdfs:label "Automation Benefit"@en ;
    rdfs:seeAlso de52:AutomationBenefit ;
    skos:definition "An improvement expected or achieved by automating work, such as lower cost, fewer errors or shorter cycle time."@en .

o4de:BusinessFunction a owl:Class ;
    rdfs:label "Business Function"@en ;
    rdfs:seeAlso de52:BusinessFunction ;
    skos:definition "A grouped set of ongoing activities, such as finance or human resources, that an organization carries out to support its goals."@en .

o4de:DecisionAuthority a owl:Class ;
    rdfs:label "Decision Authority"@en ;
    rdfs:seeAlso de52:DecisionAuthority ;
    skos:definition "The power to make a given kind of decision, held by a person, role or body."@en .

o4de:DomainType a owl:Class ;
    rdfs:label "Domain Type"@en ;
    rdfs:seeAlso de52:DomainType ;
    skos:definition "Classification dimension for domains."@en .

o4de:FeatureModel a owl:Class ;
    rdfs:label "Feature Model"@en ;
    rdfs:seeAlso de52:FeatureModel ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:mandatoryFeature ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasFeature ],
        o4de:DomainAsset ;
    skos:definition "A hierarchical model that captures the commonalities and variabilities of a domain in terms of features and their relationships"@en ;
    skos:scopeNote "Feature models are central to managing variability in domain engineering"@en .

o4de:Operation a owl:Class ;
    rdfs:label "Operation"@en ;
    rdfs:seeAlso de52:Operation ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:operationOf ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:operationOf ],
        o4de:OperationsManagement,
        o4de:WorkItem ;
    skos:definition "A specific activity or set of activities performed as part of business operations"@en .

o4de:OperationalCharacteristic a owl:Class ;
    rdfs:label "Operational Characteristic"@en ;
    rdfs:seeAlso de52:OperationalCharacteristic ;
    skos:definition "A feature of how an organization operates, such as working around the clock, remotely or in several places."@en .

o4de:OrganizationalLifecyclePhase a owl:Class ;
    rdfs:label "Organizational Lifecycle Phase"@en ;
    rdfs:seeAlso de52:OrganizationalLifecyclePhase ;
    rdfs:subClassOf o4de:LifecyclePhase ;
    skos:definition "A stage in the life of an organization, from inception to sunset."@en .

o4de:ProductLifecycleStage a owl:Class ;
    rdfs:label "Product Lifecycle Stage"@en ;
    skos:definition "A distinct phase in a product's lifecycle"@en .

o4de:Tool a owl:Class ;
    rdfs:label "Tool"@en ;
    rdfs:seeAlso de52:Tool ;
    skos:definition "A software tool that supports domain engineering activities"@en .

o4de:BusinessCapability a owl:Class ;
    rdfs:label "Business Capability"@en ;
    rdfs:seeAlso de52:BusinessCapability ;
    skos:definition "What a business is able to do, described independently of who does it or how it is done."@en .

o4de:Inventory a owl:Class ;
    rdfs:label "Inventory"@en ;
    rdfs:subClassOf o4de:InventoryManagement ;
    skos:definition "The quantity of goods and materials held in stock by a business"@en .

o4de:RequirementPriority a owl:Class ;
    rdfs:label "Requirement Priority"@en ;
    rdfs:seeAlso de52:RequirementPriority ;
    skos:definition "A ranking of how important it is that a requirement be met."@en .

o4de:TripleStore a owl:Class ;
    rdfs:label "Triple Store"@en ;
    rdfs:seeAlso de52:TripleStore ;
    skos:definition "RDF database for storing and querying ontology data"@en .

o4de:Customer a owl:Class ;
    rdfs:label "Customer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:belongsToSegment ],
        o4de:Stakeholder ;
    skos:definition "An individual or organization that receives and uses the outputs of business processes"@en .

o4de:Deployment a owl:Class ;
    rdfs:label "Deployment"@en ;
    rdfs:seeAlso de52:Deployment ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:deployedOn ],
        o4de:DevelopmentPhase ;
    skos:definition "Deployment configuration of the ontology in a runtime environment"@en,
        "Phase of deploying to production"@en .

o4de:DomainModel a owl:Class ;
    rdfs:label "Domain Model"@en ;
    rdfs:seeAlso de52:DomainModel ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A model of the key concepts, relationships and constraints within the application domain"@en .

o4de:Stakeholder a owl:Class ;
    rdfs:label "Stakeholder"@en ;
    rdfs:seeAlso de52:Stakeholder ;
    rdfs:subClassOf foaf:Agent ;
    skos:definition "A person or organization with an interest in, or influence over, the domain"@en .

o4de:TestCase a owl:Class ;
    rdfs:label "Test Case"@en ;
    rdfs:seeAlso de52:TestCase ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:testStatus ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:testType ] ;
    skos:definition "Individual validation test with expected outcomes"@en .

o4de:WorkItem a owl:Class ;
    rdfs:label "Work Item"@en ;
    rdfs:seeAlso de52:WorkItem ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasResponsibilityAssignment ] ;
    skos:definition "Root class for all work units."@en .

o4de:DevelopmentPhase a owl:Class ;
    rdfs:label "Development Phase"@en ;
    rdfs:seeAlso de52:DevelopmentPhase ;
    skos:definition "Phase in ontology development lifecycle"@en .

o4de:DiscoveryMethod a owl:Class ;
    rdfs:label "Discovery Method"@en ;
    rdfs:seeAlso de52:DiscoveryMethod ;
    skos:definition "A systematic way of finding out how a domain works, such as interviews, code mining or data profiling."@en .

o4de:ProcessActivity a owl:Class ;
    rdfs:label "Process Activity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasDuration ] ;
    skos:definition "A unit of work performed within a process, with a duration, effort and responsible roles"@en .

o4de:VariationCapacityProperty a owl:Class ;
    rdfs:label "Variation Capacity Property"@en ;
    dcterms:source "Owner's 2013 thesis (section headings only)" ;
    rdfs:subClassOf o4de:QualityAttribute ;
    skos:definition "A quality attribute that contributes to how far a component or product can be varied, such as adaptability or configurability."@en ;
    skos:scopeNote "Named in the headings of the owner's 2013 thesis; the definition is a general reading of the term and is to be confirmed against the thesis text."@en .

o4de:VariationPoint a owl:Class ;
    rdfs:label "Variation Point"@en ;
    rdfs:seeAlso de52:VariationPoint ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasVariant ],
        [ a owl:Restriction ;
            owl:minCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasVariant ] ;
    skos:definition "A location in a domain asset where variation occurs, representing a design decision that can be made in different ways"@en ;
    skos:example "Database selection point, authentication mechanism choice, UI framework selection"@en ;
    skos:scopeNote "Variation points enable customization and adaptation of domain assets"@en .

o4de:ChangeRequest a owl:Class ;
    rdfs:label "Change Request"@en ;
    rdfs:seeAlso de52:ChangeRequest ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:communicatesChange ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasChangeImpact ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:executesTransition ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:assessesImpact ] ;
    skos:definition "A formal proposal to alter an asset, process or system, with the reason and expected effect."@en .

o4de:Channel a owl:Class ;
    rdfs:label "Channel"@en ;
    rdfs:subClassOf o4de:ChannelManagement ;
    skos:definition "A medium or pathway through which products, services or information reach customers"@en .

o4de:DomainEngineeringActivity a owl:Class ;
    rdfs:label "Domain Engineering Activity"@en ;
    rdfs:subClassOf o4de:ProcessActivity ;
    skos:definition "A systematic activity that contributes to the creation, analysis, design, implementation or evolution of domain assets"@en ;
    skos:example "Domain analysis, feature modeling, component design, asset testing"@en ;
    skos:scopeNote "Domain engineering activities are the fundamental building blocks of the domain engineering process"@en .

o4de:DomainEngineeringProcess a owl:Class ;
    rdfs:label "Domain Engineering Process"@en ;
    rdfs:seeAlso de52:DomainEngineeringProcess ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:int ;
                    owl:withRestrictions ( [ xsd:minInclusive "1"^^xsd:int ] [ xsd:maxInclusive "5"^^xsd:int ] ) ] ;
            owl:onProperty o4de:hasMaturityLevel ],
        o4de:Process ;
    skos:definition "A structured set of activities, roles and controls that produces and maintains domain assets"@en .

o4de:GovernanceFramework a owl:Class ;
    rdfs:label "Governance Framework"@en ;
    rdfs:seeAlso de52:GovernanceFramework ;
    skos:definition "A structure of principles, roles, rules and processes by which an organization directs and controls itself."@en .

o4de:MarketingCampaign a owl:Class ;
    rdfs:label "Marketing Campaign"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:campaignStartDate ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:campaignEndDate ],
        o4de:CampaignManagement ;
    skos:definition "A coordinated series of marketing activities designed to achieve specific objectives"@en .

o4de:QualityAttribute a owl:Class ;
    rdfs:label "Quality Attribute"@en ;
    rdfs:seeAlso de52:QualityAttribute ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:measuredBy ] ;
    skos:definition "A measurable property of a system or asset such as security, performance or reusability"@en .

o4de:Version a owl:Class ;
    rdfs:label "Version"@en ;
    rdfs:comment "Version tracking enables proper change management and migration planning"@en ;
    rdfs:seeAlso de52:Version ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:releaseDate ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:versionNumber ] ;
    skos:definition "A specific release of the Domain Engineering Ontology"@en .

o4de:CorporateFunctionDomain a owl:Class ;
    rdfs:label "Corporate Function Domain"@en ;
    rdfs:seeAlso de52:CorporateFunctionDomain ;
    rdfs:subClassOf o4de:Domain,
        o4de:DomainType ;
    skos:definition "A domain made of a function that most organizations need, such as finance, legal or human resources."@en .

o4de:Ontology a owl:Class ;
    rdfs:label "Ontology"@en ;
    rdfs:seeAlso de52:Ontology ;
    rdfs:subClassOf o4de:DomainModel ;
    skos:definition "A domain model that defines the concepts of a domain and their relations in a formal, machine-readable way."@en .

o4de:VendorSolution a owl:Class ;
    rdfs:label "Vendor Solution"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:providedByVendor ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 5.0 ] ) ] ;
            owl:onProperty o4de:solutionRating ] ;
    skos:definition "Third-party products, services and solutions that can be leveraged or considered in domain engineering"@en ;
    skos:example "Cloud platforms, commercial frameworks, third-party components, consulting services"@en .

o4de:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    rdfs:seeAlso de52:Feature ;
    skos:definition "A distinguishable characteristic of a system that is relevant to a stakeholder"@en .

o4de:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    rdfs:seeAlso de52:Metric ;
    skos:definition "A defined measure used to quantify a quality attribute or process performance"@en .

o4de:DomainAnalyst a owl:Class ;
    rdfs:label "Domain Analyst"@en ;
    rdfs:seeAlso de52:DomainAnalyst ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:usesDiscoveryMethod ],
        o4de:DomainEngineeringRole,
        o4de:Role ;
    skos:definition "A role responsible for studying the domain and capturing its requirements, commonalities and variability."@en .

o4de:AutomationCandidate a owl:Class ;
    rdfs:label "Automation Candidate"@en ;
    rdfs:seeAlso de52:AutomationCandidate ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:automationScope ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasAutomationBenefit ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:automationROI ] ;
    skos:definition "A process, operation or task that is assessed as a possible target for automation."@en .

o4de:BusinessProcess a owl:Class ;
    rdfs:label "Business Process"@en ;
    rdfs:seeAlso de52:BusinessProcess ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasBusinessRole ],
        o4de:BusinessContext,
        o4de:Process ;
    skos:definition "A collection of related, structured activities that produce a specific service or product for customers"@en ;
    skos:example "Order processing, customer onboarding, payment processing, inventory management"@en .

o4de:BusinessRule a owl:Class ;
    rdfs:label "Business Rule"@en ;
    rdfs:seeAlso de52:BusinessRule ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:ruleType ],
        o4de:BusinessContext ;
    skos:definition "A directive intended to influence or guide business behavior and decision-making"@en .

o4de:Employee a owl:Class ;
    rdfs:label "Employee"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 5.0 ] ) ] ;
            owl:onProperty o4de:performanceRating ],
        [ a owl:Restriction ;
            owl:onProperty o4de:belongsToUnit ;
            owl:someValuesFrom o4de:OrganizationalUnit ],
        [ a owl:Restriction ;
            owl:onProperty o4de:holdsPosition ;
            owl:someValuesFrom o4de:Position ],
        o4de:Stakeholder ;
    skos:definition "A person who works for the organization and holds a position in it."@en .

o4de:IndustryDomain a owl:Class ;
    rdfs:label "Industry Domain"@en ;
    rdfs:seeAlso de52:IndustryDomain ;
    rdfs:subClassOf o4de:Domain,
        o4de:DomainType ;
    skos:definition "A domain made of an industry sector, such as manufacturing or healthcare."@en .

o4de:OrganizationalUnit a owl:Class ;
    rdfs:label "Organizational Unit"@en ;
    rdfs:seeAlso de52:OrganizationalUnit ;
    rdfs:subClassOf o4de:Organization,
        o4de:OrganizationalStructure ;
    skos:definition "Any part of an organization with its own members and responsibilities, such as a department or a team."@en .

o4de:BusinessContext a owl:Class ;
    rdfs:label "Business Context"@en ;
    skos:definition "Business-oriented information and context that influences domain engineering decisions: environment, problems, capabilities, benefits, processes, roles, rules and architecture"@en ;
    skos:scopeNote "Business context provides the foundation for understanding domain requirements and constraints"@en .

o4de:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:seeAlso de52:Role ;
    skos:definition "A set of responsibilities and competencies assigned to a person in a process"@en .

o4de:DataEntity a owl:Class ;
    rdfs:label "Data Entity"@en ;
    rdfs:seeAlso de52:DataEntity ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasAttribute ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:analyticData ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasAttribute ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:stewardedBy ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:ownedBy ] ;
    skos:definition "A thing of interest about which data is kept, such as a customer or an order."@en .

o4de:Product a owl:Class ;
    rdfs:label "Product"@en ;
    rdfs:seeAlso de52:Product ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:usesAsset ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 10.0 ] ) ] ;
            owl:onProperty o4de:qualityScore ],
        [ a owl:Restriction ;
            owl:onProperty o4de:hasLifecycle ;
            owl:someValuesFrom o4de:ProductLifecycle ],
        [ a owl:Restriction ;
            owl:onProperty o4de:currentStage ;
            owl:someValuesFrom o4de:ProductLifecycleStage ] ;
    skos:definition "A tangible or intangible good offered to satisfy customer needs"@en .

o4de:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:seeAlso de52:Person ;
    skos:definition "A human being who acts in a domain, as an individual with roles and responsibilities."@en .

o4de:DistributedAutonomousOrganization a owl:Class ;
    rdfs:label "DAO"@en ;
    rdfs:seeAlso de52:DistributedAutonomousOrganization ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:achievesConsensus ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:executesContract ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:issuesToken ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:votesVia ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:proposesVia ],
        o4de:DecentralizedOrganization ;
    skos:definition "A decentralized organization run by rules encoded in software, with decisions taken by its members' votes."@en .

o4de:PhysicalAsset a owl:Class ;
    rdfs:label "Physical Asset"@en ;
    rdfs:seeAlso de52:PhysicalAsset ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasCondition ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasCondition ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:insuresAsset ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasMaintenanceSchedule ],
        o4de:Asset ;
    skos:definition "A tangible asset, such as equipment, a facility or a vehicle."@en .

o4de:Requirement a owl:Class ;
    rdfs:label "Requirement"@en ;
    rdfs:seeAlso de52:Requirement ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:tracesTo ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasPriority ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:prioritizesMustHave ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasRequirementStatus ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasAcceptanceCriteria ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasSource ] ;
    skos:definition "A statement of a need that a product, process or system must satisfy."@en .

o4de:ApplicationSystem a owl:Class ;
    rdfs:label "Application System"@en ;
    rdfs:seeAlso de52:ApplicationSystem ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasComponent ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:exposesAPI ],
        [ a owl:Restriction ;
            owl:minCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:layersWith ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasComponent ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:supportsProcess ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:managesData ] ;
    skos:definition "A software system, made of one or more application components, that supports business functions or processes."@en .

o4de:Process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:seeAlso de52:Process ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasOperation ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:simulatesProcess ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasResponsibilityAssignment ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasOperation ],
        o4de:WorkItem ;
    skos:definition "End-to-end set of operations with defined objective."@en .

o4de:DomainAsset a owl:Class ;
    rdfs:label "Domain Asset"@en ;
    rdfs:seeAlso de52:DomainAsset ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasQuality ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:storedIn ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasLifecycleStage ],
        [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:conformsTo ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasLifecycleStage ],
        o4de:Asset ;
    skos:definition "A reusable artifact that encapsulates domain knowledge and can be used across multiple applications within the same domain"@en ;
    skos:example "Reusable components, frameworks, reference architectures, domain models, DSLs"@en ;
    skos:scopeNote "Domain assets are the primary output of domain engineering activities"@en .

o4de:Domain a owl:Class ;
    rdfs:label "Domain"@en ;
    rdfs:seeAlso de52:Domain ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:definesInDictionary ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:definesInGlossary ] ;
    skos:definition "Bounded sphere of knowledge with distinct concepts and practices."@en .

o4de:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:seeAlso de52:Organization ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:inLifecyclePhase ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:inLifecyclePhase ],
        [ a owl:Restriction ;
            owl:minCardinality "3"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:measuresWithKPI ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasOrganizationSize ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasGovernanceFramework ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:managesChange ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:governsWith ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasCapability ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasGeographicScope ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasAssetPortfolio ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasOrganizationMaturity ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:operatesAs ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasOwnershipType ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:managesKnowledge ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:inventoriesAssets ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasBusinessFunction ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty o4de:hasOrganizationMaturity ] ;
    skos:definition "A group of people with a shared purpose, arranged under a structure and owned in some form."@en .

