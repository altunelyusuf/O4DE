    rdfs:seeAlso de52:EmergingDomain ;
    rdfs:subClassOf o4de:DomainMaturity ;
    skos:definition "A domain maturity level at which a domain is new, still forming and changing quickly."@en .

o4de:EmployeeEngagementMetric a owl:Class ;
