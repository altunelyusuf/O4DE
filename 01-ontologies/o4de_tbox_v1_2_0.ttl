    rdfs:subClassOf o4de:Ontology ;
    skos:definition "An ontology that specifies the concepts of one business or technical domain and the relations between them."@en .

o4de:DomainScope a owl:Class ;
    rdfs:label "Domain Scope"@en ;
    rdfs:seeAlso de52:DomainScope ;
    skos:definition "The part of the world that a domain covers, stated by its subjects and its limits."@en .

o4de:DynamicAnalysis a owl:Class ;
    rdfs:label "Dynamic Analysis"@en ;
    rdfs:seeAlso de52:DynamicAnalysis ;
