o4de:validationQuery a owl:DatatypeProperty ;
    rdfs:label "validation query"@en ;
    rdfs:comment "SPARQL query for validation"@en ;
    rdfs:domain o4de:TestCase ;
    rdfs:range xsd:string ;
    rdfs:seeAlso de52:validationQuery ;
    skos:definition "Records the validation query of a test case as a text."@en .

o4de:valuesAssetsOf a owl:ObjectProperty ;
    rdfs:label "valuesAssetsOf"@en ;
    rdfs:domain o4de:AssetValuation ;
    rdfs:range o4de:Organization ;
    rdfs:seeAlso de52:valuesAssetsOf ;
    owl:inverseOf o4de:valuesAssets ;
    skos:definition "Links an asset valuation to an organization; the inverse of the relation 'valuesassets'."@en .

o4de:variantOf a owl:ObjectProperty ;
    rdfs:label "variant of"@en ;
    rdfs:domain o4de:Variant ;
    rdfs:range o4de:VariationPoint ;
    rdfs:seeAlso de52:variantOf ;
    owl:inverseOf o4de:hasVariant ;
    skos:definition "Links a variant to a variation point; the inverse of the relation 'has variant'."@en .

o4de:variationPointOf a owl:ObjectProperty ;
    rdfs:label "variation point of"@en ;
    rdfs:domain o4de:VariationPoint ;
    rdfs:range o4de:DomainAsset ;
    rdfs:seeAlso de52:variationPointOf ;
    owl:inverseOf o4de:hasVariationPoint ;
    skos:definition "Links a variation point to a domain asset; the inverse of the relation 'has variation point'."@en .

o4de:vehicleOf a owl:ObjectProperty ;
    rdfs:label "vehicleOf"@en ;
    rdfs:domain o4de:Vehicle ;
    rdfs:range o4de:Fleet ;
    rdfs:seeAlso de52:vehicleOf ;
    owl:inverseOf o4de:vehicle ;
    skos:definition "Links a vehicle to a fleet; the inverse of the relation 'vehicle'."@en .

o4de:verifiedAsOf a owl:ObjectProperty ;
    rdfs:label "verifiedAsOf"@en ;
    rdfs:domain o4de:VerifiedRequirement ;
    rdfs:range o4de:Requirement ;
    rdfs:seeAlso de52:verifiedAsOf ;
    owl:inverseOf o4de:verifiedAs ;
    skos:definition "Links a verified to a requirement; the inverse of the relation 'verifiedas'."@en .

o4de:versionedAsOf a owl:ObjectProperty ;
    rdfs:label "versionedAsOf"@en ;
    rdfs:domain o4de:RequirementVersion ;
    rdfs:range o4de:Requirement ;
    rdfs:seeAlso de52:versionedAsOf ;
    owl:inverseOf o4de:versionedAs ;
    skos:definition "Links a requirement version to a requirement; the inverse of the relation 'versionedas'."@en .

o4de:votesQuadraticallyOf a owl:ObjectProperty ;
    rdfs:label "votesQuadraticallyOf"@en ;
    rdfs:domain o4de:QuadraticVoting ;
    rdfs:range o4de:DistributedAutonomousOrganization ;
    rdfs:seeAlso de52:votesQuadraticallyOf ;
    owl:inverseOf o4de:votesQuadratically ;
    skos:definition "Links a quadratic voting to a dao; the inverse of the relation 'votesquadratically'."@en .

o4de:votesSimplyOf a owl:ObjectProperty ;
    rdfs:label "votesSimplyOf"@en ;
    rdfs:domain o4de:SimpleVoting ;
    rdfs:range o4de:DistributedAutonomousOrganization ;
    rdfs:seeAlso de52:votesSimplyOf ;
    owl:inverseOf o4de:votesSimply ;
    skos:definition "Links a simple voting to a dao; the inverse of the relation 'votessimply'."@en .

o4de:votesViaOf a owl:ObjectProperty ;
    rdfs:label "votesViaOf"@en ;
    rdfs:domain o4de:VotingMechanism ;
    rdfs:range o4de:DistributedAutonomousOrganization ;
    rdfs:seeAlso de52:votesViaOf ;
    owl:inverseOf o4de:votesVia ;
    skos:definition "Links a voting mechanism to a dao; the inverse of the relation 'votesvia'."@en .

o4de:votingPower a owl:DatatypeProperty ;
    rdfs:label "voting power"@en ;
    rdfs:domain o4de:GovernanceToken ;
    rdfs:range xsd:decimal ;
    rdfs:seeAlso de52:votingPower ;
    skos:definition "Records the voting power of a governance token as a decimal number."@en .

o4de:waitTime a owl:DatatypeProperty ;
    rdfs:label "wait time"@en,
        "waitTime"@en ;
    rdfs:domain o4de:Process ;
    rdfs:range xsd:duration ;
    rdfs:seeAlso de52:waitTime ;
    skos:definition "Records the wait time of a process as a duration."@en .

o4de:waitingOf a owl:ObjectProperty ;
    rdfs:label "waitingOf"@en ;
    rdfs:domain o4de:Waiting ;
    rdfs:range o4de:Process ;
    rdfs:seeAlso de52:waitingOf ;
    owl:inverseOf o4de:waiting ;
    skos:definition "Links a waiting to a process; the inverse of the relation 'waiting'."@en .

o4de:warehouseLocationOf a owl:ObjectProperty ;
    rdfs:label "warehouseLocationOf"@en ;
    rdfs:domain o4de:Warehouse ;
    rdfs:range o4de:Organization ;
    rdfs:seeAlso de52:warehouseLocationOf ;
    owl:inverseOf o4de:warehouseLocation ;
    skos:definition "Links a warehouse to an organization; the inverse of the relation 'warehouselocation'."@en .

o4de:weaknessImpact a owl:DatatypeProperty ;
    rdfs:label "weakness impact"@en ;
    rdfs:domain o4de:Weakness ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric score of how much damage a weakness can cause."@en .

o4de:workflowAutomationOf a owl:ObjectProperty ;
    rdfs:label "workflowAutomationOf"@en ;
    rdfs:domain o4de:WorkflowAutomation ;
    rdfs:range o4de:Process ;
    rdfs:seeAlso de52:workflowAutomationOf ;
    owl:inverseOf o4de:workflowAutomation ;
    skos:definition "Links a workflow automation to a process; the inverse of the relation 'workflowautomation'."@en .

o4de:AcceptanceCriteria a owl:Class ;
    rdfs:label "Acceptance Criteria"@en ;
    rdfs:seeAlso de52:AcceptanceCriteria ;
    skos:definition "The conditions that a deliverable must meet before a requirement is regarded as satisfied."@en .

o4de:Accountable a owl:Class ;
    rdfs:label "Accountable"@en ;
    rdfs:seeAlso de52:Accountable ;
    skos:definition "The responsibility-assignment role held by the one party who answers for the outcome of a work item and has final approval."@en .

o4de:Bottleneck a owl:Class ;
    rdfs:label "Bottleneck"@en ;
    rdfs:seeAlso de52:Bottleneck ;
    skos:definition "A step in a process whose limited capacity holds back the throughput of the whole process."@en .

o4de:BusinessAnalysis a owl:Class ;
    rdfs:label "Business Analysis"@en ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    rdfs:subClassOf o4de:DomainEngineeringProcess ;
    skos:definition "The process of studying a business, its needs and its problems in order to define what has to change."@en .

o4de:BusinessArchitecture a owl:Class ;
    rdfs:label "Business Architecture"@en ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    rdfs:subClassOf o4de:DomainModel ;
    skos:definition "A model of how the strategy, organization, functions and processes of a business are structured and interact."@en .

o4de:BusinessProcessModel a owl:Class ;
    rdfs:label "Business Process Model"@en ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    rdfs:subClassOf o4de:DomainModel ;
    skos:definition "A formal representation of a business workflow, often drawn in a standard notation such as BPMN 2.0."@en .

o4de:BusinessProcessModeling a owl:Class ;
    rdfs:label "Business Process Modeling"@en ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    rdfs:subClassOf o4de:DomainEngineeringProcess ;
    skos:definition "The process of describing the workflows of a business as formal models."@en .

o4de:CRM a owl:Class ;
    rdfs:label "Customer Relationship Management"@en ;
    rdfs:subClassOf o4de:CustomerManagement ;
    skos:altLabel "CRM"@en ;
    skos:definition "Technology and processes used to manage customer interactions and relationships"@en .

o4de:CampaignManagement a owl:Class ;
    rdfs:label "Campaign Management"@en ;
    rdfs:subClassOf o4de:MarketingManagement ;
    skos:definition "The management activity that plans, runs and evaluates marketing campaigns."@en .

o4de:ChangeImpact a owl:Class ;
    rdfs:label "Change Impact"@en ;
    rdfs:seeAlso de52:ChangeImpact ;
    skos:definition "The effect that a change has on assets, processes, people or systems."@en .

o4de:ChannelManagement a owl:Class ;
    rdfs:label "Channel Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Management of the channels through which products and services reach customers"@en .

o4de:CompletenessTest a owl:Class ;
    rdfs:label "Completeness Test"@en ;
    rdfs:seeAlso de52:CompletenessTest ;
    rdfs:subClassOf o4de:TestType ;
    skos:definition "Validates coverage and completeness of ontology elements"@en .

o4de:ConceptualModel a owl:Class ;
    rdfs:label "Conceptual Model"@en ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    rdfs:subClassOf o4de:DomainModel ;
    skos:definition "A high-level model that captures the main concepts of a domain and how they relate, without implementation detail."@en .

o4de:ConsistencyTest a owl:Class ;
    rdfs:label "Consistency Test"@en ;
    rdfs:seeAlso de52:ConsistencyTest ;
    rdfs:subClassOf o4de:TestType ;
    skos:definition "Validates logical consistency and absence of contradictions"@en .

o4de:Consulted a owl:Class ;
    rdfs:label "Consulted"@en ;
    rdfs:seeAlso de52:Consulted ;
    skos:definition "The responsibility-assignment role of a party who is asked for input before a decision or action, in two-way communication."@en .

o4de:CorrectnessTest a owl:Class ;
    rdfs:label "Correctness Test"@en ;
    rdfs:seeAlso de52:CorrectnessTest ;
    rdfs:subClassOf o4de:TestType ;
    skos:definition "Validates accuracy and correctness of representations"@en .

o4de:CouldHave a owl:Class ;
    rdfs:label "Could Have"@en ;
    rdfs:seeAlso de52:CouldHave ;
    rdfs:subClassOf o4de:RequirementPriority ;
    owl:equivalentClass o4de:CouldHavePriority ;
    skos:definition "The requirement priority for a requirement that is desirable but can be left out without serious harm, as named in the ontology lifecycle part."@en .

o4de:CustomerCategorization a owl:Class ;
    rdfs:label "Customer Categorization"@en ;
    rdfs:subClassOf o4de:CustomerManagement ;
    skos:definition "Classification of customers based on characteristics, behavior or value"@en .

o4de:DataOwner a owl:Class ;
    rdfs:label "Data Owner"@en ;
    rdfs:seeAlso de52:DataOwner ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:ownedBy ],
        o4de:Role ;
    skos:definition "A role accountable for a set of data, who decides who may use it and how."@en .

o4de:DeclineStage a owl:Class ;
    rdfs:label "Decline Stage"@en ;
    rdfs:comment "Product experiences decreasing demand"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which demand for a product decreases."@en .

o4de:Dependency a owl:Class ;
    rdfs:label "Dependency"@en ;
    rdfs:seeAlso de52:Dependency ;
    skos:definition "A relation in which one change, task or asset relies on another being done or present."@en .

o4de:DevelopmentDeployment a owl:Class ;
    rdfs:label "Development Deployment"@en ;
    rdfs:seeAlso de52:DevelopmentDeployment ;
    rdfs:subClassOf o4de:Deployment ;
    skos:definition "Development and testing environment"@en .

o4de:DevelopmentStage a owl:Class ;
    rdfs:label "Development Stage"@en ;
    rdfs:comment "Product is being developed and designed"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which a product is being designed and developed."@en .

o4de:DigitalChannel a owl:Class ;
    rdfs:label "Digital Channel"@en ;
    rdfs:subClassOf o4de:Channel ;
    skos:definition "A channel that reaches customers through digital media such as a website or application."@en .

o4de:DiscountingManagement a owl:Class ;
    rdfs:label "Discounting Management"@en ;
    rdfs:subClassOf o4de:FinancialManagement ;
    skos:definition "The management activity that defines and controls discounts."@en .

o4de:DistributionChannel a owl:Class ;
    rdfs:label "Distribution Channel"@en ;
    rdfs:subClassOf o4de:Channel ;
    skos:definition "A channel through which products are physically or digitally delivered to customers."@en .

o4de:DomainCorpus a owl:Class ;
    rdfs:label "Domain Corpus"@en ;
    rdfs:seeAlso de52:DomainCorpus ;
    rdfs:subClassOf o4de:KnowledgeSource ;
    skos:definition "A body of texts about a domain that serves as a source of knowledge for building an ontology."@en .

o4de:DomainEngineeringPrompt a owl:Class ;
    rdfs:label "Domain Engineering Prompt Template"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A reusable instruction template for a language model that carries out a domain engineering task."@en .

o4de:DomainLiterature a owl:Class ;
    rdfs:label "Domain Literature"@en ;
    rdfs:seeAlso de52:DomainLiterature ;
    rdfs:subClassOf o4de:KnowledgeSource ;
    skos:definition "A knowledge source made up of books, papers and standards about the domain."@en .

o4de:DomainModelValidation a owl:Class ;
    rdfs:label "Domain Model Validation"@en ;
    dcterms:source "AI4SE ontology package, Domain Engineering module (repaired copy of the received file)" ;
    rdfs:subClassOf o4de:DomainAnalysisTechnique ;
    skos:definition "The technique of checking a domain model against its purpose, by competency questions, consistency checking and review by stakeholders; it is done repeatedly during domain engineering and not only at the end."@en .

o4de:EnablingCapability a owl:Class ;
    rdfs:label "Enabling Capability"@en ;
    rdfs:seeAlso de52:EnablingCapability ;
    rdfs:subClassOf o4de:BusinessCapability ;
    skos:definition "A business capability that supports other capabilities without itself creating customer value."@en .

o4de:ExistingOntology a owl:Class ;
    rdfs:label "Existing Ontology"@en ;
    rdfs:seeAlso de52:ExistingOntology ;
    rdfs:subClassOf o4de:KnowledgeSource ;
    skos:definition "A knowledge source made up of ontologies that already exist and can be reused."@en .

o4de:Failing a owl:Class ;
    rdfs:label "Failing"@en ;
    rdfs:seeAlso de52:Failing ;
    rdfs:subClassOf o4de:TestStatus ;
    skos:definition "The test status of a test whose result did not meet what was expected."@en .

o4de:GrowthStage a owl:Class ;
    rdfs:label "Growth Stage"@en ;
    rdfs:comment "Product experiences rapid market acceptance"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which a product gains rapid market acceptance."@en .

o4de:HumanResourceManagement a owl:Class ;
    rdfs:label "Human Resource Management"@en ;
    rdfs:subClassOf o4de:OrganizationalManagement ;
    skos:altLabel "HRM"@en ;
    skos:definition "Management of human capital, including recruitment, development, performance and retention"@en .

o4de:Informed a owl:Class ;
    rdfs:label "Informed"@en ;
    rdfs:seeAlso de52:Informed ;
    skos:definition "The responsibility-assignment role of a party who is told of a decision or result, in one-way communication."@en .

o4de:IntroductionStage a owl:Class ;
    rdfs:label "Introduction Stage"@en ;
    rdfs:comment "Product is launched to market"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which a product is launched to the market."@en .

o4de:MajorVersion a owl:Class ;
    rdfs:label "Major Version"@en ;
    rdfs:seeAlso de52:MajorVersion ;
    rdfs:subClassOf o4de:Version ;
    skos:definition "Version with breaking changes (X.0.0)"@en .

o4de:MarketingManagement a owl:Class ;
    rdfs:label "Marketing Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "The management activity that plans and runs marketing of products and services."@en .

o4de:MaturityStage a owl:Class ;
    rdfs:label "Maturity Stage"@en ;
    rdfs:comment "Product reaches peak market penetration"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which a product reaches its peak market penetration."@en .

o4de:MinorVersion a owl:Class ;
    rdfs:label "Minor Version"@en ;
    rdfs:seeAlso de52:MinorVersion ;
    rdfs:subClassOf o4de:Version ;
    skos:definition "Version with backward-compatible additions (x.Y.0)"@en .

o4de:MustHave a owl:Class ;
    rdfs:label "Must Have"@en ;
    rdfs:seeAlso de52:MustHave ;
    rdfs:subClassOf o4de:RequirementPriority ;
    owl:equivalentClass o4de:MustHavePriority ;
    skos:definition "The requirement priority for a requirement that is essential and cannot be left out, as named in the ontology lifecycle part."@en .

o4de:NotRun a owl:Class ;
    rdfs:label "Not Run"@en ;
    rdfs:seeAlso de52:NotRun ;
    rdfs:subClassOf o4de:TestStatus ;
    skos:definition "The test status of a test that has not been executed."@en .

o4de:OrganizationalHierarchy a owl:Class ;
    rdfs:label "Organizational Hierarchy"@en ;
    rdfs:subClassOf o4de:OrganizationalStructure ;
    skos:definition "The vertical structure of authority levels and reporting relationships"@en .

o4de:Passing a owl:Class ;
    rdfs:label "Passing"@en ;
    rdfs:seeAlso de52:Passing ;
    rdfs:subClassOf o4de:TestStatus ;
    skos:definition "The test status of a test whose result met what was expected."@en .

o4de:PatchVersion a owl:Class ;
    rdfs:label "Patch Version"@en ;
    rdfs:seeAlso de52:PatchVersion ;
    rdfs:subClassOf o4de:Version ;
    skos:definition "Version with backward-compatible fixes (x.y.Z)"@en .

o4de:PerformanceTest a owl:Class ;
    rdfs:label "Performance Test"@en ;
    rdfs:seeAlso de52:PerformanceTest ;
    rdfs:subClassOf o4de:TestType ;
    skos:definition "Validates query performance and reasoning speed"@en .

o4de:PricingManagement a owl:Class ;
    rdfs:label "Pricing Management"@en ;
    rdfs:subClassOf o4de:FinancialManagement ;
    skos:definition "The management activity that sets and adjusts prices."@en .

o4de:PricingModel a owl:Class ;
    rdfs:label "Pricing Model"@en ;
    rdfs:subClassOf o4de:PricingManagement ;
    skos:definition "A structured approach for setting prices"@en .

o4de:ProcessAnalysis a owl:Class ;
    rdfs:label "Process Analysis"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Systematic analysis of business processes and their components"@en .

o4de:ProcessClassification a owl:Class ;
    rdfs:label "Process Classification"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Categorization of business processes based on their purpose and characteristics"@en .

o4de:ProcessImprovement a owl:Class ;
    rdfs:label "Process Improvement"@en ;
    rdfs:seeAlso de52:ProcessImprovement ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:usesOptimizationMethod ] ;
    skos:definition "An effort to change a process so that it performs better in time, cost or quality."@en .

o4de:ProductPortfolio a owl:Class ;
    rdfs:label "Product Portfolio"@en ;
    rdfs:subClassOf o4de:PortfolioManagement ;
    skos:definition "A collection of products managed by the organization, with lifecycle stages, market performance and strategic positioning"@en .

o4de:ProductionDeployment a owl:Class ;
    rdfs:label "Production Deployment"@en ;
    rdfs:seeAlso de52:ProductionDeployment ;
    rdfs:subClassOf o4de:Deployment ;
    skos:definition "Live production environment deployment"@en .

o4de:PromotionalCampaign a owl:Class ;
    rdfs:label "Promotional Campaign"@en ;
    rdfs:subClassOf o4de:MarketingCampaign ;
    skos:definition "A campaign designed to promote special offers, discounts or incentives"@en .

o4de:QualityAssurance a owl:Class ;
    rdfs:label "Quality Assurance"@en ;
    rdfs:subClassOf o4de:QualityManagement ;
    skos:definition "Process-focused activities that prevent quality issues"@en .

o4de:QualityControl a owl:Class ;
    rdfs:label "Quality Control"@en ;
    rdfs:subClassOf o4de:QualityManagement ;
    skos:definition "Operational activities that verify that products and services meet quality requirements"@en .

o4de:ResponsibilityType a owl:Class ;
    rdfs:label "Responsibility Type"@en ;
    rdfs:seeAlso de52:ResponsibilityType ;
    skos:definition "A kind of responsibility, such as responsible, accountable, consulted or informed."@en .

o4de:Responsible a owl:Class ;
    rdfs:label "Responsible"@en ;
    rdfs:seeAlso de52:Responsible ;
    skos:definition "The responsibility-assignment role of the party who does the work of a work item."@en .

o4de:Retrospective a owl:Class ;
    rdfs:label "Retrospective"@en ;
    rdfs:subClassOf o4de:AgileActivity ;
    skos:definition "A regular meeting where a team reflects on its process and identifies improvements"@en .

o4de:SalesChannel a owl:Class ;
    rdfs:label "Sales Channel"@en ;
    rdfs:subClassOf o4de:Channel ;
    skos:definition "A channel through which products are sold to customers."@en .

o4de:ShouldHave a owl:Class ;
    rdfs:label "Should Have"@en ;
    rdfs:seeAlso de52:ShouldHave ;
    rdfs:subClassOf o4de:RequirementPriority ;
    owl:equivalentClass o4de:ShouldHavePriority ;
    skos:definition "The requirement priority for a requirement that is important but not essential, as named in the ontology lifecycle part."@en .

o4de:Skipped a owl:Class ;
    rdfs:label "Skipped"@en ;
    rdfs:seeAlso de52:Skipped ;
    rdfs:subClassOf o4de:TestStatus ;
    skos:definition "The test status of a test that was deliberately not executed."@en .

o4de:StagingDeployment a owl:Class ;
    rdfs:label "Staging Deployment"@en ;
    rdfs:seeAlso de52:StagingDeployment ;
    rdfs:subClassOf o4de:Deployment ;
    skos:definition "Pre-production testing environment"@en .

o4de:StockLevel a owl:Class ;
    rdfs:label "Stock Level"@en ;
    rdfs:subClassOf o4de:StockManagement ;
    skos:definition "The current quantity of a particular item held in inventory"@en .

o4de:StockManagement a owl:Class ;
    rdfs:label "Stock Management"@en ;
    rdfs:subClassOf o4de:InventoryManagement ;
    skos:definition "The management activity that controls stock levels, reordering and replenishment."@en .

o4de:SupportingCapability a owl:Class ;
    rdfs:label "Supporting Capability"@en ;
    rdfs:seeAlso de52:SupportingCapability ;
    rdfs:subClassOf o4de:BusinessCapability ;
    skos:definition "A business capability that supports the core capabilities without being a source of distinction."@en .

o4de:accountableFor a owl:ObjectProperty ;
    rdfs:label "accountable for"@en ;
    rdfs:domain o4de:Role ;
    rdfs:range o4de:WorkItem ;
    rdfs:seeAlso de52:accountableFor ;
    skos:definition "Links a role to a work item by the relation 'accountable for'."@en .

o4de:acquiresAssets a owl:ObjectProperty ;
    rdfs:label "acquiresAssets"@en ;
    rdfs:domain o4de:Organization ;
    rdfs:range o4de:AssetAcquisition ;
    rdfs:seeAlso de52:acquiresAssets ;
    skos:definition "Links an organization to an asset acquisition; the inverse of the relation 'acquiresassetsof'."@en .

o4de:activityOf a owl:ObjectProperty ;
    rdfs:label "activity of"@en ;
    rdfs:domain o4de:Activity ;
    rdfs:range o4de:Operation ;
    rdfs:seeAlso de52:activityOf ;
    owl:inverseOf o4de:hasActivity ;
    skos:definition "Links an activity to an operation; the inverse of the relation 'has activity'."@en .

o4de:administrationDomain a owl:ObjectProperty ;
    rdfs:label "administrationDomain"@en ;
    rdfs:domain o4de:Organization ;
    rdfs:range o4de:AdministrationDomain ;
    rdfs:seeAlso de52:administrationDomain ;
    skos:definition "Links an organization to an administration domain; the inverse of the relation 'administrationdomainof'."@en .

o4de:advisesChanges a owl:ObjectProperty ;
    rdfs:label "advisesChanges"@en ;
    rdfs:domain o4de:Organization ;
    rdfs:range o4de:ChangeAdvisoryBoard ;
    rdfs:seeAlso de52:advisesChanges ;
    skos:definition "Links an organization to a change advisory board; the inverse of the relation 'adviseschangesof'."@en .

o4de:agricultureDomain a owl:ObjectProperty ;
    rdfs:label "agricultureDomain"@en ;
    rdfs:domain o4de:Organization ;
    rdfs:range o4de:AgricultureDomain ;
    rdfs:seeAlso de52:agricultureDomain ;
    skos:definition "Links an organization to an agriculture domain; the inverse of the relation 'agriculturedomainof'."@en .

o4de:alternativeFeature a owl:ObjectProperty ;
    rdfs:label "alternativeFeature"@en ;
    rdfs:domain o4de:FeatureModel ;
