o4de:versionNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "version number"@en ;
    rdfs:domain o4de:Version ;
    rdfs:range xsd:string ;
    rdfs:seeAlso de52:versionNumber ;
    skos:definition "Records the version number of a version as a text."@en .

o4de:versionedAs a owl:ObjectProperty ;
    rdfs:label "versionedAs"@en ;
    rdfs:domain o4de:Requirement ;
    rdfs:range o4de:RequirementVersion ;
    rdfs:seeAlso de52:versionedAs ;
    skos:definition "Links a requirement to a requirement version; the inverse of the relation 'versionedasof'."@en .

o4de:votesQuadratically a owl:ObjectProperty ;
    rdfs:label "votesQuadratically"@en ;
    rdfs:domain o4de:DistributedAutonomousOrganization ;
    rdfs:range o4de:QuadraticVoting ;
    rdfs:seeAlso de52:votesQuadratically ;
    skos:definition "Links a dao to a quadratic voting; the inverse of the relation 'votesquadraticallyof'."@en .

o4de:votesSimply a owl:ObjectProperty ;
    rdfs:label "votesSimply"@en ;
    rdfs:domain o4de:DistributedAutonomousOrganization ;
    rdfs:range o4de:SimpleVoting ;
    rdfs:seeAlso de52:votesSimply ;
    skos:definition "Links a dao to a simple voting; the inverse of the relation 'votessimplyof'."@en .

o4de:waiting a owl:ObjectProperty ;
    rdfs:label "waiting"@en ;
    rdfs:domain o4de:Process ;
    rdfs:range o4de:Waiting ;
    rdfs:seeAlso de52:waiting ;
    skos:definition "Links a process to a waiting; the inverse of the relation 'waitingof'."@en .

o4de:warehouseLocation a owl:ObjectProperty ;
    rdfs:label "warehouseLocation"@en ;
    rdfs:domain o4de:Organization ;
    rdfs:range o4de:Warehouse ;
    rdfs:seeAlso de52:warehouseLocation ;
    skos:definition "Links an organization to a warehouse; the inverse of the relation 'warehouselocationof'."@en .

o4de:workflowAutomation a owl:ObjectProperty ;
    rdfs:label "workflowAutomation"@en ;
    rdfs:domain o4de:Process ;
    rdfs:range o4de:WorkflowAutomation ;
    rdfs:seeAlso de52:workflowAutomation ;
    skos:definition "Links a process to a workflow automation; the inverse of the relation 'workflowautomationof'."@en .

<http://www.zt4swe.io/o4de> a owl:Ontology ;
    dc:title "O4DE: Ontology for Domain Engineering (T-Box)"@en ;
    dcterms:coverage "Enterprise domain engineering" ;
    dcterms:created "2026-10-13"^^xsd:date ;
    dcterms:creator "Yusuf Altunel" ;
    dcterms:description "Classes, properties and axioms of the Ontology for Domain Engineering."@en ;
    dcterms:license <http://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    dcterms:rights "Copyright 2026 Yusuf Altunel" ;
    dcterms:subject "Agile Methodologies",
        "Business Analysis",
        "Customer Management",
        "Domain Engineering",
        "Operations Management",
        "Organizational Management",
        "Process Improvement",
        "Product Management",
        "Quality Management",
        "Strategic Planning" ;
    dcterms:title "O4DE: Ontology for Domain Engineering (T-Box)"@en ;
    rdfs:comment "O4DE is a formal ontology of domain engineering for enterprise use. It defines the activities, assets, features and variability of domain engineering, the processes, roles, rules and metrics that govern it, the business context it works in (customers, products, channels, vendors, organization and agility), and the structure of the enterprise domain itself: domain foundations, organizational taxonomy, governance, capabilities, work structure, requirements, data and technology architecture, assets, change and knowledge. It also covers the AI-assisted practice of domain engineering, the business-analysis phase that precedes technical work, and the variation of components and products. Its purpose is to give analysts and architects one shared, machine-checkable vocabulary for documenting a business domain. The class, property and taxonomy counts are reproduced by the gate script in 05-gates."@en ;
    owl:versionIRI <http://www.zt4swe.io/o4de/1.2.0> ;
    owl:versionInfo "1.2.0" .

o4de:APIDiscovery a owl:Class ;
    rdfs:label "API Discovery"@en ;
    rdfs:seeAlso de52:APIDiscovery ;
    rdfs:subClassOf o4de:DiscoveryMethod ;
    skos:definition "A discovery method that finds the interfaces of existing systems, and what they expose, to learn how a domain is automated."@en .

o4de:ActivitySummary a owl:Class ;
    rdfs:label "Activity Summary"@en ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A consolidated record of what activities were performed, when, where and with whom"@en .

o4de:AdministrationDomain a owl:Class ;
    rdfs:label "Administration Domain"@en ;
    rdfs:seeAlso de52:AdministrationDomain ;
    rdfs:subClassOf o4de:CorporateFunctionDomain ;
    skos:definition "The corporate function domain of general administration, covering office management, records and internal support."@en .

o4de:AgilityManagement a owl:Class ;
    rdfs:label "Agility Management"@en ;
    rdfs:subClassOf o4de:OrganizationalManagement ;
    skos:definition "The management activity that builds the organization's ability to respond quickly to change."@en .

o4de:AgricultureDomain a owl:Class ;
    rdfs:label "Agriculture Domain"@en ;
    rdfs:seeAlso de52:AgricultureDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of growing crops and raising livestock, together with the supply of agricultural inputs and produce."@en .

o4de:AnalyticalData a owl:Class ;
    rdfs:label "Analytical Data"@en ;
    rdfs:seeAlso de52:AnalyticalData ;
    rdfs:subClassOf o4de:DataClassification ;
    skos:definition "Data classified by its use in analysis and reporting, such as aggregates, measures and history, rather than in running transactions."@en .

o4de:ApplicationComponent a owl:Class ;
    rdfs:label "Application Component"@en ;
    rdfs:seeAlso de52:ApplicationComponent ;
    skos:definition "A modular, replaceable part of an application system that provides a defined set of functions through its interfaces."@en .

o4de:ApplicationLayer a owl:Class ;
    rdfs:label "Application Layer"@en ;
    rdfs:seeAlso de52:ApplicationLayer ;
    rdfs:subClassOf o4de:TechnologyLayer ;
    skos:definition "The layer of the technology architecture that holds application systems and the business logic they run."@en .

o4de:ArchitectureReviewBoard a owl:Class ;
    rdfs:label "Architecture Review Board"@en ;
    rdfs:seeAlso de52:ArchitectureReviewBoard ;
    rdfs:subClassOf o4de:GovernanceBoard ;
    skos:definition "A governance board that reviews architectural decisions and checks them against standards and principles."@en .

o4de:AssetAcquisition a owl:Class ;
    rdfs:label "Asset Acquisition"@en ;
    rdfs:seeAlso de52:AssetAcquisition ;
    skos:definition "The act of obtaining a physical asset, by purchase, lease or transfer, and the record of how it was obtained."@en .

o4de:AssetDisposal a owl:Class ;
    rdfs:label "Asset Disposal"@en ;
    rdfs:seeAlso de52:AssetDisposal ;
    skos:definition "The retirement of an asset from use by sale, scrapping, donation or recycling, and the record of it."@en .

o4de:AssetInsurance a owl:Class ;
    rdfs:label "Asset Insurance"@en ;
    rdfs:seeAlso de52:AssetInsurance ;
    skos:definition "The insurance cover held for an asset, with its insured value, term and insurer."@en .

o4de:AssetInventory a owl:Class ;
    rdfs:label "Asset Inventory"@en ;
    rdfs:seeAlso de52:AssetInventory ;
    skos:definition "A register of the assets an organization holds, with their identity, location and condition."@en .

o4de:AssetManager a owl:Class ;
    rdfs:label "Asset Manager"@en ;
    rdfs:seeAlso de52:AssetManager ;
    rdfs:subClassOf o4de:DomainEngineeringRole ;
    skos:definition "The domain engineering role that looks after the portfolio, quality and lifecycle of domain assets."@en .

o4de:AssetRepository a owl:Class ;
    rdfs:label "Asset Repository"@en ;
    rdfs:seeAlso de52:AssetRepository ;
    skos:definition "A store that keeps domain assets under version control so they can be found and reused."@en .

o4de:AssetTransfer a owl:Class ;
    rdfs:label "Asset Transfer"@en ;
    rdfs:seeAlso de52:AssetTransfer ;
    skos:definition "The movement of an asset from one owner, location or organizational unit to another."@en .

o4de:AssetValuation a owl:Class ;
    rdfs:label "Asset Valuation"@en ;
    rdfs:seeAlso de52:AssetValuation ;
    skos:definition "The determination of what an asset is worth, with the method and date used."@en .

o4de:AuthorizationRule a owl:Class ;
    rdfs:label "Authorization Rule"@en ;
    rdfs:seeAlso de52:AuthorizationRule ;
    rdfs:subClassOf o4de:BusinessRule ;
    skos:definition "A business rule that states who may perform an action or see information, and under which conditions."@en .

o4de:AutomationScope a owl:Class ;
    rdfs:label "Automation Scope"@en ;
    rdfs:seeAlso de52:AutomationScope ;
    skos:definition "The part of a process or domain that an automation effort is meant to cover."@en .

o4de:BestPractice a owl:Class ;
    rdfs:label "Best Practice"@en ;
    rdfs:seeAlso de52:BestPractice ;
    skos:definition "A method or approach that experience shows gives reliably good results, recorded so that others can apply it."@en .

o4de:BlockchainGovernance a owl:Class ;
    rdfs:label "Blockchain Governance"@en ;
    rdfs:seeAlso de52:BlockchainGovernance ;
    rdfs:subClassOf o4de:GovernanceFramework ;
    skos:definition "A governance framework in which rules and decisions are carried out or recorded on a distributed ledger."@en .

o4de:BusinessEnvironment a owl:Class ;
    rdfs:label "Business Environment"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "The business ecosystem, market conditions and organizational context in which the domain operates"@en .

o4de:BusinessGlossary a owl:Class ;
    rdfs:label "Business Glossary"@en ;
    rdfs:seeAlso de52:BusinessGlossary ;
    skos:definition "An agreed list of business terms with their definitions, kept so that people and systems use words the same way."@en .

o4de:BusinessLocation a owl:Class ;
    rdfs:label "Business Location"@en ;
    rdfs:seeAlso de52:BusinessLocation ;
    skos:definition "A place where an organization carries out business, such as a site, region or market."@en .

o4de:BusinessRole a owl:Class ;
    rdfs:label "Business Role"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "A set of responsibilities and authorities assigned to individuals in business processes"@en .

o4de:CalculationRule a owl:Class ;
    rdfs:label "Calculation Rule"@en ;
    rdfs:seeAlso de52:CalculationRule ;
    rdfs:subClassOf o4de:BusinessRule ;
    skos:definition "A business rule that defines how a value is computed from other values."@en .

o4de:CenturyOrganization a owl:Class ;
    rdfs:label "Century Organization"@en ;
    rdfs:seeAlso de52:CenturyOrganization ;
    rdfs:subClassOf o4de:LegacyOrganization ;
    skos:definition "An organization age class for an organization that is 100 years old or more."@en .

o4de:ChangeAdvisoryBoard a owl:Class ;
    rdfs:label "Change Advisory Board"@en ;
    rdfs:seeAlso de52:ChangeAdvisoryBoard ;
    rdfs:subClassOf o4de:GovernanceBoard ;
    skos:definition "A governance board that assesses proposed changes and advises on their approval and timing."@en .

o4de:ChangeImpactAssessment a owl:Class ;
    rdfs:label "Change Impact Assessment"@en ;
    rdfs:seeAlso de52:ChangeImpactAssessment ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:analyzesStakeholders ] ;
    skos:definition "The analysis that identifies and judges the effects of a proposed change before it is decided."@en .

o4de:ChangeManagement a owl:Class ;
    rdfs:label "Change Management"@en ;
    rdfs:seeAlso de52:ChangeManagement ;
    rdfs:subClassOf o4de:Process ;
    skos:definition "The process of proposing, assessing, approving, carrying out and reviewing changes in a controlled way."@en .

o4de:ClinicalCareDomain a owl:Class ;
    rdfs:label "Clinical Care Domain"@en ;
    rdfs:seeAlso de52:ClinicalCareDomain ;
    rdfs:subClassOf o4de:HealthcareDomain ;
    skos:definition "The healthcare domain of direct patient care, covering diagnosis, treatment and follow-up."@en .

o4de:CloudBasedDelivery a owl:Class ;
    rdfs:label "Cloud-Based Delivery"@en ;
    rdfs:seeAlso de52:CloudBasedDelivery ;
    rdfs:subClassOf o4de:ServiceDeliveryModel ;
    skos:definition "A service delivery model in which a service is provided from cloud infrastructure."@en .

o4de:CloudNativeSystem a owl:Class ;
    rdfs:label "Cloud-Native System"@en ;
    rdfs:seeAlso de52:CloudNativeSystem ;
    rdfs:subClassOf o4de:ApplicationSystem ;
    skos:definition "An application system designed to run in the cloud, using services such as containers and managed platforms."@en .

o4de:CodeMining a owl:Class ;
    rdfs:label "Code Mining"@en ;
    rdfs:seeAlso de52:CodeMining ;
    rdfs:subClassOf o4de:DiscoveryMethod ;
    skos:definition "A discovery method that reads existing source code to recover the rules, data and structure of a domain."@en .

o4de:CommoditizedDomain a owl:Class ;
    rdfs:label "Commoditized Domain"@en ;
    rdfs:seeAlso de52:CommoditizedDomain ;
    rdfs:subClassOf o4de:DomainMaturity ;
    skos:definition "A domain maturity level at which the domain is so well known that its products and services are standard and interchangeable."@en .

o4de:CommunicationPlan a owl:Class ;
    rdfs:label "Communication Plan"@en ;
    rdfs:seeAlso de52:CommunicationPlan ;
    skos:definition "A plan that says what is communicated about a change, to whom, when and by which means."@en .

o4de:ComplianceMetric a owl:Class ;
    rdfs:label "Compliance Metric"@en ;
    rdfs:seeAlso de52:ComplianceMetric ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures how far activities or systems meet a rule, standard or regulation."@en .

o4de:Conception a owl:Class ;
    rdfs:label "Conception"@en ;
    rdfs:seeAlso de52:Conception ;
    rdfs:subClassOf o4de:OrganizationalLifecyclePhase ;
    skos:definition "The organizational lifecycle phase in which the idea for an organization is formed, before it is set up."@en .

o4de:ConceptualERD a owl:Class ;
    rdfs:label "Conceptual Entity-Relationship Diagram"@en ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    rdfs:subClassOf o4de:ConceptualModel ;
    skos:definition "A high-level entity-relationship diagram that defines the main entities of a domain and their relationships, without attributes or primary keys."@en .

o4de:ConstructionDomain a owl:Class ;
    rdfs:label "Construction Domain"@en ;
    rdfs:seeAlso de52:ConstructionDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of building and civil works, from design and procurement to site work."@en .

o4de:ConsultingDomain a owl:Class ;
    rdfs:label "Consulting Domain"@en ;
    rdfs:seeAlso de52:ConsultingDomain ;
    rdfs:subClassOf o4de:ProfessionalServicesDomain ;
    skos:definition "The professional services domain of giving expert advice to client organizations."@en .

o4de:ContinuousImprovement a owl:Class ;
    rdfs:label "Continuous Improvement"@en ;
    rdfs:seeAlso de52:ContinuousImprovement ;
    skos:definition "An ongoing effort to improve processes in small steps, based on measurement and feedback."@en .

o4de:Cost a owl:Class ;
    rdfs:label "Cost"@en ;
    rdfs:subClassOf o4de:CostManagement ;
    skos:definition "An amount of money spent to acquire or maintain something"@en .

o4de:CostManagement a owl:Class ;
    rdfs:label "Cost Management"@en ;
    rdfs:subClassOf o4de:FinancialManagement ;
    skos:definition "The management activity that plans, records and controls costs."@en .

o4de:CostReduction a owl:Class ;
    rdfs:label "Cost Reduction"@en ;
    rdfs:seeAlso de52:CostReduction ;
    rdfs:subClassOf o4de:AutomationBenefit ;
    skos:definition "An automation benefit measured as a fall in the cost of carrying out work."@en .

o4de:CrisisTrigger a owl:Class ;
    rdfs:label "Crisis Trigger"@en ;
    rdfs:seeAlso de52:CrisisTrigger ;
    rdfs:subClassOf o4de:LifecycleTransitionTrigger ;
    skos:definition "A lifecycle transition trigger in which a crisis forces an organization into a new phase."@en .

o4de:CrossCuttingConcern a owl:Class ;
    rdfs:label "Cross-Cutting Concern"@en ;
    rdfs:seeAlso de52:CrossCuttingConcern ;
    skos:definition "A concern, such as security or logging, that affects many parts of a domain and cannot be placed in one of them."@en .

o4de:CustomerJourney a owl:Class ;
    rdfs:label "Customer Journey"@en ;
    rdfs:subClassOf o4de:CustomerExperience ;
    skos:definition "The sequence of experiences a customer has across all touchpoints"@en .

o4de:CustomerRelationshipCapability a owl:Class ;
    rdfs:label "Customer Relationship Capability"@en ;
    rdfs:seeAlso de52:CustomerRelationshipCapability ;
    rdfs:subClassOf o4de:CoreCapability ;
    skos:definition "The core capability of building and keeping relationships with customers."@en .

o4de:CustomerSatisfactionMetric a owl:Class ;
    rdfs:label "Customer Satisfaction Metric"@en ;
    rdfs:seeAlso de52:CustomerSatisfactionMetric ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures how satisfied customers are, such as a satisfaction score or net promoter score."@en .

o4de:CustomerService a owl:Class ;
    rdfs:label "Customer Service"@en ;
    rdfs:seeAlso de52:CustomerService ;
    rdfs:subClassOf o4de:BusinessService ;
    skos:definition "A business service that helps customers before and after a purchase."@en .

o4de:DataAttribute a owl:Class ;
    rdfs:label "Data Attribute"@en ;
    rdfs:seeAlso de52:DataAttribute ;
    skos:definition "A named property of a data entity that holds one kind of value, such as a customer's date of birth."@en .

o4de:DataAutomation a owl:Class ;
    rdfs:label "Data Automation"@en ;
    rdfs:seeAlso de52:DataAutomation ;
    rdfs:subClassOf o4de:AutomationTechnique ;
    skos:definition "An automation technique that carries out data tasks, such as collection, cleaning and transfer, without manual work."@en .

o4de:DataCenter a owl:Class ;
    rdfs:label "Data Center"@en ;
    rdfs:seeAlso de52:DataCenter ;
    rdfs:subClassOf o4de:Facility ;
    skos:definition "A facility that houses computing, storage and network equipment."@en .

o4de:DataDictionary a owl:Class ;
    rdfs:label "Data Dictionary"@en ;
    rdfs:seeAlso de52:DataDictionary ;
    skos:definition "A catalogue that describes the data elements of a domain: their names, meaning, type and allowed values."@en .

o4de:DataLayer a owl:Class ;
    rdfs:label "Data Layer"@en ;
    rdfs:seeAlso de52:DataLayer ;
    rdfs:subClassOf o4de:TechnologyLayer ;
    skos:definition "The layer of the technology architecture that stores and serves data."@en .

o4de:DataProfiling a owl:Class ;
    rdfs:label "Data Profiling"@en ;
    rdfs:seeAlso de52:DataProfiling ;
    skos:definition "A discovery method that examines the actual contents of data to find its structure, quality and patterns."@en .

o4de:DatabaseReverseEngineering a owl:Class ;
    rdfs:label "Database Reverse Engineering"@en ;
    rdfs:seeAlso de52:DatabaseReverseEngineering ;
    rdfs:subClassOf o4de:DiscoveryMethod ;
    skos:definition "A discovery method that reads the structure of an existing database to recover the data model behind it."@en .

o4de:DecisionAutomation a owl:Class ;
    rdfs:label "Decision Automation"@en ;
    rdfs:seeAlso de52:DecisionAutomation ;
    rdfs:subClassOf o4de:AutomationTechnique ;
    skos:definition "An automation technique that makes or proposes decisions by applying rules or models."@en .

o4de:DecisionLogic a owl:Class ;
    rdfs:label "Decision Logic"@en ;
    rdfs:seeAlso de52:DecisionLogic ;
    skos:definition "The rules, conditions and calculations by which a decision is reached."@en .

o4de:DecisionPoint a owl:Class ;
    rdfs:label "Decision Point"@en ;
    rdfs:seeAlso de52:DecisionPoint ;
    skos:definition "A place in a process at which a choice is made between different ways forward."@en .

o4de:DefectDensity a owl:Class ;
    rdfs:label "Defect Density"@en ;
    rdfs:seeAlso de52:DefectDensity ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric giving the number of defects found per unit of size of a deliverable."@en .

o4de:Defects a owl:Class ;
    rdfs:label "Defects"@en ;
    rdfs:seeAlso de52:Defects ;
    rdfs:subClassOf o4de:ProcessWaste ;
    skos:definition "The process waste of products or work that is faulty and must be corrected or discarded."@en .

o4de:DepartmentDissolution a owl:Class ;
    rdfs:label "Department Dissolution"@en ;
    rdfs:seeAlso de52:DepartmentDissolution ;
    rdfs:subClassOf o4de:DepartmentLifecyclePhase ;
    skos:definition "The department lifecycle phase in which a department is closed and its work is moved or ended."@en .

o4de:DepartmentFormation a owl:Class ;
    rdfs:label "Department Formation"@en ;
    rdfs:seeAlso de52:DepartmentFormation ;
    rdfs:subClassOf o4de:DepartmentLifecyclePhase ;
    skos:definition "The department lifecycle phase in which a department is set up, staffed and given its mandate."@en .

o4de:DepartmentGrowth a owl:Class ;
    rdfs:label "Department Growth"@en ;
    rdfs:seeAlso de52:DepartmentGrowth ;
    rdfs:subClassOf o4de:DepartmentLifecyclePhase ;
    skos:definition "The department lifecycle phase in which a department takes on more work, people and scope."@en .

o4de:DepartmentMaturity a owl:Class ;
    rdfs:label "Department Maturity"@en ;
    rdfs:seeAlso de52:DepartmentMaturity ;
    rdfs:subClassOf o4de:DepartmentLifecyclePhase ;
    skos:definition "The department lifecycle phase in which a department works steadily with established practice."@en .

o4de:DepartmentRestructuring a owl:Class ;
    rdfs:label "Department Restructuring"@en ;
    rdfs:seeAlso de52:DepartmentRestructuring ;
    rdfs:subClassOf o4de:DepartmentLifecyclePhase ;
    skos:definition "The department lifecycle phase in which a department's structure, size or mandate is reorganized."@en .

o4de:DesignPattern a owl:Class ;
    rdfs:label "Design Pattern"@en ;
    rdfs:seeAlso de52:DesignPattern ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A reusable solution to a commonly met design problem, recorded as a domain asset."@en .

o4de:DigitalTwin a owl:Class ;
    rdfs:label "Digital Twin"@en ;
    rdfs:seeAlso de52:DigitalTwin ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:digitalTwinOf ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:digitalTwinOf ],
        o4de:DomainAsset ;
    skos:definition "A digital counterpart of a physical asset or system, kept in step with it so that it can be monitored and studied."@en .

o4de:DistributedDecision a owl:Class ;
    rdfs:label "Distributed Decision"@en ;
    rdfs:seeAlso de52:DistributedDecision ;
    skos:definition "A decision reached by several parties each taking part, rather than by a single authority."@en .

o4de:Documentation a owl:Class ;
    rdfs:label "Documentation"@en ;
    rdfs:seeAlso de52:Documentation ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A domain asset made of written or recorded material that describes a domain, system or process."@en .

o4de:DocumentationMining a owl:Class ;
    rdfs:label "Documentation Mining"@en ;
    rdfs:seeAlso de52:DocumentationMining ;
    rdfs:subClassOf o4de:DiscoveryMethod ;
    skos:definition "A discovery method that reads existing documents to extract the concepts, rules and processes of a domain."@en .

o4de:DomainArchitect a owl:Class ;
    rdfs:label "Domain Architect"@en ;
    rdfs:seeAlso de52:DomainArchitect ;
    rdfs:subClassOf o4de:DomainEngineeringRole,
        o4de:Role ;
    skos:definition "A role responsible for the architecture and design decisions of domain assets."@en .

o4de:DomainBoundary a owl:Class ;
    rdfs:label "Domain Boundary"@en ;
    rdfs:seeAlso de52:DomainBoundary ;
    skos:definition "The line that separates what belongs to a domain from what lies outside it."@en .

o4de:DomainEngineer a owl:Class ;
    rdfs:label "Domain Engineer"@en ;
    rdfs:seeAlso de52:DomainEngineer ;
    rdfs:subClassOf o4de:DomainEngineeringRole ;
    skos:definition "The domain engineering role that analyses a domain and builds its reusable models and assets."@en .

o4de:DomainEngineeringPhase a owl:Class ;
    rdfs:label "Domain Engineering Phase"@en,
        "İş Alanı Mühendisliği"@tr ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o4de:producesArtifact ;
            owl:someValuesFrom o4de:BusinessDomain ],
        [ a owl:Restriction ;
            owl:onProperty o4de:hasKeyProcess ;
            owl:someValuesFrom o4de:BusinessAnalysis ],
        [ a owl:Restriction ;
            owl:onProperty o4de:hasKeyProcess ;
            owl:someValuesFrom o4de:BusinessProcessModeling ],
        [ a owl:Restriction ;
            owl:onProperty o4de:producesArtifact ;
            owl:someValuesFrom o4de:DomainOntology ],
        [ a owl:Restriction ;
            owl:onProperty o4de:producesArtifact ;
            owl:someValuesFrom o4de:BusinessProcessModel ],
        [ a owl:Restriction ;
            owl:onProperty o4de:producesArtifact ;
            owl:someValuesFrom o4de:BusinessArchitecture ],
        [ a owl:Restriction ;
            owl:onProperty o4de:producesArtifact ;
            owl:someValuesFrom o4de:ConceptualERD ],
        o4de:ProcessPhase ;
    skos:definition "The initial phase of a software process, in which the business context is understood and modelled at a high level before the technical phases begin."@en .

o4de:DomainExpert a owl:Class ;
    rdfs:label "Domain Expert"@en ;
    rdfs:seeAlso de52:DomainExpert ;
    rdfs:subClassOf o4de:Stakeholder ;
    skos:definition "A stakeholder who knows the domain deeply and can explain its concepts and rules."@en .

o4de:DomainExpertSource a owl:Class ;
    rdfs:label "Domain Expert Source"@en ;
    rdfs:seeAlso de52:DomainExpertSource ;
    rdfs:subClassOf o4de:KnowledgeSource ;
    skos:definition "A knowledge source made up of the domain experts who can be asked."@en .

o4de:DomainModelingTool a owl:Class ;
    rdfs:label "Domain Modeling Tool"@en ;
    rdfs:seeAlso de52:DomainModelingTool ;
    rdfs:subClassOf o4de:Tool ;
    skos:definition "A tool used to build, edit and check models of a domain."@en .

o4de:DomainOntology a owl:Class ;
    rdfs:label "Domain Ontology"@en ;
