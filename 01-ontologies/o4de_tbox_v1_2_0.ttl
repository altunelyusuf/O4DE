            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:catalogsExperts ] ;
    skos:definition "A directory that shows who in an organization knows about which subjects."@en .

o4de:ExternalEvent a owl:Class ;
    rdfs:label "External Event"@en ;
    rdfs:seeAlso de52:ExternalEvent ;
    rdfs:subClassOf o4de:BusinessEvent ;
