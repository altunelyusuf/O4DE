o4de:InnovationMetric a owl:Class ;
    rdfs:label "Innovation Metric"@en ;
    rdfs:seeAlso de52:InnovationMetric ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures how much and how well an organization produces new ideas, products or methods."@en .

o4de:IntegrationAutomation a owl:Class ;
    rdfs:label "Integration Automation"@en ;
    rdfs:seeAlso de52:IntegrationAutomation ;
    rdfs:subClassOf o4de:AutomationTechnique ;
    skos:definition "An automation technique that connects systems and passes work between them without manual steps."@en .

o4de:IntegrationLayer a owl:Class ;
    rdfs:label "Integration Layer"@en ;
    rdfs:seeAlso de52:IntegrationLayer ;
    rdfs:subClassOf o4de:TechnologyLayer ;
