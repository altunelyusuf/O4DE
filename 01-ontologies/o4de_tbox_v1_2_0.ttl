o4de:KnowledgeBase a owl:Class ;
    rdfs:label "Knowledge Base"@en ;
    rdfs:seeAlso de52:KnowledgeBase ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:appliesBestPractice ] ;
    skos:definition "An organized store of knowledge that people or systems can search and use."@en .

o4de:KnowledgeManagement a owl:Class ;
    rdfs:label "Knowledge Management"@en ;
    rdfs:seeAlso de52:KnowledgeManagement ;
