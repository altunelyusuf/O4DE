o4de:MaturityAndOptimization a owl:Class ;
    rdfs:label "Maturity and Optimization"@en ;
    rdfs:seeAlso de52:MaturityAndOptimization ;
    rdfs:subClassOf o4de:OrganizationalLifecyclePhase ;
