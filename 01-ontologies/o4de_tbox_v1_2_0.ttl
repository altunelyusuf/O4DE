    rdfs:seeAlso de52:EnterpriseOrganization ;
    rdfs:subClassOf o4de:OrganizationSize ;
    skos:definition "1,000-9,999 employees"@en .

o4de:EventDrivenArchitecture a owl:Class ;
    rdfs:label "Event-Driven Architecture"@en ;
    rdfs:seeAlso de52:EventDrivenArchitecture ;
    skos:definition "An architecture in which components communicate by producing and reacting to events."@en .

o4de:EvolutionAndRenewal a owl:Class ;
    rdfs:label "Evolution and Renewal"@en ;
    rdfs:seeAlso de52:EvolutionAndRenewal ;
    rdfs:subClassOf o4de:OrganizationalLifecyclePhase ;
    skos:definition "The organizational lifecycle phase in which an organization changes itself to stay relevant."@en .

o4de:EvolvingDomain a owl:Class ;
    rdfs:label "Evolving Domain"@en ;
    rdfs:seeAlso de52:EvolvingDomain ;
    rdfs:subClassOf o4de:DomainMaturity ;
    skos:definition "A domain maturity level at which a domain is established but still changes in notable ways."@en .

o4de:ExpertKnowledgeElicitation a owl:Class ;
