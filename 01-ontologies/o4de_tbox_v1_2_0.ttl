o4de:EffectivenessMetric a owl:Class ;
    rdfs:label "Effectiveness Metric"@en ;
    rdfs:seeAlso de52:EffectivenessMetric ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures how well something achieves its intended result."@en .

o4de:EfficiencyMetric a owl:Class ;
    rdfs:label "Efficiency Metric"@en ;
    rdfs:seeAlso de52:EfficiencyMetric ;
    rdfs:subClassOf o4de:Metric ;
