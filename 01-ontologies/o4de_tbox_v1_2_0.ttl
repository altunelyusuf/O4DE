o4de:LessonsLearnedRepository a owl:Class ;
    rdfs:label "Lessons Learned Repository"@en ;
    rdfs:seeAlso de52:LessonsLearnedRepository ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:repositsLessons ] ;
    skos:definition "A repository that collects lessons learned so that they can be searched and reused."@en .

o4de:LifecyclePhase a owl:Class ;
    rdfs:label "Lifecycle Phase"@en ;
    rdfs:seeAlso de52:LifecyclePhase ;
    skos:definition "A stage in the life of an organization or of one of its units."@en .

o4de:LocalScope a owl:Class ;
    rdfs:label "Local Scope"@en ;
    rdfs:seeAlso de52:LocalScope ;
    rdfs:subClassOf o4de:GeographicScope ;
