o4de:Guideline a owl:Class ;
    rdfs:label "Guideline"@en ;
    rdfs:seeAlso de52:Guideline ;
    skos:definition "A recommended way of acting that is not binding the way a policy or standard is."@en .

o4de:HospitalityDomain a owl:Class ;
