o4de:OntologyEditor a owl:Class ;
    rdfs:label "Ontology Editor"@en ;
    rdfs:seeAlso de52:OntologyEditor ;
    rdfs:subClassOf o4de:DomainEngineeringTool,
        o4de:Tool ;
    skos:definition "A tool for creating and editing ontologies."@en .

o4de:OperatingModel a owl:Class ;
    rdfs:label "Operating Model"@en ;
    rdfs:seeAlso de52:OperatingModel ;
    skos:definition "A description of how an organization is arranged to deliver value: its processes, people, technology and locations."@en .

o4de:OperationalArchitecture a owl:Class ;
    rdfs:label "Operational Architecture"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "The structural design of business operations, workflows and organizational elements"@en .

o4de:OperationalCapability a owl:Class ;
    rdfs:label "Operational Capability"@en ;
    rdfs:seeAlso de52:OperationalCapability ;
    skos:definition "A capability that concerns the daily running of the business."@en .

o4de:Operations24x7 a owl:Class ;
    rdfs:label "24x7 Operations"@en ;
    rdfs:seeAlso de52:Operations24x7 ;
    rdfs:subClassOf o4de:OperationalCharacteristic ;
    skos:definition "An operational characteristic of an organization that runs without pause, every hour of every day."@en .

o4de:OutsourcedDelivery a owl:Class ;
    rdfs:label "Outsourced Delivery"@en ;
    rdfs:seeAlso de52:OutsourcedDelivery ;
    rdfs:subClassOf o4de:ServiceDeliveryModel ;
    skos:definition "A service delivery model in which an external provider delivers the service."@en .

o4de:Overprocessing a owl:Class ;
    rdfs:label "Overprocessing"@en ;
    rdfs:seeAlso de52:Overprocessing ;
    rdfs:subClassOf o4de:ProcessWaste ;
    skos:definition "The process waste of doing more work, or higher quality, than the customer needs."@en .

o4de:Overproduction a owl:Class ;
    rdfs:label "Overproduction"@en ;
    rdfs:seeAlso de52:Overproduction ;
    rdfs:subClassOf o4de:ProcessWaste ;
    skos:definition "The process waste of making more than is needed or sooner than it is needed."@en .

o4de:ParallelExecution a owl:Class ;
    rdfs:label "Parallel Execution"@en ;
    rdfs:seeAlso de52:ParallelExecution ;
    skos:definition "A way of carrying out work in which several steps run at the same time."@en .

o4de:PartnerService a owl:Class ;
    rdfs:label "Partner Service"@en ;
    rdfs:seeAlso de52:PartnerService ;
    rdfs:subClassOf o4de:BusinessService ;
    skos:definition "A business service provided with or by a partner organization."@en .

o4de:Performance a owl:Class ;
    rdfs:label "Performance"@en ;
    rdfs:seeAlso de52:Performance ;
    rdfs:subClassOf o4de:QualityAttribute ;
    skos:definition "The quality attribute of how quickly and efficiently a system carries out its work."@en .

o4de:PhygitalAsset a owl:Class ;
    rdfs:label "Phygital Asset"@en ;
    rdfs:seeAlso de52:PhygitalAsset ;
    skos:definition "An asset that joins a physical object with a digital counterpart or service."@en .

o4de:PortfolioManagement a owl:Class ;
    rdfs:label "Portfolio Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Systematic management of products and services throughout their lifecycles"@en .

o4de:PresentationLayer a owl:Class ;
    rdfs:label "Presentation Layer"@en ;
    rdfs:seeAlso de52:PresentationLayer ;
    rdfs:subClassOf o4de:TechnologyLayer ;
    skos:definition "The layer of the technology architecture through which users see and operate the system."@en .

o4de:Procedure a owl:Class ;
    rdfs:label "Procedure"@en ;
    rdfs:seeAlso de52:Procedure ;
    skos:definition "A set of steps that describes how a given task is to be carried out."@en .

o4de:ProcessMining a owl:Class ;
    rdfs:label "Process Mining"@en ;
    rdfs:seeAlso de52:ProcessMining ;
    rdfs:subClassOf o4de:DiscoveryMethod ;
    skos:definition "A discovery method that reconstructs real processes from the event records of information systems."@en .

o4de:ProcessModelingTool a owl:Class ;
    rdfs:label "Process Modeling Tool"@en ;
    rdfs:seeAlso de52:ProcessModelingTool ;
    rdfs:subClassOf o4de:Tool ;
    skos:definition "A tool used to draw, analyse and simulate process models."@en .

o4de:ProcessOwner a owl:Class ;
    rdfs:label "Process Owner"@en ;
    rdfs:seeAlso de52:ProcessOwner ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:accountableFor ],
        o4de:Role ;
    skos:definition "A role accountable for the design and results of a process from end to end."@en .

o4de:ProcessPhase a owl:Class ;
    rdfs:label "Process Phase"@en ;
    dcterms:source "Owner's UAISE draft, section 2.1 (extract)" ;
    skos:definition "A stage of a software or business process, taken as a whole with its own purpose and products."@en .

o4de:ProcessReengineering a owl:Class ;
    rdfs:label "Process Reengineering"@en ;
    rdfs:seeAlso de52:ProcessReengineering ;
    skos:definition "A radical redesign of a process to achieve large gains in performance."@en .

o4de:ProcurementDomain a owl:Class ;
    rdfs:label "Procurement Domain"@en ;
    rdfs:seeAlso de52:ProcurementDomain ;
    rdfs:subClassOf o4de:CorporateFunctionDomain ;
    skos:definition "The corporate function domain of buying goods and services for an organization."@en .

o4de:ProductConfiguration a owl:Class ;
    rdfs:label "Product Configuration"@en ;
    rdfs:seeAlso de52:ProductConfiguration ;
    skos:definition "A particular choice of features and options that defines one version of a product."@en .

o4de:ProductDevelopmentCapability a owl:Class ;
    rdfs:label "Product Development Capability"@en ;
    rdfs:seeAlso de52:ProductDevelopmentCapability ;
    rdfs:subClassOf o4de:CoreCapability ;
    skos:definition "The core capability of designing and bringing new products to market."@en .

o4de:ProductLifecycle a owl:Class ;
    rdfs:label "Product Lifecycle"@en ;
    skos:definition "The progression of a product through distinct phases from development to discontinuation"@en .

o4de:ProductLineManager a owl:Class ;
    rdfs:label "Product Line Manager"@en ;
    rdfs:seeAlso de52:ProductLineManager ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:managesProductLine ],
        o4de:DomainEngineeringRole ;
    skos:definition "The domain engineering role that manages a product line and its common assets."@en .

o4de:ProductionEquipment a owl:Class ;
    rdfs:label "Production Equipment"@en ;
    rdfs:seeAlso de52:ProductionEquipment ;
    rdfs:subClassOf o4de:Equipment ;
    skos:definition "Equipment used to make goods."@en .

o4de:ProductivityMetric a owl:Class ;
    rdfs:label "Productivity Metric"@en ;
    rdfs:seeAlso de52:ProductivityMetric ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures output in relation to the input used."@en .

o4de:ProposalSystem a owl:Class ;
    rdfs:label "Proposal System"@en ;
    rdfs:seeAlso de52:ProposalSystem ;
    skos:definition "A mechanism by which members put forward proposals for decision in a governance framework."@en .

o4de:QualityAssuranceDomain a owl:Class ;
    rdfs:label "Quality Assurance Domain"@en ;
    rdfs:seeAlso de52:QualityAssuranceDomain ;
    rdfs:subClassOf o4de:CorporateFunctionDomain ;
    skos:definition "The corporate function domain of making sure that products and processes meet quality requirements."@en .

o4de:ROI a owl:Class ;
    rdfs:label "ROI"@en ;
    rdfs:seeAlso de52:ROI ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "The return on investment: a metric comparing the gain from an investment with its cost."@en .

o4de:RealEstateDomain a owl:Class ;
    rdfs:label "Real Estate Domain"@en ;
    rdfs:seeAlso de52:RealEstateDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of buying, selling, leasing and managing land and buildings."@en .

o4de:ReferenceData a owl:Class ;
    rdfs:label "Reference Data"@en ;
    rdfs:seeAlso de52:ReferenceData ;
    rdfs:subClassOf o4de:DataClassification ;
    skos:definition "Data classified as the fixed lists of values used to categorise other data, such as country codes."@en .

o4de:RegionalScope a owl:Class ;
    rdfs:label "Regional Scope"@en ;
    rdfs:seeAlso de52:RegionalScope ;
    rdfs:subClassOf o4de:GeographicScope ;
    skos:definition "A geographic scope in which the organization operates in one region of a country or continent."@en .

o4de:Reliability a owl:Class ;
    rdfs:label "Reliability"@en ;
    rdfs:seeAlso de52:Reliability ;
    rdfs:subClassOf o4de:QualityAttribute ;
    skos:definition "The quality attribute of how consistently a system performs without failure."@en .

o4de:RemoteFirst a owl:Class ;
    rdfs:label "Remote-First"@en ;
    rdfs:seeAlso de52:RemoteFirst ;
    rdfs:subClassOf o4de:OperationalCharacteristic ;
    skos:definition "An operational characteristic of an organization whose staff work mainly from remote locations."@en .

o4de:RequirementVersion a owl:Class ;
    rdfs:label "Requirement Version"@en ;
    rdfs:seeAlso de52:RequirementVersion ;
    skos:definition "A recorded state of a requirement at a point in its history."@en .

o4de:RequirementsManagementTool a owl:Class ;
    rdfs:label "Requirements Management Tool"@en ;
    rdfs:seeAlso de52:RequirementsManagementTool ;
    rdfs:subClassOf o4de:Tool ;
    skos:definition "A tool for capturing, organizing and tracing requirements."@en .

o4de:RiskManagementDomain a owl:Class ;
    rdfs:label "Risk Management Domain"@en ;
    rdfs:seeAlso de52:RiskManagementDomain ;
    rdfs:subClassOf o4de:CorporateFunctionDomain ;
    skos:definition "The corporate function domain of identifying, assessing and controlling risks."@en .

o4de:RoboticProcessAutomation a owl:Class ;
    rdfs:label "RPA"@en ;
    rdfs:seeAlso de52:RoboticProcessAutomation ;
    rdfs:subClassOf o4de:AutomationTechnique ;
    skos:definition "An automation technique in which software robots carry out repetitive tasks that people do through a user interface."@en .

o4de:SalesDomain a owl:Class ;
    rdfs:label "Sales Domain"@en ;
    rdfs:seeAlso de52:SalesDomain ;
    rdfs:subClassOf o4de:CorporateFunctionDomain ;
    skos:definition "The corporate function domain of selling an organization's products and services to customers."@en .

o4de:Scalability a owl:Class ;
    rdfs:label "Scalability"@en ;
    rdfs:seeAlso de52:Scalability ;
    rdfs:subClassOf o4de:QualityAttribute,
        o4de:VariationCapacityProperty ;
    skos:definition "The quality attribute of how well a system copes with growing load by adding resources."@en .

o4de:ScalabilityImprovement a owl:Class ;
    rdfs:label "Scalability Improvement"@en ;
    rdfs:seeAlso de52:ScalabilityImprovement ;
    rdfs:subClassOf o4de:AutomationBenefit ;
    skos:definition "An automation benefit measured as an increased ability to handle growing volumes of work."@en .

o4de:Scenario a owl:Class ;
    rdfs:label "Scenario"@en ;
    rdfs:seeAlso de52:Scenario ;
    skos:definition "A description of a sequence of events or interactions in a particular situation."@en .

o4de:SeasonalOperations a owl:Class ;
    rdfs:label "Seasonal Operations"@en ;
    rdfs:seeAlso de52:SeasonalOperations ;
    rdfs:subClassOf o4de:OperationalCharacteristic ;
    skos:definition "An operational characteristic of an organization whose activity varies strongly with the season."@en .

o4de:Security a owl:Class ;
    rdfs:label "Security"@en ;
    rdfs:seeAlso de52:Security ;
    rdfs:subClassOf o4de:QualityAttribute ;
    skos:definition "The quality attribute of how well a system protects data and functions from unauthorized access or harm."@en .

o4de:SensitiveData a owl:Class ;
    rdfs:label "Sensitive Data"@en ;
    rdfs:seeAlso de52:SensitiveData ;
    rdfs:subClassOf o4de:DataClassification ;
    skos:definition "Data classified as needing special protection because its disclosure could cause harm."@en .

o4de:SequentialExecution a owl:Class ;
    rdfs:label "Sequential Execution"@en ;
    rdfs:seeAlso de52:SequentialExecution ;
    skos:definition "A way of carrying out work in which each step starts only when the previous one has finished."@en .

o4de:ServiceContract a owl:Class ;
    rdfs:label "Service Contract"@en ;
    rdfs:seeAlso de52:ServiceContract ;
    skos:definition "An agreement that states what a service provides and what its user must supply or accept."@en .

o4de:SingleLocation a owl:Class ;
    rdfs:label "Single Location"@en ;
    rdfs:seeAlso de52:SingleLocation ;
    rdfs:subClassOf o4de:OperationalCharacteristic ;
    skos:definition "An operational characteristic of an organization that works from one site."@en .

o4de:SmallOrganization a owl:Class ;
    rdfs:label "Small Organization"@en ;
    rdfs:seeAlso de52:SmallOrganization ;
    rdfs:subClassOf o4de:OrganizationSize ;
    skos:definition "An organization size class for an organization with between 10 and 49 employees."@en .

o4de:SolutionProvider a owl:Class ;
    rdfs:label "Solution Provider"@en ;
    rdfs:subClassOf o4de:Stakeholder ;
    skos:definition "Any organization that provides solutions, services or expertise relevant to domain engineering"@en .

o4de:SportsEntertainmentDomain a owl:Class ;
    rdfs:label "Sports & Entertainment Domain"@en ;
    rdfs:seeAlso de52:SportsEntertainmentDomain ;
    rdfs:subClassOf o4de:MediaEntertainmentDomain ;
    skos:definition "The media and entertainment domain of sport events, clubs and the services around them."@en .

o4de:StakeholderImpactAnalysis a owl:Class ;
    rdfs:label "Stakeholder Impact Analysis"@en ;
    rdfs:seeAlso de52:StakeholderImpactAnalysis ;
    skos:definition "The analysis of how a change affects each stakeholder and how they are likely to respond."@en .

o4de:Standard a owl:Class ;
    rdfs:label "Standard"@en ;
    rdfs:seeAlso de52:Standard ;
    skos:definition "A document that sets out agreed specifications or practices to be followed."@en .

o4de:StartupOrganization a owl:Class ;
    rdfs:label "Startup Organization"@en ;
    rdfs:seeAlso de52:StartupOrganization ;
    rdfs:subClassOf o4de:OrganizationAge ;
    skos:definition "An organization age class for an organization that is less than 2 years old."@en .

o4de:StaticAnalysis a owl:Class ;
    rdfs:label "Static Analysis"@en ;
    rdfs:seeAlso de52:StaticAnalysis ;
    skos:definition "A discovery method that studies artifacts such as code or models without running them."@en .

o4de:SteeringCommittee a owl:Class ;
    rdfs:label "Steering Committee"@en ;
    rdfs:seeAlso de52:SteeringCommittee ;
    rdfs:subClassOf o4de:GovernanceBoard ;
    skos:definition "A governance board that guides a programme or initiative and decides on its direction."@en .

o4de:Store a owl:Class ;
    rdfs:label "Store"@en ;
    rdfs:seeAlso de52:Store ;
    rdfs:subClassOf o4de:Facility ;
    skos:definition "A facility in which goods are sold to customers."@en .

o4de:SunsetAndClosure a owl:Class ;
    rdfs:label "Sunset and Closure"@en ;
    rdfs:seeAlso de52:SunsetAndClosure ;
    rdfs:subClassOf o4de:OrganizationalLifecyclePhase ;
    skos:definition "The organizational lifecycle phase in which an organization winds down its activities and closes."@en .

o4de:SupplyChainCapability a owl:Class ;
    rdfs:label "Supply Chain Capability"@en ;
    rdfs:seeAlso de52:SupplyChainCapability ;
    rdfs:subClassOf o4de:SupportingCapability ;
    skos:definition "The supporting capability of sourcing, making and delivering goods."@en .

o4de:SystemInterface a owl:Class ;
    rdfs:label "System Interface"@en ;
    rdfs:seeAlso de52:SystemInterface ;
    skos:definition "The boundary through which a system exchanges data or commands with another system or a user."@en .

o4de:SystemOwner a owl:Class ;
    rdfs:label "System Owner"@en ;
    rdfs:seeAlso de52:SystemOwner ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role accountable for a system through its life, including its funding and fitness for use."@en .

o4de:SystemsAnalyst a owl:Class ;
    rdfs:label "Systems Analyst"@en ;
    rdfs:seeAlso de52:SystemsAnalyst ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role that studies information systems and specifies how they should meet business needs."@en .

o4de:TechnicalDomain a owl:Class ;
    rdfs:label "Technical Domain"@en ;
    rdfs:seeAlso de52:TechnicalDomain ;
    rdfs:subClassOf o4de:Domain,
        o4de:DomainType ;
    skos:definition "A domain made of a technical field, such as networking or data science."@en .

o4de:TechnologyComponent a owl:Class ;
    rdfs:label "Technology Component"@en ;
    rdfs:seeAlso de52:TechnologyComponent ;
    skos:definition "A unit of technology, hardware or software, from which a technology stack is built."@en .

o4de:TechnologyStack a owl:Class ;
    rdfs:label "Technology Stack"@en ;
    rdfs:seeAlso de52:TechnologyStack ;
    skos:definition "The set of technology layers and components used together to build and run a system."@en .

o4de:TelecommunicationsDomain a owl:Class ;
    rdfs:label "Telecommunications Domain"@en ;
    rdfs:seeAlso de52:TelecommunicationsDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of providing communication networks and services."@en .

o4de:TestAsset a owl:Class ;
    rdfs:label "Test Asset"@en ;
    rdfs:seeAlso de52:TestAsset ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A domain asset used for testing, such as a test case, data set or script."@en .

o4de:TestAutomation a owl:Class ;
    rdfs:label "Test Automation"@en ;
    rdfs:seeAlso de52:TestAutomation ;
    rdfs:subClassOf o4de:AutomationTechnique ;
    skos:definition "An automation technique that runs tests and checks their results without manual steps."@en .

o4de:TestEquipment a owl:Class ;
    rdfs:label "Test Equipment"@en ;
    rdfs:seeAlso de52:TestEquipment ;
    rdfs:subClassOf o4de:Equipment ;
    skos:definition "Equipment used to test or measure products or other equipment."@en .

o4de:TimeSaving a owl:Class ;
    rdfs:label "Time Saving"@en ;
    rdfs:seeAlso de52:TimeSaving ;
    rdfs:subClassOf o4de:AutomationBenefit ;
    skos:definition "An automation benefit measured as a reduction in the time needed to carry out work."@en .

o4de:TimeToMarket a owl:Class ;
    rdfs:label "Time to Market"@en ;
    rdfs:seeAlso de52:TimeToMarket ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric of the time from the start of development to the availability of a product to customers."@en .

o4de:TokenBasedGovernance a owl:Class ;
    rdfs:label "Token-Based Governance"@en ;
    rdfs:seeAlso de52:TokenBasedGovernance ;
    skos:definition "A governance model in which voting rights depend on holding digital tokens."@en .

o4de:TokenizedAsset a owl:Class ;
    rdfs:label "Tokenized Asset"@en ;
    rdfs:seeAlso de52:TokenizedAsset ;
    skos:definition "An asset whose ownership or rights are represented by digital tokens."@en .

o4de:TrainingPlan a owl:Class ;
    rdfs:label "Training Plan"@en ;
    rdfs:seeAlso de52:TrainingPlan ;
    skos:definition "A plan that says who is trained, in what and when, so that a change can be adopted."@en .

o4de:TransactionalData a owl:Class ;
    rdfs:label "Transactional Data"@en ;
    rdfs:seeAlso de52:TransactionalData ;
    rdfs:subClassOf o4de:DataClassification ;
    skos:definition "Data classified as the records of business events, such as orders and payments."@en .

o4de:TransformationRule a owl:Class ;
    rdfs:label "Transformation Rule"@en ;
    rdfs:seeAlso de52:TransformationRule ;
    skos:definition "A rule that states how data is converted from one form to another."@en .

o4de:TransitionPlan a owl:Class ;
    rdfs:label "Transition Plan"@en ;
    rdfs:seeAlso de52:TransitionPlan ;
    skos:definition "A plan for moving from the current state to a changed state in an orderly way."@en .

o4de:Transportation a owl:Class ;
    rdfs:label "Transportation"@en ;
    rdfs:seeAlso de52:Transportation ;
    rdfs:subClassOf o4de:ProcessWaste ;
    skos:definition "The process waste of moving materials, products or information more than is needed."@en .

o4de:TransportationDomain a owl:Class ;
    rdfs:label "Transportation Domain"@en ;
    rdfs:seeAlso de52:TransportationDomain ;
    rdfs:subClassOf o4de:IndustryDomain ;
    skos:definition "The industry domain of moving people and goods."@en .

o4de:Usability a owl:Class ;
    rdfs:label "Usability"@en ;
    rdfs:seeAlso de52:Usability ;
    rdfs:subClassOf o4de:QualityAttribute ;
    skos:definition "The quality attribute of how easily and satisfactorily users can reach their goals with a system."@en .

o4de:UseCase a owl:Class ;
    rdfs:label "Use Case"@en ;
    rdfs:seeAlso de52:UseCase ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:detailsScenario ] ;
    skos:definition "A description of how an actor uses a system to reach a goal, with the steps involved."@en .

o4de:UserStory a owl:Class ;
    rdfs:label "User Story"@en ;
    rdfs:seeAlso de52:UserStory ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasAcceptanceCriteria ] ;
    skos:definition "A short statement of what a user wants to do and why, used to describe a requirement."@en .

o4de:Utilization a owl:Class ;
    rdfs:label "Utilization"@en ;
    rdfs:seeAlso de52:Utilization ;
    rdfs:subClassOf o4de:ProcessPerformanceMetric ;
    skos:definition "The share of available capacity that is actually used, as a process performance metric."@en .

o4de:ValidationRule a owl:Class ;
    rdfs:label "Validation Rule"@en ;
    rdfs:seeAlso de52:ValidationRule ;
    rdfs:subClassOf o4de:BusinessRule ;
    skos:definition "A business rule that states when a value or a transaction is acceptable."@en .

o4de:ValueStreamMapping a owl:Class ;
    rdfs:label "Value Stream Mapping"@en ;
    rdfs:seeAlso de52:ValueStreamMapping ;
    skos:definition "A technique that draws a value stream, with its times and delays, to find waste."@en .

o4de:ValueStreamStage a owl:Class ;
    rdfs:label "Value Stream Stage"@en ;
    rdfs:seeAlso de52:ValueStreamStage ;
    skos:definition "A step in a value stream that adds to the value delivered."@en .

o4de:VariabilityManagementTool a owl:Class ;
    rdfs:label "Variability Management Tool"@en ;
    rdfs:seeAlso de52:VariabilityManagementTool ;
    rdfs:subClassOf o4de:Tool ;
    skos:definition "A tool for modelling and managing variation points, variants and features."@en .

o4de:Variant a owl:Class ;
    rdfs:label "Variant"@en ;
    rdfs:seeAlso de52:Variant ;
    skos:definition "One concrete choice that can be bound at a variation point"@en .

o4de:Vehicle a owl:Class ;
    rdfs:label "Vehicle"@en ;
    rdfs:seeAlso de52:Vehicle ;
    rdfs:subClassOf o4de:PhysicalAsset ;
    skos:definition "A physical asset used to carry people or goods."@en .

o4de:Waiting a owl:Class ;
    rdfs:label "Waiting"@en ;
    rdfs:seeAlso de52:Waiting ;
    rdfs:subClassOf o4de:ProcessWaste ;
    skos:definition "The process waste of idle time when work or people wait for the next step."@en .

o4de:Warehouse a owl:Class ;
    rdfs:label "Warehouse"@en ;
    rdfs:seeAlso de52:Warehouse ;
    rdfs:subClassOf o4de:Facility ;
    skos:definition "A facility in which goods are stored."@en .

o4de:WhatIfScenario a owl:Class ;
    rdfs:label "What-If Scenario"@en ;
    rdfs:seeAlso de52:WhatIfScenario ;
    skos:definition "A scenario used in simulation to test the effect of a change before it is made."@en .

o4de:WorkflowAutomation a owl:Class ;
    rdfs:label "Workflow Automation"@en ;
    rdfs:seeAlso de52:WorkflowAutomation ;
    rdfs:subClassOf o4de:AutomationTechnique ;
    skos:definition "An automation technique that runs the steps of a workflow by software."@en .

o4de:achievesConsensus a owl:ObjectProperty ;
    rdfs:label "achievesConsensus"@en ;
    rdfs:domain o4de:DistributedAutonomousOrganization ;
    rdfs:range o4de:ConsensusProtocol ;
    rdfs:seeAlso de52:achievesConsensus ;
    skos:definition "Links a dao to a consensus protocol; the inverse of the relation 'achievesconsensusof'."@en .

o4de:analyticData a owl:ObjectProperty ;
    rdfs:label "analyticData"@en ;
    rdfs:domain o4de:DataEntity ;
    rdfs:range o4de:AnalyticalData ;
    rdfs:seeAlso de52:analyticData ;
    skos:definition "Links a data entity to an analytical data; the inverse of the relation 'analyticdataof'."@en .

o4de:analyzesStakeholders a owl:ObjectProperty ;
    rdfs:label "analyzesStakeholders"@en ;
    rdfs:domain o4de:ChangeRequest ;
    rdfs:range o4de:StakeholderImpactAnalysis ;
    rdfs:seeAlso de52:analyzesStakeholders ;
