o4de:LegalServicesDomain a owl:Class ;
    rdfs:label "Legal Services Domain"@en ;
    rdfs:seeAlso de52:LegalServicesDomain ;
    rdfs:subClassOf o4de:ProfessionalServicesDomain ;
