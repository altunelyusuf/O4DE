@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix o4de: <http://www.zt4swe.io/o4de#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

o4de:ArchitectureReviewMeetings a owl:NamedIndividual,
        o4de:MeetingList ;
    rdfs:label "Architecture Review Meetings"@en ;
    o4de:collectionDate "2024-06-10"^^xsd:date ;
    o4de:collectionMethod "Meeting minutes" ;
    o4de:meetingType "Review" ;
    o4de:participantCount "8"^^xsd:int ;
    o4de:recordsMeeting o4de:ExampleSeniorStakeholder .

o4de:BlackFridayCampaign a owl:NamedIndividual,
        o4de:PromotionalCampaign ;
    rdfs:label "Seasonal Sale Campaign"@en ;
    o4de:campaignBudget 100000.00 ;
    o4de:campaignEndDate "2024-11-29"^^xsd:date ;
    o4de:campaignROI 3.5 ;
    o4de:campaignStartDate "2024-11-25"^^xsd:date ;
    o4de:clickThroughRate 2.5 ;
    o4de:impressions "1000000"^^xsd:int ;
    o4de:includesDiscount o4de:PremiumDiscount ;
    o4de:managedBy o4de:ExampleTeamLead ;
    o4de:promotesProduct o4de:OnlineStorefront ;
    o4de:targetAudience "General consumers and premium customers" ;
    o4de:targetsSegment o4de:PremiumCustomers ;
    o4de:usesChannel o4de:OnlineChannel .

o4de:BusinessStakeholderInterviews a owl:NamedIndividual,
        o4de:InterviewList ;
    rdfs:label "Business Stakeholder Interviews"@en ;
    o4de:collectionDate "2024-06-01"^^xsd:date ;
    o4de:collectionMethod "Interview" ;
    o4de:documentsInterview o4de:ExampleSeniorStakeholder ;
    o4de:interviewDuration "PT1H30M"^^xsd:duration .

o4de:CycleTimeMetric a owl:NamedIndividual,
        o4de:ProcessMetric ;
    rdfs:label "Cycle Time Metric"@en ;
    o4de:hasDescription "Time from process start to completion" ;
    o4de:hasName "Process Cycle Time" .

o4de:ECommerceAppPortfolio a owl:NamedIndividual,
        o4de:ApplicationPortfolio ;
    rdfs:label "E-Commerce Application Portfolio"@en ;
    o4de:applicationCount "12"^^xsd:int ;
    o4de:includesApplication o4de:AuthenticationComponent .

o4de:ECommerceDomain a owl:NamedIndividual,
        o4de:BusinessEnvironment ;
    rdfs:label "E-Commerce Business Environment"@en ;
    o4de:definesBusinessProcess o4de:OrderProcessingProcess ;
    o4de:hasDescription "Business environment for e-commerce: online retail, payment processing and customer management" .

o4de:ECommerceProductPortfolio a owl:NamedIndividual,
        o4de:ProductPortfolio ;
    rdfs:label "E-Commerce Product Portfolio"@en ;
    o4de:includesProduct o4de:OnlineStorefront .

o4de:ECommerceSWOT a owl:NamedIndividual,
        o4de:SWOTAnalysis ;
    rdfs:label "E-Commerce SWOT Analysis"@en ;
    o4de:hasDescription "Strengths, weaknesses, opportunities and threats of the e-commerce domain" ;
    o4de:hasOpportunity o4de:AIIntegration,
        o4de:CloudMigration ;
    o4de:hasStrength o4de:ExistingCustomerBase,
        o4de:TechnicalExpertise ;
    o4de:hasThreat o4de:CompetitorDisruption,
        o4de:CyberSecurityThreats ;
    o4de:hasWeakness o4de:LegacySystems,
        o4de:LimitedMobilePresence ;
    o4de:leveragesStrength o4de:TechnicalExpertise .

o4de:ExampleCommercePlatform a owl:NamedIndividual,
        o4de:VendorSolution ;
    rdfs:label "Example Commerce Platform (SaaS)"@en ;
    o4de:competesWith o4de:ExampleOpenSourcePlatform ;
    o4de:hasAlternative o4de:ExampleOpenSourcePlatform ;
    o4de:implementationTime "P60D"^^xsd:duration ;
    o4de:offeredBySolutionProvider o4de:ExampleIntegrator ;
    o4de:providedByVendor o4de:ExampleCommerceVendor ;
    o4de:solutionCost 299.00 ;
    o4de:solutionMaturity "Mature" ;
    o4de:solutionRating 4.5 ;
    o4de:supportsCapability o4de:PaymentProcessingCapability .

o4de:HRManagementProcess a owl:NamedIndividual,
        o4de:SupportingProcess ;
    rdfs:label "Human Resources Process"@en ;
    o4de:hasBusinessRole o4de:CustomerServiceRole ;
    o4de:supportsCoreProcess o4de:OrderProcessingProcess .

o4de:ITHierarchy a owl:NamedIndividual,
        o4de:OrganizationalHierarchy ;
    rdfs:label "IT Organizational Hierarchy"@en ;
    o4de:hasOrganizationalUnit o4de:DomainEngineeringTeam,
        o4de:ITDepartment ;
    o4de:hierarchyLevel "2"^^xsd:int .

o4de:OperationsOffice a owl:NamedIndividual,
        o4de:OperationsManagement ;
    rdfs:label "Operations Office"@en ;
    o4de:configuresEnvironment o4de:ProductionEnvironment ;
    o4de:monitorsOperation o4de:OrderFulfillmentOperation .

o4de:OrderProcessingSIPOC a owl:NamedIndividual,
        o4de:SIPOCAnalysis ;
    rdfs:label "Order Processing SIPOC"@en ;
    o4de:analyzesProcess o4de:OrderProcessingProcess ;
    o4de:hasCustomer o4de:ExampleCustomer ;
    o4de:hasInput o4de:CustomerOrder ;
    o4de:hasOutput o4de:DeliveredProduct ;
    o4de:hasSupplier o4de:ExampleSupplier .

o4de:ProjectActivitySummary a owl:NamedIndividual,
        o4de:ActivitySummary ;
    rdfs:label "Project Activity Summary"@en ;
    o4de:hasCreationDate "2024-06-30"^^xsd:date ;
    o4de:summarizesActivity o4de:WebAppRequirementsAnalysis .

o4de:RequirementsDocAnalysis a owl:NamedIndividual,
        o4de:DocumentAnalysisList ;
    rdfs:label "Requirements Document Analysis"@en ;
    o4de:analysisMethod "Content analysis" ;
    o4de:analyzesDocument o4de:WebAppFeatureModel ;
    o4de:collectionDate "2024-05-20"^^xsd:date ;
    o4de:collectionMethod "Document review" .

o4de:SeniorDomainAnalyst a owl:NamedIndividual,
        o4de:DomainAnalyst ;
    rdfs:label "Senior Domain Analyst (example role holder)"@en ;
    o4de:performsActivity o4de:WebAppRequirementsAnalysis .

o4de:StakeholderInterviewLog a owl:NamedIndividual,
        o4de:DataCollectionLog ;
    rdfs:label "Stakeholder Interview Log"@en ;
    o4de:collectionDate "2024-06-15"^^xsd:date ;
    o4de:collectionMethod "Structured interviews" ;
    o4de:logsActivity o4de:WebAppRequirementsAnalysis .

<http://www.zt4swe.io/o4de-abox> a owl:Ontology ;
    dc:title "O4DE: Ontology for Domain Engineering (A-Box)"@en ;
    dcterms:created "2026-10-13"^^xsd:date ;
    dcterms:creator "Yusuf Altunel" ;
    dcterms:description "Twelve SKOS taxonomies and illustrative example individuals for the Ontology for Domain Engineering."@en ;
    dcterms:license <http://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    dcterms:rights "Copyright 2026 Yusuf Altunel" ;
    dcterms:title "O4DE: Ontology for Domain Engineering (A-Box)"@en ;
    rdfs:comment "This file holds the individuals of O4DE: the twelve SKOS taxonomies that classify domain engineering and business concepts, and a small set of illustrative example individuals that show how the T-Box is used. Examples are invented for teaching and are not sourced facts. Counts are reproduced by 05-gates/o4de_gate_v1_0_0.py."@en ;
    owl:imports <http://www.zt4swe.io/o4de> ;
    owl:versionIRI <http://www.zt4swe.io/o4de-abox/1.0.0> ;
    owl:versionInfo "1.0.0" .

o4de:AIIntegration a owl:NamedIndividual,
        o4de:Opportunity ;
    rdfs:label "AI Integration"@en ;
    o4de:likelihoodScore 0.6 ;
    o4de:opportunityValue 300000.00 .

o4de:AccountingConcept a skos:Concept ;
    skos:broader o4de:SupportingProcessesBPConcept ;
    skos:inScheme o4de:BusinessProcessTaxonomy ;
    skos:prefLabel "Accounting"@en .

o4de:ActivitySummaryConcept a skos:Concept ;
    rdfs:seeAlso o4de:ActivitySummary ;
    skos:broader o4de:DataCollectionConcept ;
    skos:inScheme o4de:DomainEngineeringTaxonomy ;
    skos:prefLabel "Activity Summary"@en .

o4de:AdaptabilityConcept a skos:Concept ;
    skos:broader o4de:OrganizationalAgilityConcept ;
    skos:inScheme o4de:OrganizationalTaxonomy ;
    skos:prefLabel "Adaptability"@en .

