o4de:AuthVariationPoint a owl:NamedIndividual,
        o4de:VariationPoint ;
    rdfs:label "Authentication Variation Point"@en ;
    o4de:hasName "Authentication Method Selection" ;
    o4de:hasVariant o4de:BasicAuthVariant,
        o4de:OAuth2Variant,
        o4de:SAMLVariant ;
    o4de:implementsVariability o4de:ParameterVariabilityMechanism .

