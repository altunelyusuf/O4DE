o4de:includesProduct a owl:ObjectProperty ;
    rdfs:label "includes product"@en ;
    rdfs:domain o4de:ProductPortfolio ;
    rdfs:range o4de:Product ;
    skos:definition "Links a product portfolio to a product it contains."@en .

o4de:includesTouchpoint a owl:ObjectProperty ;
    rdfs:label "includes touchpoint"@en ;
    rdfs:domain o4de:CustomerJourney ;
    rdfs:range o4de:Touchpoint ;
    skos:definition "Links a customer journey to a touchpoint on it."@en .

o4de:integratesWithChannel a owl:ObjectProperty,
        owl:SymmetricProperty ;
