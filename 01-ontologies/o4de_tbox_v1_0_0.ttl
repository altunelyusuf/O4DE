    rdfs:domain o4de:ProcessActivity ;
    rdfs:range o4de:Stakeholder ;
    skos:definition "Links an activity to a stakeholder who takes part in it or is affected by it."@en .

o4de:isAutomated a owl:DatatypeProperty ;
    rdfs:label "is automated"@en ;
    rdfs:domain o4de:ProcessActivity ;
    rdfs:range xsd:boolean ;
    skos:definition "States whether an activity is carried out by software without manual work."@en .

o4de:isConfigurable a owl:DatatypeProperty ;
    rdfs:label "is configurable"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range xsd:boolean ;
    skos:definition "States whether a domain asset can be configured to suit different uses."@en .

o4de:isReusable a owl:DatatypeProperty ;
    rdfs:label "is reusable"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range xsd:boolean ;
    skos:definition "States whether a domain asset can be used again in other products."@en .

o4de:launchDate a owl:DatatypeProperty ;
    rdfs:label "launch date"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range xsd:date ;
    skos:definition "The date on which a product was launched."@en .

o4de:leadsTeam a owl:ObjectProperty ;
    rdfs:label "leads team"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range o4de:Team ;
    skos:definition "Links an employee to a team the employee leads."@en .

o4de:leveragesStrength a owl:ObjectProperty ;
    rdfs:label "leverages strength"@en ;
    rdfs:domain o4de:SWOTAnalysis ;
    rdfs:range o4de:Strength ;
    skos:definition "Links a SWOT analysis to a strength that is used to pursue an opportunity or counter a threat."@en .

o4de:likelihoodScore a owl:DatatypeProperty ;
    rdfs:label "likelihood score"@en ;
    rdfs:comment "Probability from 0.0 to 1.0"@en ;
    rdfs:domain o4de:Opportunity ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric score of how likely an opportunity is to materialise."@en .

o4de:logsActivity a owl:ObjectProperty ;
    rdfs:label "logs activity"@en ;
    rdfs:domain o4de:DataCollectionLog ;
    rdfs:range o4de:DomainEngineeringActivity ;
    skos:definition "Links a data collection log to an activity whose data it records."@en .

o4de:managedBy a owl:ObjectProperty ;
    rdfs:label "managed by"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range o4de:Employee ;
    skos:definition "Links a marketing campaign to the employee who manages it."@en .

o4de:managedByCRM a owl:ObjectProperty ;
    rdfs:label "managed by CRM"@en ;
    rdfs:domain o4de:Customer ;
    rdfs:range o4de:CRM ;
    skos:definition "Links a customer to the CRM system that manages the relationship."@en .

o4de:manages a owl:ObjectProperty ;
    rdfs:label "manages"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range o4de:Employee ;
    owl:inverseOf o4de:reportsTo ;
    skos:definition "Links an employee to an employee for whom they are the manager."@en .

o4de:managesCost a owl:ObjectProperty ;
    rdfs:label "manages cost"@en ;
    rdfs:domain o4de:CostManagement ;
    rdfs:range o4de:Cost ;
    skos:definition "Links cost management to a cost it controls."@en .

o4de:managesInventory a owl:ObjectProperty ;
    rdfs:label "manages inventory"@en ;
    rdfs:domain o4de:OrganizationalUnit ;
    rdfs:range o4de:Inventory ;
    skos:definition "Links an organizational unit to an inventory it is responsible for."@en .

o4de:marketShare a owl:DatatypeProperty ;
    rdfs:label "market share"@en ;
    rdfs:comment "Market share percentage of a vendor or product"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:decimal ;
    skos:definition "The share of the market that a thing holds, as a percentage."@en .

o4de:maximumStock a owl:DatatypeProperty ;
    rdfs:label "maximum stock"@en ;
    rdfs:domain o4de:Inventory ;
    rdfs:range xsd:int ;
    skos:definition "The largest quantity of a product the inventory should hold."@en .

o4de:meetingType a owl:DatatypeProperty ;
    rdfs:label "meeting type"@en ;
    rdfs:comment "Workshop, Review or Planning"@en ;
    rdfs:domain o4de:MeetingList ;
    rdfs:range xsd:string ;
    skos:definition "The kind of meeting recorded, for example workshop or review."@en .

o4de:meetsStandard a owl:ObjectProperty ;
    rdfs:label "meets standard"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range o4de:QualityStandard ;
    skos:definition "Links a product to a quality standard it satisfies."@en .

o4de:memberOfTeam a owl:ObjectProperty ;
    rdfs:label "member of team"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range o4de:Team ;
    skos:definition "Links an employee to a team the employee belongs to."@en .

o4de:methodologyType a owl:DatatypeProperty ;
    rdfs:label "methodology type"@en ;
    rdfs:comment "Scrum, Kanban, SAFe or Lean"@en ;
    rdfs:domain o4de:AgileMethodology ;
    rdfs:range xsd:string ;
    skos:definition "The kind of agile methodology, for example framework or practice."@en .

o4de:minimumStock a owl:DatatypeProperty ;
    rdfs:label "minimum stock"@en ;
    rdfs:domain o4de:Inventory ;
    rdfs:range xsd:int ;
    skos:definition "The smallest quantity of a product the inventory should hold."@en .

o4de:monitorsOperation a owl:ObjectProperty ;
    rdfs:label "monitors operation"@en ;
    rdfs:domain o4de:OperationsManagement ;
    rdfs:range o4de:Operation ;
    skos:definition "Links an operations management activity to an operation it watches."@en .

o4de:offeredBySolutionProvider a owl:ObjectProperty ;
    rdfs:label "offered by solution provider"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range o4de:SolutionProvider ;
    skos:definition "Links a vendor solution to the solution provider that offers it."@en .

o4de:operatesChannel a owl:ObjectProperty ;
    rdfs:label "operates channel"@en ;
    rdfs:domain o4de:OrganizationalUnit ;
    rdfs:range o4de:Channel ;
    skos:definition "Links an organizational unit to a channel it runs."@en .

o4de:operatesIn a owl:ObjectProperty ;
    rdfs:label "operates in"@en ;
    rdfs:domain o4de:Operation ;
    rdfs:range o4de:OperationalEnvironment ;
    skos:definition "Links an operation to the operational environment in which it runs."@en .

o4de:opportunityValue a owl:DatatypeProperty ;
    rdfs:label "opportunity value"@en ;
    rdfs:domain o4de:Opportunity ;
    rdfs:range xsd:decimal ;
    skos:definition "The estimated worth of an opportunity."@en .

o4de:partOfDepartment a owl:ObjectProperty ;
    rdfs:label "part of department"@en ;
    rdfs:domain o4de:Team ;
    rdfs:range o4de:Department ;
    skos:definition "Links a team to the department it belongs to."@en .

o4de:partOfProcess a owl:ObjectProperty ;
    rdfs:label "part of process"@en ;
    rdfs:domain o4de:ProcessActivity ;
    rdfs:range o4de:DomainEngineeringProcess ;
    skos:definition "Links an activity to the process it belongs to."@en .

o4de:participantCount a owl:DatatypeProperty ;
    rdfs:label "participant count"@en ;
    rdfs:domain o4de:MeetingList ;
    rdfs:range xsd:int ;
    skos:definition "The number of people who took part in a meeting."@en .

o4de:participatesInSprint a owl:ObjectProperty ;
    rdfs:label "participates in sprint"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range o4de:Sprint ;
    skos:definition "Links an employee to a sprint the employee takes part in."@en .

o4de:performsActivity a owl:ObjectProperty ;
    rdfs:label "performs activity"@en ;
    rdfs:domain o4de:Role ;
    rdfs:range o4de:ProcessActivity ;
    skos:definition "Links a role to an activity it carries out."@en .

o4de:positionLevel a owl:DatatypeProperty ;
    rdfs:label "position level"@en ;
    rdfs:comment "Entry, Mid, Senior or Executive"@en ;
    rdfs:domain o4de:Position ;
    rdfs:range xsd:string ;
    skos:definition "The level of a position within the organizational hierarchy, such as junior or senior."@en .

o4de:price a owl:DatatypeProperty ;
    rdfs:label "price"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range xsd:decimal ;
    skos:definition "The amount charged for a product."@en .

o4de:processMaturity a owl:DatatypeProperty ;
    rdfs:label "process maturity"@en ;
    rdfs:comment "Maturity of the business process (1-5)"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range xsd:int ;
    skos:definition "The maturity level of a business process on a scale from 1 to 5."@en .

o4de:producesAsset a owl:ObjectProperty ;
    rdfs:label "produces asset"@en ;
    rdfs:domain o4de:DomainEngineeringActivity ;
    rdfs:range o4de:DomainAsset ;
    skos:definition "Links a domain engineering activity to a domain asset it creates."@en .

o4de:producesOutput a owl:ObjectProperty ;
    rdfs:label "produces output"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range o4de:ProcessOutput ;
    skos:definition "Links a business process to an output it creates."@en .

o4de:productCategory a owl:DatatypeProperty ;
    rdfs:label "product category"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range xsd:string ;
    skos:definition "The category a product belongs to."@en .

o4de:productCode a owl:DatatypeProperty ;
    rdfs:label "product code"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range xsd:string ;
    skos:definition "The code that identifies a product."@en .

o4de:promotesProduct a owl:ObjectProperty ;
    rdfs:label "promotes product"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range o4de:Product ;
    skos:definition "Links a marketing campaign to a product it promotes."@en .

o4de:providesExperience a owl:ObjectProperty ;
    rdfs:label "provides experience"@en ;
    rdfs:domain o4de:Touchpoint ;
    rdfs:range o4de:CustomerExperience ;
    skos:definition "Links a touchpoint to the customer experience it creates."@en .

o4de:receivesOutput a owl:ObjectProperty ;
    rdfs:label "receives output"@en ;
    rdfs:domain o4de:Customer ;
    rdfs:range o4de:ProcessOutput ;
    skos:definition "Links a customer to an output of a process that it receives."@en .

o4de:recordsMeeting a owl:ObjectProperty ;
    rdfs:label "records meeting"@en ;
    rdfs:domain o4de:MeetingList ;
    rdfs:range o4de:Stakeholder ;
    skos:definition "Links a meeting list to a stakeholder who attended a meeting."@en .

o4de:reorderPoint a owl:DatatypeProperty ;
    rdfs:label "reorder point"@en ;
    rdfs:domain o4de:Inventory ;
    rdfs:range xsd:int ;
    skos:definition "The stock quantity at which a new order is placed."@en .

o4de:requiresFeature a owl:ObjectProperty ;
    rdfs:label "requires feature"@en ;
    rdfs:domain o4de:Feature ;
    rdfs:range o4de:Feature ;
    skos:definition "States that selecting one feature forces the selection of another."@en .

o4de:responseTime a owl:DatatypeProperty ;
    rdfs:label "response time"@en ;
    rdfs:domain o4de:OrganizationalAgility ;
    rdfs:range xsd:duration ;
    skos:definition "The time an organization needs to respond to a change."@en .

o4de:salary a owl:DatatypeProperty ;
    rdfs:label "salary"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range xsd:decimal ;
    skos:definition "The pay of an employee."@en .

o4de:satisfactionScore a owl:DatatypeProperty ;
    rdfs:label "satisfaction score"@en ;
    rdfs:domain o4de:CustomerExperience ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric score of how satisfied a customer is with an experience."@en .

o4de:segmentSize a owl:DatatypeProperty ;
    rdfs:label "segment size"@en ;
    rdfs:domain o4de:CustomerSegment ;
    rdfs:range xsd:int ;
    skos:definition "The number of customers in a segment."@en .

o4de:servesCustomerThrough a owl:ObjectProperty ;
    rdfs:label "serves customer through"@en ;
    rdfs:domain o4de:Channel ;
    rdfs:range o4de:Customer ;
    skos:definition "Links a channel to a customer it reaches."@en .

o4de:solutionCost a owl:DatatypeProperty ;
    rdfs:label "solution cost"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range xsd:decimal ;
    skos:definition "The cost of acquiring a vendor solution."@en .

o4de:solutionMaturity a owl:DatatypeProperty ;
    rdfs:label "solution maturity"@en ;
    rdfs:comment "Emerging, Growing, Mature or Declining"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range xsd:string ;
    skos:definition "How mature a vendor solution is, for example emerging or established."@en .

o4de:sprintDuration a owl:DatatypeProperty ;
    rdfs:label "sprint duration"@en ;
    rdfs:domain o4de:Sprint ;
    rdfs:range xsd:duration ;
    skos:definition "The length of a sprint."@en .

o4de:sprintVelocity a owl:DatatypeProperty ;
    rdfs:label "sprint velocity"@en ;
    rdfs:domain o4de:Sprint ;
    rdfs:range xsd:decimal ;
    skos:definition "The amount of work a team completes in a sprint."@en .

o4de:stageDuration a owl:DatatypeProperty ;
    rdfs:label "stage duration"@en ;
    rdfs:domain o4de:ProductLifecycleStage ;
    rdfs:range xsd:duration ;
    skos:definition "The time a product spends in a lifecycle stage."@en .

o4de:strengthScore a owl:DatatypeProperty ;
    rdfs:label "strength score"@en ;
    rdfs:domain o4de:Strength ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric score of how strong a strength is."@en .

o4de:summarizesActivity a owl:ObjectProperty ;
    rdfs:label "summarizes activity"@en ;
    rdfs:domain o4de:ActivitySummary ;
    rdfs:range o4de:DomainEngineeringActivity ;
    skos:definition "Links an activity summary to the activity it summarises."@en .

o4de:suppliedBySupplier a owl:ObjectProperty ;
    rdfs:label "supplied by supplier"@en ;
    rdfs:domain o4de:Inventory ;
    rdfs:range o4de:Supplier ;
    skos:definition "Links an inventory to the supplier that replenishes it."@en .

o4de:suppliesInput a owl:ObjectProperty ;
    rdfs:label "supplies input"@en ;
    rdfs:domain o4de:Supplier ;
    rdfs:range o4de:ProcessInput ;
    skos:definition "Links a supplier to an input it provides to a process."@en .

o4de:supportsCapability a owl:ObjectProperty ;
    rdfs:label "supports capability"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range o4de:SystemCapabilities ;
    skos:definition "Links a vendor solution to a system capability it supports."@en .

o4de:targetAudience a owl:DatatypeProperty ;
    rdfs:label "target audience"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range xsd:string ;
    skos:definition "A text describing the people a campaign addresses."@en .

o4de:targetsSegment a owl:ObjectProperty ;
    rdfs:label "targets segment"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range o4de:CustomerSegment ;
    skos:definition "Links a marketing campaign to the customer segment it is aimed at."@en .

o4de:teamSize a owl:DatatypeProperty ;
    rdfs:label "team size"@en ;
    rdfs:domain o4de:Team ;
    rdfs:range xsd:int ;
    skos:definition "The number of members in a team."@en .

o4de:threatLevel a owl:DatatypeProperty ;
    rdfs:label "threat level"@en ;
    rdfs:domain o4de:Threat ;
    rdfs:range xsd:string ;
    skos:definition "A rating of how serious a threat is."@en .

o4de:unitCost a owl:DatatypeProperty ;
    rdfs:label "unit cost"@en ;
    rdfs:domain o4de:Inventory ;
    rdfs:range xsd:decimal ;
    skos:definition "The cost of one unit held in an inventory."@en .

o4de:usesAsset a owl:ObjectProperty ;
    rdfs:label "uses asset"@en ;
    rdfs:domain o4de:DomainEngineeringActivity ;
    rdfs:range o4de:DomainAsset ;
    skos:definition "Links a domain engineering activity to a domain asset it needs as input."@en .

o4de:usesChannel a owl:ObjectProperty ;
    rdfs:label "uses channel"@en ;
    rdfs:comment "Relates products and campaigns to the channels they use"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( o4de:Product o4de:MarketingCampaign ) ] ;
    rdfs:range o4de:Channel ;
    skos:definition "Links a product or a marketing campaign to a channel it uses."@en .

o4de:usesPricingModel a owl:ObjectProperty ;
    rdfs:label "uses pricing model"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range o4de:PricingModel ;
    skos:definition "Links a product to the pricing model used to price it."@en .

o4de:usesTool a owl:ObjectProperty ;
    rdfs:label "uses tool"@en ;
    rdfs:domain o4de:ProcessActivity ;
    rdfs:range o4de:Tool ;
    skos:definition "Links an activity to a tool used to perform it."@en .

o4de:weaknessImpact a owl:DatatypeProperty ;
    rdfs:label "weakness impact"@en ;
    rdfs:domain o4de:Weakness ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric score of how much damage a weakness can cause."@en .

o4de:AlternativeFeature a owl:Class ;
    rdfs:label "Alternative Feature"@en ;
    rdfs:subClassOf o4de:Feature ;
    skos:definition "A feature offered as one choice among several mutually exclusive features."@en .

o4de:CRM a owl:Class ;
    rdfs:label "Customer Relationship Management"@en ;
    rdfs:subClassOf o4de:CustomerManagement ;
    skos:altLabel "CRM"@en ;
    skos:definition "Technology and processes used to manage customer interactions and relationships"@en .

o4de:CampaignManagement a owl:Class ;
    rdfs:label "Campaign Management"@en ;
    rdfs:subClassOf o4de:MarketingManagement ;
    skos:definition "The management activity that plans, runs and evaluates marketing campaigns."@en .

o4de:ChannelManagement a owl:Class ;
    rdfs:label "Channel Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Management of the channels through which products and services reach customers"@en .

o4de:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A reusable, configurable software building block with defined interfaces"@en .

o4de:CompositionVariability a owl:Class ;
    rdfs:label "Composition Variability"@en ;
    rdfs:subClassOf o4de:VariabilityMechanism ;
    skos:definition "Variability realised by assembling an asset from interchangeable parts."@en .

o4de:CustomerCategorization a owl:Class ;
    rdfs:label "Customer Categorization"@en ;
    rdfs:subClassOf o4de:CustomerManagement ;
    skos:definition "Classification of customers based on characteristics, behavior or value"@en .

o4de:DeclineStage a owl:Class ;
    rdfs:label "Decline Stage"@en ;
    rdfs:comment "Product experiences decreasing demand"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which demand for a product decreases."@en .

o4de:DevelopmentStage a owl:Class ;
    rdfs:label "Development Stage"@en ;
    rdfs:comment "Product is being developed and designed"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which a product is being designed and developed."@en .

o4de:DigitalChannel a owl:Class ;
    rdfs:label "Digital Channel"@en ;
    rdfs:subClassOf o4de:Channel ;
    skos:definition "A channel that reaches customers through digital media such as a website or application."@en .

o4de:DiscountingManagement a owl:Class ;
    rdfs:label "Discounting Management"@en ;
    rdfs:subClassOf o4de:FinancialManagement ;
    skos:definition "The management activity that defines and controls discounts."@en .

o4de:DistributionChannel a owl:Class ;
    rdfs:label "Distribution Channel"@en ;
    rdfs:subClassOf o4de:Channel ;
    skos:definition "A channel through which products are physically or digitally delivered to customers."@en .

o4de:DomainAnalysis a owl:Class ;
    rdfs:label "Domain Analysis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o4de:precedes ;
            owl:someValuesFrom o4de:DomainDesign ],
        o4de:DomainEngineeringActivity ;
    skos:definition "Identification and understanding of the problem space: stakeholder needs, constraints, common requirements and variability"@en .

o4de:DomainEvolution a owl:Class ;
    rdfs:label "Domain Evolution"@en ;
    rdfs:subClassOf o4de:DomainEngineeringActivity ;
    skos:definition "Change management, versioning and maintenance of domain assets over time"@en .

o4de:DomainModel a owl:Class ;
    rdfs:label "Domain Model"@en ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A model of the key concepts, relationships and constraints within the application domain"@en .

o4de:DomainSpecificLanguage a owl:Class ;
    rdfs:label "Domain-Specific Language"@en ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A language with syntax and semantics tailored to expressing solutions in the domain"@en .

o4de:FeatureModel a owl:Class ;
    rdfs:label "Feature Model"@en ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A hierarchical model that captures the commonalities and variabilities of a domain in terms of features and their relationships"@en ;
    skos:scopeNote "Feature models are central to managing variability in domain engineering"@en .

o4de:Framework a owl:Class ;
    rdfs:label "Framework"@en ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A reusable skeleton of cooperating components with extension points for a domain"@en .

o4de:GrowthStage a owl:Class ;
    rdfs:label "Growth Stage"@en ;
    rdfs:comment "Product experiences rapid market acceptance"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which a product gains rapid market acceptance."@en .

o4de:HumanResourceManagement a owl:Class ;
    rdfs:label "Human Resource Management"@en ;
    rdfs:subClassOf o4de:OrganizationalManagement ;
    skos:altLabel "HRM"@en ;
    skos:definition "Management of human capital, including recruitment, development, performance and retention"@en .

o4de:InheritanceVariability a owl:Class ;
    rdfs:label "Inheritance Variability"@en ;
    rdfs:subClassOf o4de:VariabilityMechanism ;
    skos:definition "Variability realised by specialising an asset through inheritance."@en .

o4de:IntroductionStage a owl:Class ;
    rdfs:label "Introduction Stage"@en ;
    rdfs:comment "Product is launched to market"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which a product is launched to the market."@en .

o4de:MandatoryFeature a owl:Class ;
    rdfs:label "Mandatory Feature"@en ;
    rdfs:subClassOf o4de:Feature ;
    skos:definition "A feature that every product of the domain must include."@en .

o4de:MarketingManagement a owl:Class ;
    rdfs:label "Marketing Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "The management activity that plans and runs marketing of products and services."@en .

o4de:MaturityStage a owl:Class ;
    rdfs:label "Maturity Stage"@en ;
    rdfs:comment "Product reaches peak market penetration"@en ;
    rdfs:subClassOf o4de:ProductLifecycleStage ;
    skos:definition "The lifecycle stage in which a product reaches its peak market penetration."@en .

o4de:OptionalFeature a owl:Class ;
    rdfs:label "Optional Feature"@en ;
    rdfs:subClassOf o4de:Feature ;
    skos:definition "A feature that a product of the domain may include or leave out."@en .

o4de:OrganizationalHierarchy a owl:Class ;
    rdfs:label "Organizational Hierarchy"@en ;
    rdfs:subClassOf o4de:OrganizationalStructure ;
    skos:definition "The vertical structure of authority levels and reporting relationships"@en .

o4de:ParameterVariability a owl:Class ;
    rdfs:label "Parameter Variability"@en ;
    rdfs:subClassOf o4de:VariabilityMechanism ;
    skos:definition "Variability realised by setting a parameter value on an otherwise unchanged asset."@en .

o4de:PricingManagement a owl:Class ;
    rdfs:label "Pricing Management"@en ;
    rdfs:subClassOf o4de:FinancialManagement ;
    skos:definition "The management activity that sets and adjusts prices."@en .

o4de:PricingModel a owl:Class ;
    rdfs:label "Pricing Model"@en ;
    rdfs:subClassOf o4de:PricingManagement ;
    skos:definition "A structured approach for setting prices"@en .

o4de:ProcessAnalysis a owl:Class ;
    rdfs:label "Process Analysis"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Systematic analysis of business processes and their components"@en .

o4de:ProcessClassification a owl:Class ;
    rdfs:label "Process Classification"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Categorization of business processes based on their purpose and characteristics"@en .

o4de:ProductPortfolio a owl:Class ;
    rdfs:label "Product Portfolio"@en ;
    rdfs:subClassOf o4de:PortfolioManagement ;
    skos:definition "A collection of products managed by the organization, with lifecycle stages, market performance and strategic positioning"@en .

o4de:PromotionalCampaign a owl:Class ;
    rdfs:label "Promotional Campaign"@en ;
    rdfs:subClassOf o4de:MarketingCampaign ;
    skos:definition "A campaign designed to promote special offers, discounts or incentives"@en .

o4de:QualityAssurance a owl:Class ;
    rdfs:label "Quality Assurance"@en ;
    rdfs:subClassOf o4de:QualityManagement ;
    skos:definition "Process-focused activities that prevent quality issues"@en .

o4de:QualityControl a owl:Class ;
    rdfs:label "Quality Control"@en ;
    rdfs:subClassOf o4de:QualityManagement ;
    skos:definition "Operational activities that verify that products and services meet quality requirements"@en .

o4de:QualityStandard a owl:Class ;
    rdfs:label "Quality Standard"@en ;
    rdfs:subClassOf o4de:QualityManagement ;
    skos:definition "Documented criteria used to measure and ensure quality"@en .

o4de:ReferenceArchitecture a owl:Class ;
    rdfs:label "Reference Architecture"@en ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "An architectural template capturing the structural and behavioral patterns of systems in the domain"@en .

o4de:Retrospective a owl:Class ;
    rdfs:label "Retrospective"@en ;
    rdfs:subClassOf o4de:AgileActivity ;
    skos:definition "A regular meeting where a team reflects on its process and identifies improvements"@en .

o4de:SalesChannel a owl:Class ;
    rdfs:label "Sales Channel"@en ;
    rdfs:subClassOf o4de:Channel ;
    skos:definition "A channel through which products are sold to customers."@en .

o4de:StockLevel a owl:Class ;
    rdfs:label "Stock Level"@en ;
    rdfs:subClassOf o4de:StockManagement ;
    skos:definition "The current quantity of a particular item held in inventory"@en .

o4de:StockManagement a owl:Class ;
    rdfs:label "Stock Management"@en ;
    rdfs:subClassOf o4de:InventoryManagement ;
    skos:definition "The management activity that controls stock levels, reordering and replenishment."@en .

o4de:Variant a owl:Class ;
    rdfs:label "Variant"@en ;
    skos:definition "One concrete choice that can be bound at a variation point"@en .

o4de:belongsToSegment a owl:ObjectProperty ;
    rdfs:label "belongs to segment"@en ;
    rdfs:domain o4de:Customer ;
    rdfs:range o4de:CustomerSegment ;
    skos:definition "Links a customer to a customer segment it falls into."@en .

o4de:belongsToUnit a owl:ObjectProperty ;
    rdfs:label "belongs to unit"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range o4de:OrganizationalUnit ;
    skos:definition "Links an employee to the organizational unit the employee works in."@en .

o4de:campaignEndDate a owl:DatatypeProperty ;
    rdfs:label "campaign end date"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range xsd:date ;
    skos:definition "The date on which a marketing campaign ends."@en .

o4de:campaignStartDate a owl:DatatypeProperty ;
    rdfs:label "campaign start date"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range xsd:date ;
    skos:definition "The date on which a marketing campaign starts."@en .

o4de:collectionDate a owl:DatatypeProperty ;
    rdfs:label "collection date"@en ;
    rdfs:domain o4de:DataCollectionLog ;
    rdfs:range xsd:date ;
    skos:definition "The date on which data was collected."@en .

o4de:collectionMethod a owl:DatatypeProperty ;
    rdfs:label "collection method"@en ;
    rdfs:domain o4de:DataCollectionLog ;
    rdfs:range xsd:string ;
    skos:definition "The method by which data was collected, for example interview or survey."@en .

o4de:currentStage a owl:ObjectProperty ;
    rdfs:label "current stage"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range o4de:ProductLifecycleStage ;
    skos:definition "Links a product to the lifecycle stage it is in now."@en .

o4de:discountPercentage a owl:DatatypeProperty ;
    rdfs:label "discount percentage"@en ;
    rdfs:comment "0.0 to 100.0"@en ;
    rdfs:domain o4de:Discount ;
    rdfs:range xsd:decimal ;
    skos:definition "The size of a discount as a percentage of the price, from 0 to 100."@en .

o4de:hasBusinessRole a owl:ObjectProperty ;
    rdfs:label "has business role"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range o4de:BusinessRole ;
    skos:definition "Links a business process to a business role that takes part in it."@en .

o4de:hasCustomer a owl:ObjectProperty ;
    rdfs:label "has customer"@en ;
    rdfs:domain o4de:SIPOCAnalysis ;
    rdfs:range o4de:Customer ;
    skos:definition "Links a SIPOC analysis to a customer who receives the output."@en .

o4de:hasDuration a owl:DatatypeProperty ;
    rdfs:label "has duration"@en ;
    rdfs:domain o4de:ProcessActivity ;
    rdfs:range xsd:duration ;
    skos:definition "The time an activity takes."@en .

o4de:hasInput a owl:ObjectProperty ;
    rdfs:label "has input"@en ;
    rdfs:domain o4de:SIPOCAnalysis ;
    rdfs:range o4de:ProcessInput ;
    skos:definition "Links a SIPOC analysis to an input of the process."@en .

o4de:hasLifecycle a owl:ObjectProperty ;
    rdfs:label "has lifecycle"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range o4de:ProductLifecycle ;
    skos:definition "Links a product to its lifecycle."@en .

o4de:hasMaturityLevel a owl:DatatypeProperty ;
    rdfs:label "has maturity level"@en ;
    rdfs:comment "Process maturity 1 (Initial) to 5 (Optimizing)"@en ;
    rdfs:domain o4de:DomainEngineeringProcess ;
    rdfs:range xsd:int ;
    skos:definition "The maturity level of a domain engineering process on a scale from 1 to 5."@en .

o4de:hasOpportunity a owl:ObjectProperty ;
    rdfs:label "has opportunity"@en ;
    rdfs:domain o4de:SWOTAnalysis ;
    rdfs:range o4de:Opportunity ;
    skos:definition "Links a SWOT analysis to an opportunity it identifies."@en .

o4de:hasOutput a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:domain o4de:SIPOCAnalysis ;
    rdfs:range o4de:ProcessOutput ;
    skos:definition "Links a SIPOC analysis to an output of the process."@en .

o4de:hasStrength a owl:ObjectProperty ;
    rdfs:label "has strength"@en ;
    rdfs:domain o4de:SWOTAnalysis ;
    rdfs:range o4de:Strength ;
    skos:definition "Links a SWOT analysis to a strength it identifies."@en .

o4de:hasSupplier a owl:ObjectProperty ;
    rdfs:label "has supplier"@en ;
    rdfs:domain o4de:SIPOCAnalysis ;
    rdfs:range o4de:Supplier ;
    skos:definition "Links a SIPOC analysis to a supplier of the process."@en .

o4de:hasThreat a owl:ObjectProperty ;
    rdfs:label "has threat"@en ;
    rdfs:domain o4de:SWOTAnalysis ;
    rdfs:range o4de:Threat ;
    skos:definition "Links a SWOT analysis to a threat it identifies."@en .

o4de:hasWeakness a owl:ObjectProperty ;
    rdfs:label "has weakness"@en ;
    rdfs:domain o4de:SWOTAnalysis ;
    rdfs:range o4de:Weakness ;
    skos:definition "Links a SWOT analysis to a weakness it identifies."@en .

o4de:holdsPosition a owl:ObjectProperty ;
    rdfs:label "holds position"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range o4de:Position ;
    skos:definition "Links an employee to the position the employee holds."@en .

o4de:measuredBy a owl:ObjectProperty ;
    rdfs:label "measured by"@en ;
    rdfs:domain o4de:QualityAttribute ;
    rdfs:range o4de:Metric ;
    skos:definition "Links a quality attribute to a metric that measures it."@en .

o4de:parentFeature a owl:ObjectProperty ;
    rdfs:label "parent feature"@en ;
    rdfs:domain o4de:Feature ;
    rdfs:range o4de:Feature ;
    skos:definition "Links a feature to the feature placed above it in the feature tree."@en .

o4de:performanceRating a owl:DatatypeProperty ;
    rdfs:label "performance rating"@en ;
    rdfs:comment "0.0 to 5.0"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric rating of how well an employee performs, from 0 to 5."@en .

o4de:priorityLevel a owl:DatatypeProperty ;
    rdfs:label "priority level"@en ;
    rdfs:comment "High, Medium or Low"@en ;
    rdfs:domain o4de:ProblemDescription ;
    rdfs:range xsd:string ;
    skos:definition "How urgently a problem must be addressed: High, Medium or Low."@en .

o4de:problemSeverity a owl:DatatypeProperty ;
    rdfs:label "problem severity"@en ;
    rdfs:comment "Critical, Major or Minor"@en ;
    rdfs:domain o4de:ProblemDescription ;
    rdfs:range xsd:string ;
    skos:definition "How serious a problem is: Critical, Major or Minor."@en .

o4de:providedByVendor a owl:ObjectProperty ;
    rdfs:label "provided by vendor"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range o4de:Vendor ;
    skos:definition "Links a vendor solution to the vendor that provides it."@en .

o4de:qualityScore a owl:DatatypeProperty ;
    rdfs:label "quality score"@en ;
    rdfs:comment "Quality score from 0.0 to 10.0"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric score of the quality of a product, from 0 to 10."@en .

o4de:reportsTo a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "reports to"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range o4de:Employee ;
    skos:definition "Links an employee to the employee who supervises them."@en .

o4de:ruleType a owl:DatatypeProperty ;
    rdfs:label "rule type"@en ;
    rdfs:comment "Constraint, Policy, Guideline or Validation"@en ;
    rdfs:domain o4de:BusinessRule ;
    rdfs:range xsd:string ;
    skos:definition "The kind of business rule, for example constraint, policy, guideline or validation."@en .

o4de:solutionRating a owl:DatatypeProperty ;
    rdfs:label "solution rating"@en ;
    rdfs:comment "Quality rating from 0.0 to 5.0"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric rating of a vendor solution, from 0 to 5."@en .

o4de:supportsCoreProcess a owl:ObjectProperty ;
    rdfs:label "supports core process"@en ;
    rdfs:domain o4de:SupportingProcess ;
    rdfs:range o4de:CoreBusinessProcess ;
    skos:definition "Links a supporting process to a core business process that it helps."@en .

o4de:utilizationRate a owl:DatatypeProperty ;
    rdfs:label "utilization rate"@en ;
    rdfs:comment "0.0 to 100.0"@en ;
    rdfs:domain o4de:OperationalEnvironment ;
    rdfs:range xsd:decimal ;
    skos:definition "The percentage of an operational environment's capacity that is in use."@en .

o4de:vendorName a owl:DatatypeProperty ;
    rdfs:label "vendor name"@en ;
    rdfs:domain o4de:Vendor ;
    rdfs:range xsd:string ;
    skos:definition "The name of a vendor."@en .

o4de:ActivitySummary a owl:Class ;
    rdfs:label "Activity Summary"@en ;
    rdfs:subClassOf o4de:DomainAsset ;
    skos:definition "A consolidated record of what activities were performed, when, where and with whom"@en .

o4de:AgilityManagement a owl:Class ;
    rdfs:label "Agility Management"@en ;
    rdfs:subClassOf o4de:OrganizationalManagement ;
    skos:definition "The management activity that builds the organization's ability to respond quickly to change."@en .

o4de:BusinessEnvironment a owl:Class ;
    rdfs:label "Business Environment"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "The business ecosystem, market conditions and organizational context in which the domain operates"@en .

o4de:BusinessRole a owl:Class ;
    rdfs:label "Business Role"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "A set of responsibilities and authorities assigned to individuals in business processes"@en .

o4de:Cost a owl:Class ;
    rdfs:label "Cost"@en ;
    rdfs:subClassOf o4de:CostManagement ;
    skos:definition "An amount of money spent to acquire or maintain something"@en .

o4de:CostManagement a owl:Class ;
    rdfs:label "Cost Management"@en ;
    rdfs:subClassOf o4de:FinancialManagement ;
    skos:definition "The management activity that plans, records and controls costs."@en .

o4de:CustomerJourney a owl:Class ;
    rdfs:label "Customer Journey"@en ;
    rdfs:subClassOf o4de:CustomerExperience ;
    skos:definition "The sequence of experiences a customer has across all touchpoints"@en .

o4de:DomainDesign a owl:Class ;
    rdfs:label "Domain Design"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty o4de:precedes ;
            owl:someValuesFrom o4de:DomainImplementation ],
        o4de:DomainEngineeringActivity ;
    skos:definition "Creation of architectural solutions and design patterns for the commonalities and variabilities found in analysis"@en .

o4de:DomainImplementation a owl:Class ;
    rdfs:label "Domain Implementation"@en ;
    rdfs:subClassOf o4de:DomainEngineeringActivity ;
    skos:definition "Development and testing of reusable components, frameworks and domain-specific tools"@en .

o4de:InventoryManagement a owl:Class ;
    rdfs:label "Inventory Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Oversight of inventory levels, stock control and supply chain coordination"@en .

o4de:OperationalArchitecture a owl:Class ;
    rdfs:label "Operational Architecture"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "The structural design of business operations, workflows and organizational elements"@en .

o4de:PortfolioManagement a owl:Class ;
    rdfs:label "Portfolio Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Systematic management of products and services throughout their lifecycles"@en .

o4de:ProductLifecycle a owl:Class ;
    rdfs:label "Product Lifecycle"@en ;
    skos:definition "The progression of a product through distinct phases from development to discontinuation"@en .

o4de:SolutionProvider a owl:Class ;
    rdfs:label "Solution Provider"@en ;
    rdfs:subClassOf o4de:Stakeholder ;
    skos:definition "Any organization that provides solutions, services or expertise relevant to domain engineering"@en .

o4de:SupportingProcess a owl:Class ;
    rdfs:label "Supporting Process"@en ;
    rdfs:subClassOf o4de:BusinessProcess ;
    owl:disjointWith o4de:CoreBusinessProcess ;
    skos:definition "Processes that provide the support and infrastructure for core business processes"@en ;
    skos:example "Human resources, IT support, accounting, facilities management, compliance"@en .

o4de:Tool a owl:Class ;
    rdfs:label "Tool"@en ;
    skos:definition "A software tool that supports domain engineering activities"@en .

o4de:precedes a owl:ObjectProperty ;
    rdfs:label "precedes"@en ;
    rdfs:comment "Temporal ordering between activities"@en ;
    rdfs:domain o4de:ProcessActivity ;
    rdfs:range o4de:ProcessActivity ;
    skos:definition "States that one activity must finish before another activity starts."@en .

o4de:AgileMethodology a owl:Class ;
    rdfs:label "Agile Methodology"@en ;
    rdfs:subClassOf o4de:AgilityManagement ;
    skos:definition "Methodologies that promote adaptive planning, evolutionary development and continuous improvement"@en ;
    skos:example "Scrum, Kanban, Lean, SAFe, Extreme Programming"@en .

o4de:ApplicationPortfolio a owl:Class ;
    rdfs:label "Application Portfolio"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "An inventory of all applications, systems and software assets used in the business domain"@en .

o4de:BusinessBenefits a owl:Class ;
    rdfs:label "Business Benefits"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Quantifiable and qualitative benefits that domain engineering brings to the organization"@en .

o4de:BusinessRule a owl:Class ;
    rdfs:label "Business Rule"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:ruleType ],
        o4de:BusinessContext ;
    skos:definition "A directive intended to influence or guide business behavior and decision-making"@en .

o4de:CoreBusinessProcess a owl:Class ;
    rdfs:label "Core Business Process"@en ;
    rdfs:subClassOf o4de:BusinessProcess ;
    skos:definition "Essential business processes that directly create customer value"@en ;
    skos:example "Order processing, product development, customer service, payment processing"@en .

o4de:CustomerManagement a owl:Class ;
    rdfs:label "Customer Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Management of customer interactions, relationships and experiences"@en .

o4de:DocumentAnalysisList a owl:Class ;
    rdfs:label "Document Analysis List"@en ;
    rdfs:subClassOf o4de:DataCollectionLog ;
    skos:definition "A record of documents analyzed, analysis methods used and findings obtained"@en .

o4de:DomainEngineeringProcess a owl:Class ;
    rdfs:label "Domain Engineering Process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:int ;
                    owl:withRestrictions ( [ xsd:minInclusive "1"^^xsd:int ] [ xsd:maxInclusive "5"^^xsd:int ] ) ] ;
            owl:onProperty o4de:hasMaturityLevel ] ;
    skos:definition "A structured set of activities, roles and controls that produces and maintains domain assets"@en .

o4de:FinancialManagement a owl:Class ;
    rdfs:label "Financial Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Management of financial resources, costs and pricing strategies"@en .

o4de:InterviewList a owl:Class ;
    rdfs:label "Interview List"@en ;
    rdfs:subClassOf o4de:DataCollectionLog ;
    skos:definition "A list of interviews with stakeholders: participants, topics and outcomes"@en .

o4de:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    skos:definition "A defined measure used to quantify a quality attribute or process performance"@en .

o4de:Operation a owl:Class ;
    rdfs:label "Operation"@en ;
    rdfs:subClassOf o4de:OperationsManagement ;
    skos:definition "A specific activity or set of activities performed as part of business operations"@en .

o4de:OperationalEnvironment a owl:Class ;
    rdfs:label "Operational Environment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 100.0 ] ) ] ;
            owl:onProperty o4de:utilizationRate ],
        o4de:OperationsManagement ;
    skos:definition "The physical, technological and organizational context in which operations take place"@en .

o4de:OrganizationalManagement a owl:Class ;
    rdfs:label "Organizational Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "The management activity that designs and runs the structure and people of an organization."@en .

o4de:OrganizationalStructure a owl:Class ;
    rdfs:label "Organizational Structure"@en ;
    rdfs:subClassOf o4de:OrganizationalManagement ;
    skos:definition "The formal framework of roles, responsibilities and reporting relationships within an organization"@en .

o4de:Position a owl:Class ;
    rdfs:label "Position"@en ;
    rdfs:subClassOf o4de:HumanResourceManagement ;
    skos:definition "A specific job with defined responsibilities and requirements"@en .

o4de:ProcessInput a owl:Class ;
    rdfs:label "Process Input"@en ;
    skos:definition "Any material, information, resource or trigger consumed or used by a business process"@en .

o4de:ProcessOutput a owl:Class ;
    rdfs:label "Process Output"@en ;
    skos:definition "Any product, service, information or result produced by a business process"@en .

o4de:QualityAttribute a owl:Class ;
    rdfs:label "Quality Attribute"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:measuredBy ] ;
    skos:definition "A measurable property of a system or asset such as security, performance or reusability"@en .

o4de:Supplier a owl:Class ;
    rdfs:label "Supplier"@en ;
    rdfs:subClassOf o4de:Stakeholder ;
    skos:definition "An organization or individual that provides inputs, materials or services to business processes"@en .

o4de:Touchpoint a owl:Class ;
    rdfs:label "Touchpoint"@en ;
    rdfs:subClassOf o4de:CustomerExperience ;
    skos:definition "Any point of contact between a customer and the organization"@en .

o4de:VariationPoint a owl:Class ;
    rdfs:label "Variation Point"@en ;
    skos:definition "A location in a domain asset where variation occurs, representing a design decision that can be made in different ways"@en ;
    skos:example "Database selection point, authentication mechanism choice, UI framework selection"@en ;
    skos:scopeNote "Variation points enable customization and adaptation of domain assets"@en .

o4de:Vendor a owl:Class ;
    rdfs:label "Vendor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:vendorName ],
        o4de:Stakeholder ;
    skos:definition "A commercial entity that offers products, services or solutions relevant to the domain"@en .

o4de:AgileActivity a owl:Class ;
    rdfs:label "Agile Activity"@en ;
    rdfs:subClassOf o4de:DomainEngineeringActivity ;
    skos:definition "A domain engineering activity that follows agile principles such as iterative development and continuous feedback"@en .

o4de:CustomerExperience a owl:Class ;
    rdfs:label "Customer Experience"@en ;
    rdfs:subClassOf o4de:CustomerManagement ;
    skos:definition "The complete set of interactions and perceptions a customer has with the organization"@en .

o4de:CustomerSegment a owl:Class ;
    rdfs:label "Customer Segment"@en ;
    rdfs:subClassOf o4de:CustomerCategorization ;
    skos:definition "A group of customers who share similar characteristics, needs or behaviors"@en .

o4de:Discount a owl:Class ;
    rdfs:label "Discount"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 100.0 ] ) ] ;
            owl:onProperty o4de:discountPercentage ],
        o4de:DiscountingManagement ;
    skos:definition "A reduction in the regular price of a product or service"@en .

o4de:MeetingList a owl:Class ;
    rdfs:label "Meeting List"@en ;
    rdfs:subClassOf o4de:DataCollectionLog ;
    skos:definition "A list of meetings, workshops and collaborative sessions conducted during domain engineering"@en .

o4de:Method a owl:Class ;
    rdfs:label "Method"@en ;
    skos:definition "A systematic technique for carrying out domain engineering activities"@en .

o4de:OperationsManagement a owl:Class ;
    rdfs:label "Operations Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Management of day-to-day operational activities and environments"@en .

o4de:Opportunity a owl:Class ;
    rdfs:label "Opportunity"@en ;
    rdfs:subClassOf o4de:StrategicAnalysis ;
    skos:definition "External factors or trends that could provide business opportunities"@en .

o4de:ProblemDescription a owl:Class ;
    rdfs:label "Problem Description"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "Critical" "Major" "Minor" ) ] ;
            owl:onProperty o4de:problemSeverity ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:oneOf ( "High" "Medium" "Low" ) ] ;
            owl:onProperty o4de:priorityLevel ],
        o4de:BusinessContext ;
    skos:definition "A structured description of business problems, challenges and opportunities that drive domain engineering efforts"@en .

o4de:QualityManagement a owl:Class ;
    rdfs:label "Quality Management"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "A systematic approach to ensuring that products and services meet or exceed requirements through planning, control, assurance and improvement"@en .

o4de:Role a owl:Class ;
    rdfs:label "Role"@en ;
    skos:definition "A set of responsibilities and competencies assigned to a person in a process"@en .

o4de:Sprint a owl:Class ;
    rdfs:label "Sprint"@en ;
    rdfs:subClassOf o4de:AgileActivity ;
    skos:definition "A time-boxed iteration used in agile methodologies to deliver working increments"@en .

o4de:Strength a owl:Class ;
    rdfs:label "Strength"@en ;
    rdfs:subClassOf o4de:StrategicAnalysis ;
    skos:definition "Internal capabilities, resources or attributes that provide competitive advantage"@en .

o4de:SystemCapabilities a owl:Class ;
    rdfs:label "System Capabilities"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Abilities, features and services that systems within the domain must deliver"@en .

o4de:Threat a owl:Class ;
    rdfs:label "Threat"@en ;
    rdfs:subClassOf o4de:StrategicAnalysis ;
    skos:definition "External factors or trends that could pose risks or challenges"@en .

o4de:VariabilityMechanism a owl:Class ;
    rdfs:label "Variability Mechanism"@en ;
    skos:definition "A technique that implements variation at a variation point"@en .

o4de:Weakness a owl:Class ;
    rdfs:label "Weakness"@en ;
    rdfs:subClassOf o4de:StrategicAnalysis ;
    skos:definition "Internal limitations or deficiencies that may hinder performance"@en .

o4de:Department a owl:Class ;
    rdfs:label "Department"@en ;
    rdfs:subClassOf o4de:OrganizationalUnit ;
    skos:definition "A permanent organizational unit that groups related work and teams."@en .

o4de:OrganizationalAgility a owl:Class ;
    rdfs:label "Organizational Agility"@en ;
    rdfs:subClassOf o4de:AgilityManagement ;
    skos:definition "The capability of an organization to rapidly adapt and respond to market changes and opportunities"@en .

o4de:SIPOCAnalysis a owl:Class ;
    rdfs:label "SIPOC Analysis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasSupplier ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasInput ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasOutput ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasCustomer ],
        o4de:ProcessAnalysis ;
    skos:definition "A framework analyzing Suppliers, Inputs, Process, Outputs and Customers to understand process boundaries"@en .

o4de:SWOTAnalysis a owl:Class ;
    rdfs:label "SWOT Analysis"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasStrength ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasWeakness ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasOpportunity ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasThreat ],
        o4de:StrategicAnalysis ;
    skos:definition "A framework that evaluates Strengths, Weaknesses, Opportunities and Threats"@en .

o4de:StrategicAnalysis a owl:Class ;
    rdfs:label "Strategic Analysis"@en ;
    rdfs:subClassOf o4de:BusinessContext ;
    skos:definition "Systematic analysis of strategic factors, including internal strengths and weaknesses and external opportunities and threats"@en ;
    skos:example "SWOT analysis, PEST analysis, competitive analysis, value chain analysis"@en .

o4de:DataCollectionLog a owl:Class ;
    rdfs:label "Data Collection Log"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:collectionDate ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:collectionMethod ],
        o4de:DomainAsset ;
    skos:definition "A systematic record of what data was collected, when, how and by whom during domain engineering"@en .

o4de:OrganizationalUnit a owl:Class ;
    rdfs:label "Organizational Unit"@en ;
    rdfs:subClassOf o4de:OrganizationalStructure ;
    skos:definition "Any part of an organization with its own members and responsibilities, such as a department or a team."@en .

o4de:Team a owl:Class ;
    rdfs:label "Team"@en ;
    rdfs:subClassOf o4de:OrganizationalUnit ;
    skos:definition "A group of employees who work together toward a shared goal."@en .

o4de:ProductLifecycleStage a owl:Class ;
    rdfs:label "Product Lifecycle Stage"@en ;
    skos:definition "A distinct phase in a product's lifecycle"@en .

o4de:Stakeholder a owl:Class ;
    rdfs:label "Stakeholder"@en ;
    rdfs:subClassOf foaf:Agent ;
    skos:definition "A person or organization with an interest in, or influence over, the domain"@en .

o4de:Inventory a owl:Class ;
    rdfs:label "Inventory"@en ;
    rdfs:subClassOf o4de:InventoryManagement ;
    skos:definition "The quantity of goods and materials held in stock by a business"@en .

o4de:Customer a owl:Class ;
    rdfs:label "Customer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:belongsToSegment ],
        o4de:Stakeholder ;
    skos:definition "An individual or organization that receives and uses the outputs of business processes"@en .

o4de:DomainEngineeringActivity a owl:Class ;
    rdfs:label "Domain Engineering Activity"@en ;
    rdfs:subClassOf o4de:ProcessActivity ;
    skos:definition "A systematic activity that contributes to the creation, analysis, design, implementation or evolution of domain assets"@en ;
    skos:example "Domain analysis, feature modeling, component design, asset testing"@en ;
    skos:scopeNote "Domain engineering activities are the fundamental building blocks of the domain engineering process"@en .

o4de:ProcessActivity a owl:Class ;
    rdfs:label "Process Activity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasDuration ] ;
    skos:definition "A unit of work performed within a process, with a duration, effort and responsible roles"@en .

o4de:Channel a owl:Class ;
    rdfs:label "Channel"@en ;
    rdfs:subClassOf o4de:ChannelManagement ;
    skos:definition "A medium or pathway through which products, services or information reach customers"@en .

o4de:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    skos:definition "A distinguishable characteristic of a system that is relevant to a stakeholder"@en .

o4de:MarketingCampaign a owl:Class ;
    rdfs:label "Marketing Campaign"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:campaignStartDate ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:campaignEndDate ],
        o4de:CampaignManagement ;
    skos:definition "A coordinated series of marketing activities designed to achieve specific objectives"@en .

o4de:VendorSolution a owl:Class ;
    rdfs:label "Vendor Solution"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:providedByVendor ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 5.0 ] ) ] ;
            owl:onProperty o4de:solutionRating ] ;
    skos:definition "Third-party products, services and solutions that can be leveraged or considered in domain engineering"@en ;
    skos:example "Cloud platforms, commercial frameworks, third-party components, consulting services"@en .

o4de:BusinessProcess a owl:Class ;
    rdfs:label "Business Process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty o4de:hasBusinessRole ],
        o4de:BusinessContext ;
    skos:definition "A collection of related, structured activities that produce a specific service or product for customers"@en ;
    skos:example "Order processing, customer onboarding, payment processing, inventory management"@en .

o4de:Product a owl:Class ;
    rdfs:label "Product"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 10.0 ] ) ] ;
            owl:onProperty o4de:qualityScore ],
        [ a owl:Restriction ;
            owl:onProperty o4de:hasLifecycle ;
            owl:someValuesFrom o4de:ProductLifecycle ],
        [ a owl:Restriction ;
            owl:onProperty o4de:currentStage ;
            owl:someValuesFrom o4de:ProductLifecycleStage ] ;
    skos:definition "A tangible or intangible good offered to satisfy customer needs"@en .

o4de:Employee a owl:Class ;
    rdfs:label "Employee"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:decimal ;
                    owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 5.0 ] ) ] ;
            owl:onProperty o4de:performanceRating ],
        [ a owl:Restriction ;
            owl:onProperty o4de:belongsToUnit ;
            owl:someValuesFrom o4de:OrganizationalUnit ],
        [ a owl:Restriction ;
            owl:onProperty o4de:holdsPosition ;
            owl:someValuesFrom o4de:Position ],
        o4de:Stakeholder ;
    skos:definition "A person who works for the organization and holds a position in it."@en .

o4de:BusinessContext a owl:Class ;
    rdfs:label "Business Context"@en ;
    skos:definition "Business-oriented information and context that influences domain engineering decisions: environment, problems, capabilities, benefits, processes, roles, rules and architecture"@en ;
    skos:scopeNote "Business context provides the foundation for understanding domain requirements and constraints"@en .

o4de:DomainAsset a owl:Class ;
    rdfs:label "Domain Asset"@en ;
    skos:definition "A reusable artifact that encapsulates domain knowledge and can be used across multiple applications within the same domain"@en ;
    skos:example "Reusable components, frameworks, reference architectures, domain models, DSLs"@en ;
    skos:scopeNote "Domain assets are the primary output of domain engineering activities"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:InterviewList o4de:MeetingList o4de:DocumentAnalysisList o4de:ActivitySummary ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:Vendor o4de:SolutionProvider o4de:VendorSolution ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:DevelopmentStage o4de:IntroductionStage o4de:GrowthStage o4de:MaturityStage o4de:DeclineStage ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:Strength o4de:Weakness o4de:Opportunity o4de:Threat ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:SalesChannel o4de:DistributionChannel o4de:DigitalChannel ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:Department o4de:Team ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:MandatoryFeature o4de:OptionalFeature o4de:AlternativeFeature ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:ParameterVariability o4de:InheritanceVariability o4de:CompositionVariability ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:DomainAnalysis o4de:DomainDesign o4de:DomainImplementation o4de:DomainEvolution ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:Component o4de:Framework o4de:DomainSpecificLanguage o4de:ReferenceArchitecture o4de:DomainModel ) .

[] a owl:AllDisjointClasses ;
    owl:members ( o4de:BusinessEnvironment o4de:ProblemDescription o4de:SystemCapabilities o4de:BusinessBenefits o4de:BusinessProcess o4de:BusinessRole o4de:BusinessRule o4de:ApplicationPortfolio o4de:OperationalArchitecture ) .

