# Role: T-Box. Classes, properties and axioms only; no individuals.

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix o4de: <http://www.zt4swe.io/o4de#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.zt4swe.io/o4de> a owl:Ontology ;
    dc:title "O4DE: Ontology for Domain Engineering (T-Box)"@en ;
    dcterms:coverage "Enterprise domain engineering" ;
    dcterms:created "2026-10-13"^^xsd:date ;
    dcterms:creator "Yusuf Altunel" ;
    dcterms:description "Classes, properties and axioms of the Ontology for Domain Engineering."@en ;
    dcterms:license <http://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:modified "2026-10-13"^^xsd:date ;
    dcterms:rights "Copyright 2026 Yusuf Altunel" ;
    dcterms:subject "Agile Methodologies",
        "Business Analysis",
        "Customer Management",
        "Domain Engineering",
        "Operations Management",
        "Organizational Management",
        "Process Improvement",
        "Product Management",
        "Quality Management",
        "Strategic Planning" ;
    dcterms:title "O4DE: Ontology for Domain Engineering (T-Box)"@en ;
    rdfs:comment "O4DE is a formal ontology of domain engineering for enterprise use. It defines the activities, assets, features and variability of domain engineering, the processes, roles, rules and metrics that govern it, and the business context it works in: customers, products, channels, vendors, organization and agility. Its purpose is to give analysts and architects one shared, machine-checkable vocabulary for documenting a business domain. The class, property and taxonomy counts are reproduced by 05-gates/o4de_gate_v1_0_0.py."@en ;
    owl:versionIRI <http://www.zt4swe.io/o4de/1.0.0> ;
    owl:versionInfo "1.0.0" .

o4de:AlternativeSolution a owl:Class ;
    rdfs:label "Alternative Solution"@en ;
    rdfs:subClassOf o4de:VendorSolution ;
    skos:definition "A different technological or methodological approach that can address the same domain requirements"@en .

o4de:DSSA a owl:Class ;
    rdfs:label "Domain-Specific Software Architecture"@en ;
    rdfs:subClassOf o4de:Method ;
    skos:definition "Domain-Specific Software Architecture, a method that defines a reference architecture for a domain."@en .

o4de:DataCollectionActivity a owl:Class ;
    rdfs:label "Data Collection Activity"@en ;
    rdfs:subClassOf o4de:DomainEngineeringActivity ;
    skos:definition "Systematic activity for collecting data, information and knowledge relevant to domain engineering"@en .

o4de:DomainAnalyst a owl:Class ;
    rdfs:label "Domain Analyst"@en ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role responsible for studying the domain and capturing its requirements, commonalities and variability."@en .

o4de:DomainArchitect a owl:Class ;
    rdfs:label "Domain Architect"@en ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role responsible for the architecture and design decisions of domain assets."@en .

o4de:DomainDeveloper a owl:Class ;
    rdfs:label "Domain Developer"@en ;
    rdfs:subClassOf o4de:Role ;
    skos:definition "A role responsible for building and testing reusable domain assets."@en .

o4de:FODA a owl:Class ;
    rdfs:label "Feature-Oriented Domain Analysis"@en ;
    rdfs:subClassOf o4de:Method ;
    skos:definition "Feature-Oriented Domain Analysis, a domain analysis method that describes a domain by its features."@en .

o4de:FeatureModelingTool a owl:Class ;
    rdfs:label "Feature Modeling Tool"@en ;
    rdfs:subClassOf o4de:Tool ;
    skos:definition "A tool used to create, edit and analyse feature models."@en .

o4de:ProcessMetric a owl:Class ;
    rdfs:label "Process Metric"@en ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures a property of a process, such as cycle time or defect rate."@en .

o4de:ProductLineEngineering a owl:Class ;
    rdfs:label "Product Line Engineering"@en ;
    rdfs:subClassOf o4de:Method ;
    skos:definition "A method for building a family of related products from a shared set of domain assets."@en .

o4de:ProductQualityManagement a owl:Class ;
    rdfs:label "Product Quality Management"@en ;
    rdfs:subClassOf o4de:QualityManagement ;
    skos:definition "Management of quality standards, controls and improvements for products"@en .

o4de:Reusability a owl:Class ;
    rdfs:label "Reusability"@en ;
    rdfs:subClassOf o4de:QualityAttribute ;
    skos:definition "A quality attribute describing how easily an asset can be used again in another product or context."@en .

o4de:ReuseMetric a owl:Class ;
    rdfs:label "Reuse Metric"@en ;
    rdfs:subClassOf o4de:Metric ;
    skos:definition "A metric that measures how much domain assets are reused, for example reuse rate."@en .

o4de:Service a owl:Class ;
    rdfs:label "Service"@en ;
    skos:definition "An intangible offering that provides value to customers through activities or benefits"@en .

o4de:ServicePortfolio a owl:Class ;
    rdfs:label "Service Portfolio"@en ;
    rdfs:subClassOf o4de:PortfolioManagement ;
    skos:definition "A collection of services offered by the organization"@en .

o4de:acquisitionDate a owl:DatatypeProperty ;
    rdfs:label "acquisition date"@en ;
    rdfs:domain o4de:Customer ;
    rdfs:range xsd:date ;
    skos:definition "The date on which a customer was acquired."@en .

o4de:adaptabilityIndex a owl:DatatypeProperty ;
    rdfs:label "adaptability index"@en ;
    rdfs:comment "0.0 to 1.0"@en ;
    rdfs:domain o4de:OrganizationalAgility ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric index of how well an organization adapts to change."@en .

o4de:addressesProblem a owl:ObjectProperty ;
    rdfs:label "addresses problem"@en ;
    rdfs:domain o4de:DomainEngineeringActivity ;
    rdfs:range o4de:ProblemDescription ;
    skos:definition "Links a domain engineering activity to a business problem it sets out to solve."@en .

o4de:agilityScore a owl:DatatypeProperty ;
    rdfs:label "agility score"@en ;
    rdfs:comment "0.0 to 10.0"@en ;
    rdfs:domain o4de:OrganizationalAgility ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric score of how agile an organization is."@en .

o4de:analysisMethod a owl:DatatypeProperty ;
    rdfs:label "analysis method"@en ;
    rdfs:domain o4de:DocumentAnalysisList ;
    rdfs:range xsd:string ;
    skos:definition "The method used to analyse documents in a document analysis list."@en .

o4de:analyzesDocument a owl:ObjectProperty ;
    rdfs:label "analyzes document"@en ;
    rdfs:domain o4de:DocumentAnalysisList ;
    rdfs:range o4de:DomainAsset ;
    skos:definition "Links a document analysis list to a document that was analysed."@en .

o4de:analyzesProcess a owl:ObjectProperty ;
    rdfs:label "analyzes process"@en ;
    rdfs:domain o4de:SIPOCAnalysis ;
    rdfs:range o4de:BusinessProcess ;
    skos:definition "Links a SIPOC analysis to the business process it describes."@en .

o4de:applicationCount a owl:DatatypeProperty ;
    rdfs:label "application count"@en ;
    rdfs:domain o4de:ApplicationPortfolio ;
    rdfs:range xsd:int ;
    skos:definition "The number of applications in an application portfolio."@en .

o4de:appliesDiscount a owl:ObjectProperty ;
    rdfs:label "applies discount"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range o4de:Discount ;
    skos:definition "Links a product to a discount that applies to it."@en .

o4de:appliesMethod a owl:ObjectProperty ;
    rdfs:label "applies method"@en ;
    rdfs:domain o4de:ProcessActivity ;
    rdfs:range o4de:Method ;
    skos:definition "Links an activity to a method it follows."@en .

o4de:appliesQualityControl a owl:ObjectProperty ;
    rdfs:label "applies quality control"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range o4de:QualityControl ;
    skos:definition "Links a business process to a quality control it applies."@en .

o4de:businessValue a owl:DatatypeProperty ;
    rdfs:label "business value"@en ;
    rdfs:domain o4de:BusinessBenefits ;
    rdfs:range xsd:decimal ;
    skos:definition "The estimated worth of a business benefit."@en .

o4de:campaignBudget a owl:DatatypeProperty ;
    rdfs:label "campaign budget"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range xsd:decimal ;
    skos:definition "The amount of money set aside for a marketing campaign."@en .

o4de:campaignROI a owl:DatatypeProperty ;
    rdfs:label "campaign ROI"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range xsd:decimal ;
    skos:definition "The return on investment achieved by a marketing campaign."@en .

o4de:capabilityType a owl:DatatypeProperty ;
    rdfs:label "capability type"@en ;
    rdfs:comment "Functional, Non-functional or Technical"@en ;
    rdfs:domain o4de:SystemCapabilities ;
    rdfs:range xsd:string ;
    skos:definition "The kind of system capability, for example functional or technical."@en .

o4de:channelCost a owl:DatatypeProperty ;
    rdfs:label "channel cost"@en ;
    rdfs:domain o4de:Channel ;
    rdfs:range xsd:decimal ;
    skos:definition "The cost of running a channel."@en .

o4de:channelEfficiency a owl:DatatypeProperty ;
    rdfs:label "channel efficiency"@en ;
    rdfs:domain o4de:Channel ;
    rdfs:range xsd:decimal ;
    skos:definition "A measure of how effectively a channel converts effort into results."@en .

o4de:channelRevenue a owl:DatatypeProperty ;
    rdfs:label "channel revenue"@en ;
    rdfs:domain o4de:Channel ;
    rdfs:range xsd:decimal ;
    skos:definition "The revenue earned through a channel."@en .

o4de:channelType a owl:DatatypeProperty ;
    rdfs:label "channel type"@en ;
    rdfs:domain o4de:Channel ;
    rdfs:range xsd:string ;
    skos:definition "The kind of channel, for example store, web or marketplace."@en .

o4de:childFeature a owl:ObjectProperty ;
    rdfs:label "child feature"@en ;
    rdfs:domain o4de:Feature ;
    rdfs:range o4de:Feature ;
    owl:inverseOf o4de:parentFeature ;
    skos:definition "Links a feature to a feature placed beneath it in the feature tree."@en .

o4de:classifiedAs a owl:ObjectProperty ;
    rdfs:label "classified as"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range o4de:ProcessClassification ;
    skos:definition "Links a business process to its classification, for example core or supporting."@en .

o4de:clickThroughRate a owl:DatatypeProperty ;
    rdfs:label "click-through rate"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range xsd:decimal ;
    skos:definition "The share of impressions of a campaign that led to a click."@en .

o4de:competesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "competes with"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range o4de:VendorSolution ;
    skos:definition "Links a vendor solution to a solution that competes with it in the same market."@en .

o4de:conductsRetrospective a owl:ObjectProperty ;
    rdfs:label "conducts retrospective"@en ;
    rdfs:domain o4de:Team ;
    rdfs:range o4de:Retrospective ;
    skos:definition "Links a team to a retrospective it holds."@en .

o4de:configuresEnvironment a owl:ObjectProperty ;
    rdfs:label "configures environment"@en ;
    rdfs:domain o4de:OperationsManagement ;
    rdfs:range o4de:OperationalEnvironment ;
    skos:definition "Links an operations management activity to an operational environment it sets up."@en .

o4de:consumesInput a owl:ObjectProperty ;
    rdfs:label "consumes input"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range o4de:ProcessInput ;
    skos:definition "Links a business process to an input it uses."@en .

o4de:customerID a owl:DatatypeProperty ;
    rdfs:label "customer ID"@en ;
    rdfs:domain o4de:Customer ;
    rdfs:range xsd:string ;
    skos:definition "The identifier that distinguishes a customer."@en .

o4de:customerValue a owl:DatatypeProperty ;
    rdfs:label "customer value"@en ;
    rdfs:domain o4de:Customer ;
    rdfs:range xsd:decimal ;
    skos:definition "The estimated value of a customer to the organization."@en .

o4de:defectRate a owl:DatatypeProperty ;
    rdfs:label "defect rate"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range xsd:decimal ;
    skos:definition "The share of a product's units that are defective."@en .

o4de:definesBusinessProcess a owl:ObjectProperty ;
    rdfs:label "defines business process"@en ;
    rdfs:domain o4de:BusinessEnvironment ;
    rdfs:range o4de:BusinessProcess ;
    skos:definition "Links a business environment to a business process that takes place in it."@en .

o4de:deliversBenefit a owl:ObjectProperty ;
    rdfs:label "delivers benefit"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range o4de:BusinessBenefits ;
    skos:definition "Links a domain asset to a business benefit it brings."@en .

o4de:departmentCode a owl:DatatypeProperty ;
    rdfs:label "department code"@en ;
    rdfs:domain o4de:Department ;
    rdfs:range xsd:string ;
    skos:definition "The short code that identifies a department."@en .

o4de:departmentSize a owl:DatatypeProperty ;
    rdfs:label "department size"@en ;
    rdfs:domain o4de:Department ;
    rdfs:range xsd:int ;
    skos:definition "The number of people in a department."@en .

o4de:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range o4de:DomainAsset ;
    skos:definition "Links a domain asset to another asset it needs in order to work."@en .

o4de:documentsInterview a owl:ObjectProperty ;
    rdfs:label "documents interview"@en ;
    rdfs:domain o4de:InterviewList ;
    rdfs:range o4de:Stakeholder ;
    skos:definition "Links an interview list to a stakeholder who was interviewed."@en .

o4de:eligibleForDiscount a owl:ObjectProperty ;
    rdfs:label "eligible for discount"@en ;
    rdfs:domain o4de:CustomerSegment ;
    rdfs:range o4de:Discount ;
    skos:definition "Links a customer segment to a discount it may receive."@en .

o4de:employeeID a owl:DatatypeProperty ;
    rdfs:label "employee ID"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range xsd:string ;
    skos:definition "The identifier that distinguishes an employee."@en .

o4de:enabledBySupportingProcess a owl:ObjectProperty ;
    rdfs:label "enabled by supporting process"@en ;
    rdfs:domain o4de:CoreBusinessProcess ;
    rdfs:range o4de:SupportingProcess ;
    owl:inverseOf o4de:supportsCoreProcess ;
    skos:definition "Links a core business process to a supporting process that makes it possible."@en .

o4de:enablesAgility a owl:ObjectProperty ;
    rdfs:label "enables agility"@en ;
    rdfs:domain o4de:AgileMethodology ;
    rdfs:range o4de:OrganizationalAgility ;
    skos:definition "Links an agile methodology to the organizational agility it supports."@en .

o4de:enablesCapability a owl:ObjectProperty ;
    rdfs:label "enables capability"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range o4de:SystemCapabilities ;
    skos:definition "Links a domain asset to a system capability it makes possible."@en .

o4de:excludesFeature a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "excludes feature"@en ;
    rdfs:domain o4de:Feature ;
    rdfs:range o4de:Feature ;
    skos:definition "States that selecting one feature rules out another."@en .

o4de:experienceYears a owl:DatatypeProperty ;
    rdfs:label "experience years"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range xsd:decimal ;
    skos:definition "The number of years of relevant experience an employee has."@en .

o4de:experiencesAtTouchpoint a owl:ObjectProperty ;
    rdfs:label "experiences at touchpoint"@en ;
    rdfs:domain o4de:Customer ;
    rdfs:range o4de:Touchpoint ;
    skos:definition "Links a customer to a touchpoint at which the customer has an experience."@en .

o4de:exploitsWeakness a owl:ObjectProperty ;
    rdfs:label "exploits weakness"@en ;
    rdfs:domain o4de:Threat ;
    rdfs:range o4de:Weakness ;
    skos:definition "Links a threat to a weakness it can take advantage of."@en .

o4de:governedByRule a owl:ObjectProperty ;
    rdfs:label "governed by rule"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range o4de:BusinessRule ;
    skos:definition "Links a business process to a business rule that constrains it."@en .

o4de:hasAlternative a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "has alternative"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range o4de:VendorSolution ;
    skos:definition "Links a vendor solution to another solution that could replace it."@en .

o4de:hasAuthor a owl:DatatypeProperty ;
    rdfs:label "has author"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range xsd:string ;
    skos:definition "The name of the person who created a domain asset."@en .

o4de:hasComplexity a owl:DatatypeProperty ;
    rdfs:label "has complexity"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range xsd:decimal ;
    skos:definition "A numeric measure of how complex a domain asset is."@en .

o4de:hasCost a owl:ObjectProperty ;
    rdfs:label "has cost"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range o4de:Cost ;
    skos:definition "Links a business process to a cost it causes."@en .

o4de:hasCreationDate a owl:DatatypeProperty ;
    rdfs:label "has creation date"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range xsd:date ;
    skos:definition "The date on which a domain asset was created."@en .

o4de:hasCustomerJourney a owl:ObjectProperty ;
    rdfs:label "has customer journey"@en ;
    rdfs:domain o4de:Customer ;
    rdfs:range o4de:CustomerJourney ;
    skos:definition "Links a customer to a journey the customer goes through."@en .

o4de:hasCycleTime a owl:DatatypeProperty ;
    rdfs:label "has cycle time"@en ;
    rdfs:domain o4de:DomainEngineeringProcess ;
    rdfs:range xsd:duration ;
    skos:definition "The time a process takes from start to finish."@en .

o4de:hasDescription a owl:DatatypeProperty ;
    rdfs:label "has description"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    skos:definition "A short text that describes a thing."@en .

o4de:hasEffort a owl:DatatypeProperty ;
    rdfs:label "has effort"@en ;
    rdfs:comment "Effort in person-hours"@en ;
    rdfs:domain o4de:ProcessActivity ;
    rdfs:range xsd:decimal ;
    skos:definition "The amount of work an activity needs, measured in hours of effort."@en .

o4de:hasFeature a owl:ObjectProperty ;
    rdfs:label "has feature"@en ;
    rdfs:domain o4de:FeatureModel ;
    rdfs:range o4de:Feature ;
    skos:definition "Links a feature model to a feature it contains."@en .

o4de:hasInventory a owl:ObjectProperty ;
    rdfs:label "has inventory"@en ;
    rdfs:domain o4de:Product ;
    rdfs:range o4de:Inventory ;
    skos:definition "Links a product to the inventory that holds it."@en .

o4de:hasName a owl:DatatypeProperty ;
    rdfs:label "has name"@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    skos:definition "The name of a thing."@en .

o4de:hasOrganizationalUnit a owl:ObjectProperty ;
    rdfs:label "has organizational unit"@en ;
    rdfs:domain o4de:OrganizationalStructure ;
    rdfs:range o4de:OrganizationalUnit ;
    skos:definition "Links an organizational structure to a unit it contains."@en .

o4de:hasQualityAttribute a owl:ObjectProperty ;
    rdfs:label "has quality attribute"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range o4de:QualityAttribute ;
    skos:definition "Links a domain asset to a quality attribute it is judged by."@en .

o4de:hasReuseRate a owl:DatatypeProperty ;
    rdfs:label "has reuse rate"@en ;
    rdfs:comment "Share of projects reusing the asset (0.0-1.0)"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range xsd:decimal ;
    skos:definition "The share of uses of a domain asset that are reuses rather than new builds."@en .

o4de:hasStockLevel a owl:ObjectProperty ;
    rdfs:label "has stock level"@en ;
    rdfs:domain o4de:Inventory ;
    rdfs:range o4de:StockLevel ;
    skos:definition "Links an inventory to a recorded stock level."@en .

o4de:hasVariant a owl:ObjectProperty ;
    rdfs:label "has variant"@en ;
    rdfs:domain o4de:VariationPoint ;
    rdfs:range o4de:Variant ;
    skos:definition "Links a variation point to a variant that can be chosen there."@en .

o4de:hasVariationPoint a owl:ObjectProperty ;
    rdfs:label "has variation point"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range o4de:VariationPoint ;
    skos:definition "Links a domain asset to a place where it can vary."@en .

o4de:hasVersion a owl:DatatypeProperty ;
    rdfs:label "has version"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range xsd:string ;
    skos:definition "The version label of a domain asset."@en .

o4de:headsDepartment a owl:ObjectProperty ;
    rdfs:label "heads department"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range o4de:Department ;
    skos:definition "Links an employee to a department the employee leads."@en .

o4de:hierarchyLevel a owl:DatatypeProperty ;
    rdfs:label "hierarchy level"@en ;
    rdfs:domain o4de:OrganizationalHierarchy ;
    rdfs:range xsd:int ;
    skos:definition "The level of a unit in an organizational hierarchy, counted from the top."@en .

o4de:hireDate a owl:DatatypeProperty ;
    rdfs:label "hire date"@en ;
    rdfs:domain o4de:Employee ;
    rdfs:range xsd:date ;
    skos:definition "The date on which an employee was hired."@en .

o4de:implementationTime a owl:DatatypeProperty ;
    rdfs:label "implementation time"@en ;
    rdfs:domain o4de:VendorSolution ;
    rdfs:range xsd:duration ;
    skos:definition "The time needed to implement a vendor solution."@en .

o4de:implementsAgileMethodology a owl:ObjectProperty ;
    rdfs:label "implements agile methodology"@en ;
    rdfs:domain o4de:Team ;
    rdfs:range o4de:AgileMethodology ;
    skos:definition "Links a team to the agile methodology it works by."@en .

o4de:implementsArchitecture a owl:ObjectProperty ;
    rdfs:label "implements architecture"@en ;
    rdfs:domain o4de:DomainAsset ;
    rdfs:range o4de:OperationalArchitecture ;
    skos:definition "Links a domain asset to the operational architecture it realises."@en .

o4de:implementsQualityAssurance a owl:ObjectProperty ;
    rdfs:label "implements quality assurance"@en ;
    rdfs:domain o4de:BusinessProcess ;
    rdfs:range o4de:QualityAssurance ;
    skos:definition "Links a business process to a quality assurance practice it implements."@en .

o4de:implementsVariability a owl:ObjectProperty ;
    rdfs:label "implements variability"@en ;
    rdfs:domain o4de:VariationPoint ;
    rdfs:range o4de:VariabilityMechanism ;
    skos:definition "Links a variation point to the mechanism that realises the variation."@en .

o4de:impressions a owl:DatatypeProperty ;
    rdfs:label "impressions"@en ;
    rdfs:domain o4de:MarketingCampaign ;
    rdfs:range xsd:int ;
    skos:definition "The number of times a campaign was shown."@en .

o4de:improvesAgility a owl:ObjectProperty ;
    rdfs:label "improves agility"@en ;
    rdfs:domain o4de:AgileActivity ;
    rdfs:range o4de:OrganizationalAgility ;
    skos:definition "Links an agile activity to the organizational agility it improves."@en .

o4de:includesActivity a owl:ObjectProperty ;
    rdfs:label "includes activity"@en ;
    rdfs:domain o4de:Sprint ;
    rdfs:range o4de:AgileActivity ;
    skos:definition "Links a sprint to an agile activity carried out in it."@en .

o4de:includesApplication a owl:ObjectProperty ;
    rdfs:label "includes application"@en ;
    rdfs:domain o4de:ApplicationPortfolio ;
    rdfs:range o4de:DomainAsset ;
    skos:definition "Links an application portfolio to an application it contains."@en .

o4de:includesDiscount a owl:ObjectProperty ;
